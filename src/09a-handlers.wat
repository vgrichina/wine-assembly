          (else (if (i32.eq (local.get $month) (i32.const 11)) (then (local.set $month_days (i32.const 304)))
          (else (local.set $month_days (i32.const 334))))))))))))))))))))))))
        (if (i32.and (i32.gt_u (local.get $month) (i32.const 2)) (local.get $leap))
