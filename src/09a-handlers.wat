    (i32.store offset=16 (local.get $info) (i32.const 0x01BF53EB))
    (i32.store offset=20 (local.get $info) (i32.const 0x256D4000))
    (i32.store offset=24 (local.get $info) (i32.const 0x01BF53EB))
