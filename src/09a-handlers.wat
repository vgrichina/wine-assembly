  ;; 514: GetSystemTimeAsFileTime(lpFileTime) — writes 8-byte FILETIME
  (func $handle_GetSystemTimeAsFileTime (param $arg0 i32) (param $arg1 i32) (param $arg2 i32) (param $arg3 i32) (param $arg4 i32) (param $name_ptr i32)
    (local $wa i32)
