              (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $from_x))
              (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $from_y))
              (i32.const 6)))
          (then (return (i32.const 0))))
        (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
