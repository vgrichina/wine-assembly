    (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
          (call $gdi_path_scale_arc (local.get $left) (local.get $right) (local.get $x2))
          (call $gdi_path_scale_arc (local.get $top) (local.get $bottom) (local.get $y2))
          (i32.const 4)))
      (then (return (i32.const 0))))
    (call $gdi_dc_path_append_device (local.get $entry)
      (call $gdi_path_scale_arc (local.get $left) (local.get $right) (local.get $x3))
      (call $gdi_path_scale_arc (local.get $top) (local.get $bottom) (local.get $y3))
      (i32.const 4)))

  (func $gdi_dc_path_record_arc (param $hdc i32) (param $left i32) (param $top i32)
        (param $right i32) (param $bottom i32) (param $start_x i32) (param $start_y i32)
        (param $end_x i32) (param $end_y i32) (param $to_mode i32) (result i32)
    (local $entry i32) (local $buffer i32) (local $count i32) (local $swap i32)
    (local $x0 i32) (local $y0 i32) (local $x1 i32) (local $y1 i32)
    (local $sx i32) (local $sy i32) (local $ex i32) (local $ey i32)
    (local $direction i32) (local $first i32) (local $last_part i32) (local $parts i32)
    (local $angle_start f64) (local $angle_end f64) (local $part_start f64) (local $part_end f64)
    (local $nx f64) (local $ny f64) (local $final_x i32) (local $final_y i32) (local $desc i32)
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    (local.set $x0 (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $left)))
    (local.set $x1 (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $right)))
    (local.set $y0 (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $top)))
    (local.set $y1 (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $bottom)))
    (local.set $sx (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $start_x)))
    (local.set $sy (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $start_y)))
    (local.set $ex (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $end_x)))
    (local.set $ey (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $end_y)))
    (if (i32.gt_s (local.get $x0) (local.get $x1))
      (then (local.set $swap (local.get $x0)) (local.set $x0 (local.get $x1))
        (local.set $x1 (local.get $swap))))
    (if (i32.gt_s (local.get $y0) (local.get $y1))
      (then (local.set $swap (local.get $y0)) (local.set $y0 (local.get $y1))
        (local.set $y1 (local.get $swap))))
