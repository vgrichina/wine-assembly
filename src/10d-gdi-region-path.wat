      (then
        (local.set $final_x (call $gdi_path_scale_arc (local.get $x0) (local.get $x1)
          (call $host_math_cos (local.get $angle_end))))
        (local.set $final_y (call $gdi_path_scale_arc (local.get $y0) (local.get $y1)
          (call $host_math_sin (local.get $angle_end))))
        (local.set $desc (global.get $GDI_LINE_DESC))
        (if (call $gdi_surface_descriptor (local.get $hdc) (local.get $desc))
          (then
            (local.set $final_x (call $gdi_shape_unmap_x (local.get $desc)
              (i32.add (local.get $final_x) (i32.load offset=72 (local.get $desc)))))
            (local.set $final_y (call $gdi_shape_unmap_y (local.get $desc)
              (i32.add (local.get $final_y) (i32.load offset=76 (local.get $desc)))))))
        (drop (call $gdi_dc_set_field (local.get $hdc) (i32.const 12)
