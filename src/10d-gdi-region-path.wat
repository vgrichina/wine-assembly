          (br_if $line_done (i32.ge_u (local.get $i) (local.get $count)))
          (local.set $point (i32.add (local.get $points) (i32.shl (local.get $i) (i32.const 3))))
          (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
                (call $gdi_dc_clip_map_x (local.get $hdc) (i32.load (local.get $point)))
                (call $gdi_dc_clip_map_y (local.get $hdc) (i32.load offset=4 (local.get $point)))
                (i32.const 2)))
            (then (return (i32.const 0))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $line_points)))))
    (i32.const 1))

  (func $gdi_dc_path_record_bezier (param $hdc i32) (param $points i32)
        (param $count i32) (param $from_current i32) (result i32)
    (local $entry i32) (local $buffer i32) (local $additional i32)
    (local $i i32) (local $point i32) (local $x i32) (local $y i32)
    (if (i32.or (i32.eqz (local.get $points))
          (i32.or (i32.gt_u (local.get $count) (i32.const 4096))
            (select
              (i32.or (i32.lt_u (local.get $count) (i32.const 3))
                (i32.ne (i32.rem_u (local.get $count) (i32.const 3)) (i32.const 0)))
              (i32.or (i32.lt_u (local.get $count) (i32.const 4))
                (i32.ne (i32.rem_u (i32.sub (local.get $count) (i32.const 1))
                  (i32.const 3)) (i32.const 0)))
              (local.get $from_current))))
      (then (return (i32.const 0))))
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (local.set $additional (local.get $count))
    (if (local.get $from_current)
      (then
        (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
        (if (i32.or (i32.eqz (i32.load (local.get $buffer)))
              (i32.ne (i32.and (i32.load offset=12 (local.get $buffer)) (i32.const 1)) (i32.const 0)))
          (then (local.set $additional (i32.add (local.get $additional) (i32.const 1)))))))
    (if (i32.eqz (call $gdi_dc_path_reserve (local.get $entry) (local.get $additional)))
      (then (return (i32.const 0))))
    (if (local.get $from_current)
      (then
        (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
        (if (i32.or (i32.eqz (i32.load (local.get $buffer)))
              (i32.ne (i32.and (i32.load offset=12 (local.get $buffer)) (i32.const 1)) (i32.const 0)))
          (then
            (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
                  (call $gdi_dc_clip_map_x (local.get $hdc)
                    (call $gdi_dc_get_field (local.get $hdc) (i32.const 12) (i32.const 0)))
                  (call $gdi_dc_clip_map_y (local.get $hdc)
                    (call $gdi_dc_get_field (local.get $hdc) (i32.const 16) (i32.const 0)))
                  (i32.const 6)))
              (then (return (i32.const 0)))))))
      (else
        (local.set $point (local.get $points))
        (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
              (call $gdi_dc_clip_map_x (local.get $hdc) (i32.load (local.get $point)))
              (call $gdi_dc_clip_map_y (local.get $hdc) (i32.load offset=4 (local.get $point)))
              (i32.const 6)))
          (then (return (i32.const 0))))
        (local.set $i (i32.const 1))))
    (block $done (loop $curves
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $point (i32.add (local.get $points) (i32.shl (local.get $i) (i32.const 3))))
      (local.set $x (i32.load (local.get $point)))
      (local.set $y (i32.load offset=4 (local.get $point)))
      (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
            (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $x))
            (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $y)) (i32.const 4)))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $curves)))
    (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
    (i32.store offset=12 (local.get $buffer) (i32.const 0))
    (if (local.get $from_current)
      (then
        (local.set $point (i32.add (local.get $points)
          (i32.shl (i32.sub (local.get $count) (i32.const 1)) (i32.const 3))))
        (drop (call $gdi_dc_set_field (local.get $hdc) (i32.const 12)
          (i32.load (local.get $point)) (i32.const 0)))
        (drop (call $gdi_dc_set_field (local.get $hdc) (i32.const 16)
          (i32.load offset=4 (local.get $point)) (i32.const 0)))))
    (i32.const 1))

  (func $gdi_dc_path_record_polydraw (param $hdc i32) (param $points i32)
        (param $types i32) (param $count i32) (result i32)
    (local $entry i32) (local $buffer i32) (local $i i32) (local $point i32)
    (local $type i32) (local $kind i32) (local $j i32) (local $last i32)
    (local $needs_start i32) (local $implicit i32) (local $additional i32)
    (if (i32.or (i32.eqz (local.get $points))
          (i32.or (i32.eqz (local.get $types))
            (i32.or (i32.eqz (local.get $count)) (i32.gt_u (local.get $count) (i32.const 4096)))))
      (then (return (i32.const 0))))
    ;; Validate the complete type stream before mutating path/current state.
    (block $validated (loop $validate
      (br_if $validated (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $type (i32.load8_u (i32.add (local.get $types) (local.get $i))))
      (local.set $kind (i32.and (local.get $type) (i32.const 6)))
      (if (i32.eq (local.get $kind) (i32.const 4))
        (then
          (if (i32.gt_u (i32.add (local.get $i) (i32.const 2))
                (i32.sub (local.get $count) (i32.const 1)))
            (then (return (i32.const 0))))
          (local.set $j (i32.const 0))
          (block $curve_types_done (loop $curve_types
            (br_if $curve_types_done (i32.ge_u (local.get $j) (i32.const 3)))
            (if (i32.ne (i32.and (i32.load8_u (i32.add (local.get $types)
                  (i32.add (local.get $i) (local.get $j)))) (i32.const 6)) (i32.const 4))
              (then (return (i32.const 0))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $curve_types)))
          (local.set $i (i32.add (local.get $i) (i32.const 3))))
        (else
          (if (i32.and (i32.ne (local.get $kind) (i32.const 2))
                (i32.ne (local.get $kind) (i32.const 6)))
            (then (return (i32.const 0))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))))
      (br $validate)))
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
    (local.set $needs_start (i32.or (i32.eqz (i32.load (local.get $buffer)))
      (i32.ne (i32.and (i32.load offset=12 (local.get $buffer)) (i32.const 1)) (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $sized (loop $size_stream
      (br_if $sized (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $type (i32.load8_u (i32.add (local.get $types) (local.get $i))))
      (local.set $kind (i32.and (local.get $type) (i32.const 6)))
      (if (i32.eq (local.get $kind) (i32.const 6))
        (then (local.set $needs_start (i32.const 0)))
        (else
          (if (local.get $needs_start)
            (then
              (local.set $implicit (i32.add (local.get $implicit) (i32.const 1)))
              (local.set $needs_start (i32.const 0))))))
      (if (i32.eq (local.get $kind) (i32.const 4))
        (then
          (local.set $i (i32.add (local.get $i) (i32.const 2)))
          (local.set $type (i32.load8_u (i32.add (local.get $types) (local.get $i))))))
      (if (i32.ne (i32.and (local.get $type) (i32.const 1)) (i32.const 0))
        (then (local.set $needs_start (i32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $size_stream)))
    (local.set $additional (i32.add (local.get $count) (local.get $implicit)))
    (if (i32.eqz (call $gdi_dc_path_reserve (local.get $entry) (local.get $additional)))
      (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done (loop $items
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $point (i32.add (local.get $points) (i32.shl (local.get $i) (i32.const 3))))
      (local.set $type (i32.load8_u (i32.add (local.get $types) (local.get $i))))
      (local.set $kind (i32.and (local.get $type) (i32.const 6)))
      (if (i32.eq (local.get $kind) (i32.const 6))
        (then
          (if (i32.eqz (call $gdi_dc_path_record_move (local.get $hdc)
                (i32.load (local.get $point)) (i32.load offset=4 (local.get $point))))
            (then (return (i32.const 0)))))
        (else
          (if (i32.eq (local.get $kind) (i32.const 2))
            (then
              (if (i32.eqz (call $gdi_dc_path_record_line (local.get $hdc)
                    (i32.load (local.get $point)) (i32.load offset=4 (local.get $point))))
                (then (return (i32.const 0)))))
            (else
              (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
              (if (i32.or (i32.eqz (i32.load (local.get $buffer)))
                    (i32.ne (i32.and (i32.load offset=12 (local.get $buffer)) (i32.const 1)) (i32.const 0)))
                (then
                  (if (i32.eqz (call $gdi_dc_path_record_move (local.get $hdc)
                        (call $gdi_dc_get_field (local.get $hdc) (i32.const 12) (i32.const 0))
                        (call $gdi_dc_get_field (local.get $hdc) (i32.const 16) (i32.const 0))))
                    (then (return (i32.const 0))))))
              (local.set $j (i32.const 0))
              (block $curve_done (loop $curve
                (br_if $curve_done (i32.ge_u (local.get $j) (i32.const 3)))
                (local.set $point (i32.add (local.get $points)
                  (i32.shl (i32.add (local.get $i) (local.get $j)) (i32.const 3))))
                (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
                      (call $gdi_dc_clip_map_x (local.get $hdc) (i32.load (local.get $point)))
                      (call $gdi_dc_clip_map_y (local.get $hdc) (i32.load offset=4 (local.get $point)))
                      (i32.const 4)))
                  (then (return (i32.const 0))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $curve)))
              (local.set $i (i32.add (local.get $i) (i32.const 2)))))))
      (local.set $point (i32.add (local.get $points) (i32.shl (local.get $i) (i32.const 3))))
      (local.set $type (i32.load8_u (i32.add (local.get $types) (local.get $i))))
      (drop (call $gdi_dc_set_field (local.get $hdc) (i32.const 12)
        (i32.load (local.get $point)) (i32.const 0)))
      (drop (call $gdi_dc_set_field (local.get $hdc) (i32.const 16)
        (i32.load offset=4 (local.get $point)) (i32.const 0)))
      (if (i32.ne (i32.and (local.get $type) (i32.const 1)) (i32.const 0))
        (then
          (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
          (local.set $last (i32.add (i32.add (local.get $buffer) (i32.const 16))
            (i32.mul (i32.sub (i32.load (local.get $buffer)) (i32.const 1)) (i32.const 12))))
          (i32.store offset=8 (local.get $last)
            (i32.or (i32.load offset=8 (local.get $last)) (i32.const 1)))
          (i32.store offset=12 (local.get $buffer) (i32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $items)))
    (i32.const 1))

  (func $gdi_dc_path_record_poly_polyline (param $hdc i32) (param $points i32)
        (param $counts i32) (param $poly_count i32) (result i32)
    (local $entry i32) (local $poly i32) (local $total i32) (local $count i32)
    (local $offset i32)
    (if (i32.or (i32.eqz (local.get $points))
          (i32.or (i32.eqz (local.get $counts))
            (i32.or (i32.eqz (local.get $poly_count)) (i32.gt_u (local.get $poly_count) (i32.const 4096)))))
      (then (return (i32.const 0))))
    (block $counted (loop $counts_loop
      (br_if $counted (i32.ge_u (local.get $poly) (local.get $poly_count)))
      (local.set $count (i32.load (i32.add (local.get $counts)
        (i32.shl (local.get $poly) (i32.const 2)))))
      (if (i32.or (i32.lt_u (local.get $count) (i32.const 2))
            (i32.gt_u (local.get $count) (i32.sub (i32.const 4096) (local.get $total))))
        (then (return (i32.const 0))))
      (local.set $total (i32.add (local.get $total) (local.get $count)))
      (local.set $poly (i32.add (local.get $poly) (i32.const 1)))
      (br $counts_loop)))
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (if (i32.eqz (call $gdi_dc_path_reserve (local.get $entry) (local.get $total)))
      (then (return (i32.const 0))))
    (local.set $poly (i32.const 0))
    (block $done (loop $polylines
      (br_if $done (i32.ge_u (local.get $poly) (local.get $poly_count)))
      (local.set $count (i32.load (i32.add (local.get $counts)
        (i32.shl (local.get $poly) (i32.const 2)))))
      (if (i32.eqz (call $gdi_dc_path_record_polyline (local.get $hdc)
            (i32.add (local.get $points) (i32.shl (local.get $offset) (i32.const 3)))
            (local.get $count) (i32.const 0)))
        (then (return (i32.const 0))))
      (local.set $offset (i32.add (local.get $offset) (local.get $count)))
      (local.set $poly (i32.add (local.get $poly) (i32.const 1)))
      (br $polylines)))
    (i32.const 1))

  (func $gdi_dc_path_record_polygon (param $hdc i32) (param $points i32)
        (param $count i32) (result i32)
    (local $entry i32) (local $buffer i32) (local $i i32) (local $point i32) (local $last i32)
    (if (i32.or (i32.eqz (local.get $points))
          (i32.or (i32.lt_u (local.get $count) (i32.const 2))
            (i32.gt_u (local.get $count) (i32.const 4096))))
      (then (return (i32.const 0))))
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (if (i32.eqz (call $gdi_dc_path_reserve (local.get $entry) (local.get $count)))
      (then (return (i32.const 0))))
    (block $done (loop $points_loop
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $point (i32.add (local.get $points) (i32.shl (local.get $i) (i32.const 3))))
      (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
            (call $gdi_dc_clip_map_x (local.get $hdc) (i32.load (local.get $point)))
            (call $gdi_dc_clip_map_y (local.get $hdc) (i32.load offset=4 (local.get $point)))
            (select (i32.const 6) (i32.const 2) (i32.eqz (local.get $i)))))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $points_loop)))
    (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
    (local.set $last (i32.add (i32.add (local.get $buffer) (i32.const 16))
      (i32.mul (i32.sub (i32.load (local.get $buffer)) (i32.const 1)) (i32.const 12))))
    (i32.store offset=8 (local.get $last)
      (i32.or (i32.load offset=8 (local.get $last)) (i32.const 1)))
    (i32.store offset=12 (local.get $buffer) (i32.const 1))
    (i32.const 1))

  (func $gdi_dc_path_record_rectangle (param $hdc i32) (param $left i32)
        (param $top i32) (param $right i32) (param $bottom i32) (result i32)
    (local $entry i32) (local $buffer i32) (local $last i32)
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (if (i32.eqz (call $gdi_dc_path_reserve (local.get $entry) (i32.const 4)))
      (then (return (i32.const 0))))
    (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
          (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $left))
          (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $top)) (i32.const 6)))
      (then (return (i32.const 0))))
    (drop (call $gdi_dc_path_append_device (local.get $entry)
      (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $right))
      (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $top)) (i32.const 2)))
    (drop (call $gdi_dc_path_append_device (local.get $entry)
      (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $right))
      (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $bottom)) (i32.const 2)))
    (drop (call $gdi_dc_path_append_device (local.get $entry)
      (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $left))
      (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $bottom)) (i32.const 2)))
    (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
    (local.set $last (i32.add (i32.add (local.get $buffer) (i32.const 16))
      (i32.mul (i32.sub (i32.load (local.get $buffer)) (i32.const 1)) (i32.const 12))))
    (i32.store offset=8 (local.get $last)
      (i32.or (i32.load offset=8 (local.get $last)) (i32.const 1)))
    (i32.store offset=12 (local.get $buffer) (i32.const 1))
    (i32.const 1))

  (func $gdi_path_round_positive (param $value f64) (result i32)
    (i32.trunc_f64_s (f64.floor (f64.add (local.get $value) (f64.const 0.5)))))

  ;; Append a precomputed closed device-space shape. line_period is zero for
  ;; an all-Bezier ellipse and four for RoundRect's straight side endpoints.
  (func $gdi_dc_path_append_closed_shape (param $entry i32) (param $points i32)
        (param $count i32) (param $line_period i32) (param $direction i32) (result i32)
    (local $i i32) (local $source_index i32) (local $point i32) (local $type i32)
    (local $buffer i32) (local $last i32)
    (if (i32.eqz (call $gdi_dc_path_reserve (local.get $entry) (local.get $count)))
      (then (return (i32.const 0))))
    (block $done (loop $items
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $source_index
        (select
          (i32.sub (i32.sub (local.get $count) (i32.const 1)) (local.get $i))
          (local.get $i)
          (i32.eq (local.get $direction) (i32.const 2))))
      (local.set $point (i32.add (local.get $points)
        (i32.shl (local.get $source_index) (i32.const 3))))
      (local.set $type (i32.const 4))
      (if (i32.eqz (local.get $i))
        (then (local.set $type (i32.const 6)))
        (else
          (if (local.get $line_period)
            (then
              (if (i32.eqz (i32.rem_u (local.get $i) (local.get $line_period)))
                (then (local.set $type (i32.const 2))))))))
      (if (i32.eq (local.get $i) (i32.sub (local.get $count) (i32.const 1)))
        (then (local.set $type (i32.or (local.get $type) (i32.const 1)))))
      (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
            (i32.load (local.get $point)) (i32.load offset=4 (local.get $point))
            (local.get $type)))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $items)))
    (local.set $buffer (call $g2w (i32.load offset=12 (local.get $entry))))
    (local.set $last (i32.add (i32.add (local.get $buffer) (i32.const 16))
      (i32.mul (i32.sub (i32.load (local.get $buffer)) (i32.const 1)) (i32.const 12))))
    (i32.store offset=8 (local.get $last)
      (i32.or (i32.load offset=8 (local.get $last)) (i32.const 1)))
    (i32.store offset=12 (local.get $buffer) (i32.const 1))
    (i32.const 1))

  (func $gdi_dc_path_record_ellipse (param $hdc i32) (param $left i32)
        (param $top i32) (param $right i32) (param $bottom i32) (result i32)
    (local $entry i32) (local $points_g i32) (local $points i32)
    (local $x0 i32) (local $y0 i32) (local $x1 i32) (local $y1 i32) (local $swap i32)
    (local $half_x i32) (local $half_y i32) (local $control_x i32) (local $control_y i32)
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    (local.set $x0 (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $left)))
    (local.set $x1 (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $right)))
    (local.set $y0 (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $top)))
    (local.set $y1 (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $bottom)))
    (if (i32.gt_s (local.get $x0) (local.get $x1))
      (then (local.set $swap (local.get $x0)) (local.set $x0 (local.get $x1))
        (local.set $x1 (local.get $swap))))
    (if (i32.gt_s (local.get $y0) (local.get $y1))
      (then (local.set $swap (local.get $y0)) (local.set $y0 (local.get $y1))
        (local.set $y1 (local.get $swap))))
    (if (i32.or (i32.eq (local.get $x0) (local.get $x1))
          (i32.eq (local.get $y0) (local.get $y1)))
      (then (return (i32.const 1))))
    (local.set $half_x (call $gdi_path_round_positive
      (f64.div (f64.convert_i32_s (i32.sub (local.get $x1) (local.get $x0))) (f64.const 2))))
    (local.set $half_y (call $gdi_path_round_positive
      (f64.div (f64.convert_i32_s (i32.sub (local.get $y1) (local.get $y0))) (f64.const 2))))
    (local.set $control_x (call $gdi_path_round_positive
      (f64.mul (f64.div (f64.convert_i32_s (i32.sub (local.get $x1) (local.get $x0)))
        (f64.const 2)) (f64.const 0.44571525))))
    (local.set $control_y (call $gdi_path_round_positive
      (f64.mul (f64.div (f64.convert_i32_s (i32.sub (local.get $y1) (local.get $y0)))
        (f64.const 2)) (f64.const 0.44571525))))
    (local.set $points_g (call $heap_alloc (i32.const 104)))
    (if (i32.eqz (local.get $points_g)) (then (return (i32.const 0))))
    (local.set $points (call $g2w (local.get $points_g)))
    ;; Start at the right midpoint and traverse counterclockwise by default.
    (i32.store (local.get $points) (local.get $x1))
    (i32.store offset=4 (local.get $points) (i32.add (local.get $y0) (local.get $half_y)))
    (i32.store offset=8 (local.get $points) (local.get $x1))
    (i32.store offset=12 (local.get $points) (i32.add (local.get $y0) (local.get $control_y)))
    (i32.store offset=16 (local.get $points) (i32.sub (local.get $x1) (local.get $control_x)))
    (i32.store offset=20 (local.get $points) (local.get $y0))
    (i32.store offset=24 (local.get $points) (i32.add (local.get $x0) (local.get $half_x)))
    (i32.store offset=28 (local.get $points) (local.get $y0))
    (i32.store offset=32 (local.get $points) (i32.add (local.get $x0) (local.get $control_x)))
    (i32.store offset=36 (local.get $points) (local.get $y0))
    (i32.store offset=40 (local.get $points) (local.get $x0))
    (i32.store offset=44 (local.get $points) (i32.add (local.get $y0) (local.get $control_y)))
    (i32.store offset=48 (local.get $points) (local.get $x0))
    (i32.store offset=52 (local.get $points) (i32.add (local.get $y0) (local.get $half_y)))
    (i32.store offset=56 (local.get $points) (local.get $x0))
    (i32.store offset=60 (local.get $points) (i32.sub (local.get $y1) (local.get $control_y)))
    (i32.store offset=64 (local.get $points) (i32.add (local.get $x0) (local.get $control_x)))
    (i32.store offset=68 (local.get $points) (local.get $y1))
    (i32.store offset=72 (local.get $points) (i32.add (local.get $x0) (local.get $half_x)))
    (i32.store offset=76 (local.get $points) (local.get $y1))
    (i32.store offset=80 (local.get $points) (i32.sub (local.get $x1) (local.get $control_x)))
    (i32.store offset=84 (local.get $points) (local.get $y1))
    (i32.store offset=88 (local.get $points) (local.get $x1))
    (i32.store offset=92 (local.get $points) (i32.sub (local.get $y1) (local.get $control_y)))
    (i32.store offset=96 (local.get $points) (local.get $x1))
    (i32.store offset=100 (local.get $points) (i32.sub (local.get $y1) (local.get $half_y)))
    (local.set $swap (call $gdi_dc_path_append_closed_shape
      (local.get $entry) (local.get $points) (i32.const 13) (i32.const 0)
      (call $gdi_dc_aux_get (local.get $hdc) (i32.const 4) (i32.const 1))))
    (call $heap_free (local.get $points_g))
    (local.get $swap))

  (func $gdi_dc_path_record_round_rect (param $hdc i32) (param $left i32)
        (param $top i32) (param $right i32) (param $bottom i32)
        (param $ellipse_w i32) (param $ellipse_h i32) (result i32)
    (local $entry i32) (local $points_g i32) (local $points i32)
    (local $x0 i32) (local $y0 i32) (local $x1 i32) (local $y1 i32) (local $swap i32)
    (local $rw i32) (local $rh i32) (local $half_x i32) (local $half_y i32)
    (local $control_x i32) (local $control_y i32)
    (if (i32.or (i32.eqz (local.get $ellipse_w)) (i32.eqz (local.get $ellipse_h)))
      (then (return (call $gdi_dc_path_record_rectangle
        (local.get $hdc) (local.get $left) (local.get $top)
        (local.get $right) (local.get $bottom)))))
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    (local.set $x0 (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $left)))
    (local.set $x1 (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $right)))
    (local.set $y0 (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $top)))
    (local.set $y1 (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $bottom)))
    (if (i32.gt_s (local.get $x0) (local.get $x1))
      (then (local.set $swap (local.get $x0)) (local.set $x0 (local.get $x1))
        (local.set $x1 (local.get $swap))))
    (if (i32.gt_s (local.get $y0) (local.get $y1))
      (then (local.set $swap (local.get $y0)) (local.set $y0 (local.get $y1))
        (local.set $y1 (local.get $swap))))
    (if (i32.or (i32.eq (local.get $x0) (local.get $x1))
          (i32.eq (local.get $y0) (local.get $y1)))
      (then (return (i32.const 1))))
    (local.set $rw (i32.sub
      (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $ellipse_w))
      (call $gdi_dc_clip_map_x (local.get $hdc) (i32.const 0))))
    (local.set $rh (i32.sub
      (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $ellipse_h))
      (call $gdi_dc_clip_map_y (local.get $hdc) (i32.const 0))))
    (if (i32.lt_s (local.get $rw) (i32.const 0))
      (then (local.set $rw (i32.sub (i32.const 0) (local.get $rw)))))
    (if (i32.lt_s (local.get $rh) (i32.const 0))
      (then (local.set $rh (i32.sub (i32.const 0) (local.get $rh)))))
    (if (i32.gt_u (local.get $rw) (i32.sub (local.get $x1) (local.get $x0)))
      (then (local.set $rw (i32.sub (local.get $x1) (local.get $x0)))))
    (if (i32.gt_u (local.get $rh) (i32.sub (local.get $y1) (local.get $y0)))
      (then (local.set $rh (i32.sub (local.get $y1) (local.get $y0)))))
    (if (i32.or (i32.le_u (local.get $rw) (i32.const 1))
          (i32.le_u (local.get $rh) (i32.const 1)))
      (then (return (call $gdi_dc_path_record_rectangle
        (local.get $hdc) (local.get $left) (local.get $top)
        (local.get $right) (local.get $bottom)))))
    (local.set $half_x (call $gdi_path_round_positive
      (f64.div (f64.convert_i32_u (local.get $rw)) (f64.const 2))))
    (local.set $half_y (call $gdi_path_round_positive
      (f64.div (f64.convert_i32_u (local.get $rh)) (f64.const 2))))
    (local.set $control_x (call $gdi_path_round_positive
      (f64.mul (f64.div (f64.convert_i32_u (local.get $rw)) (f64.const 2))
        (f64.const 0.44571525))))
