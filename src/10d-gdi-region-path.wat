    ;; partial construction on failure before restoring the retained path.
    (if (i32.load offset=12 (local.get $entry))
      (then (call $gdi_dc_path_discard (local.get $entry))))
    (i32.store offset=4 (local.get $entry) (local.get $old_region))
    (i32.store offset=8 (local.get $entry) (local.get $old_state))
    (i32.store offset=12 (local.get $entry) (local.get $old_buffer))
    (local.get $ok))

  ;; AngleArc is defined in logical polar coordinates and always connects the
  ;; current position to the first arc point. Split multi-turn sweeps into
  ;; bounded full-circle pieces and reuse the exact ArcTo path projection.
  (func $gdi_dc_path_record_angle_arc (param $hdc i32) (param $center_x i32)
        (param $center_y i32) (param $radius i32) (param $start_degrees f64)
        (param $sweep_degrees f64) (result i32)
    (local $old_direction i32) (local $direction i32) (local $ok i32)
    (local $remaining f64) (local $angle f64) (local $next_angle f64) (local $chunk f64)
    (local $start_x i32) (local $start_y i32) (local $end_x i32) (local $end_y i32)
    (local $cx i64) (local $cy i64) (local $r i64)
    (if (i32.or (i32.eqz (local.get $radius))
          (i32.or (f64.ne (local.get $start_degrees) (local.get $start_degrees))
            (f64.ne (local.get $sweep_degrees) (local.get $sweep_degrees))))
      (then (return (i32.const 0))))
    (if (f64.gt (f64.abs (local.get $start_degrees)) (f64.const 1000000000))
      (then (return (i32.const 0))))
    (if (f64.gt (f64.abs (local.get $sweep_degrees)) (f64.const 90000))
      (then (return (i32.const 0))))
    (local.set $cx (i64.extend_i32_s (local.get $center_x)))
    (local.set $cy (i64.extend_i32_s (local.get $center_y)))
    (local.set $r (i64.extend_i32_u (local.get $radius)))
    (if (i32.or
          (i32.or
            (i64.lt_s (i64.sub (local.get $cx) (local.get $r)) (i64.const -2147483648))
            (i64.gt_s (i64.add (local.get $cx) (local.get $r)) (i64.const 2147483647)))
          (i32.or
            (i64.lt_s (i64.sub (local.get $cy) (local.get $r)) (i64.const -2147483648))
            (i64.gt_s (i64.add (local.get $cy) (local.get $r)) (i64.const 2147483647))))
      (then (return (i32.const 0))))
    (local.set $old_direction
      (call $gdi_dc_aux_get (local.get $hdc) (i32.const 4) (i32.const 1)))
    (local.set $direction
      (select (i32.const 1) (i32.const 2)
        (f64.ge (local.get $sweep_degrees) (f64.const 0))))
    (drop (call $gdi_dc_aux_set
      (local.get $hdc) (i32.const 4) (local.get $direction) (i32.const 1)))
    (local.set $remaining (local.get $sweep_degrees))
    (local.set $angle (local.get $start_degrees))
    (local.set $start_x (i32.add (local.get $center_x)
      (call $gdi_path_round_positive (f64.mul (f64.convert_i32_u (local.get $radius))
        (call $host_math_cos (f64.mul (local.get $angle) (f64.const 0.017453292519943295)))))))
    (local.set $start_y (i32.sub (local.get $center_y)
      (call $gdi_path_round_positive (f64.mul (f64.convert_i32_u (local.get $radius))
        (call $host_math_sin (f64.mul (local.get $angle) (f64.const 0.017453292519943295)))))))
