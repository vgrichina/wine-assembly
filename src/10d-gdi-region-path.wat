              (f64.floor (f64.add
                (f64.div (local.get $part_start) (f64.const 1.5707963267948966))
                (f64.const 1))) (f64.const 1.5707963267948966))))
            (else (local.set $part_end (f64.mul
              (f64.ceil (f64.sub
                (f64.div (local.get $part_start) (f64.const 1.5707963267948966))
                (f64.const 1))) (f64.const 1.5707963267948966))))))
        (else
