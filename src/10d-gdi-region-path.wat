    (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
          (call $gdi_path_scale_arc (local.get $left) (local.get $right) (local.get $x1))
          (call $gdi_path_scale_arc (local.get $top) (local.get $bottom) (local.get $y1))
          (i32.const 4)))
