  ;; A half-pixel device-space tolerance keeps the raster result stable while
  ;; avoiding the old fixed 32-segment cost on almost-straight curves.
  (func $gdi_bezier_flat_enough
        (param $x0 f64) (param $y0 f64) (param $x1 f64) (param $y1 f64)
        (param $x2 f64) (param $y2 f64) (param $x3 f64) (param $y3 f64) (result i32)
    (local $dx f64) (local $dy f64) (local $len2 f64)
    (local $c1 f64) (local $c2 f64) (local $d1 f64) (local $d2 f64)
    (local.set $dx (f64.sub (local.get $x3) (local.get $x0)))
    (local.set $dy (f64.sub (local.get $y3) (local.get $y0)))
    (local.set $len2 (f64.add (f64.mul (local.get $dx) (local.get $dx))
      (f64.mul (local.get $dy) (local.get $dy))))
    (if (result i32) (f64.le (local.get $len2) (f64.const 0.000000001))
      (then
        (local.set $d1 (f64.add
