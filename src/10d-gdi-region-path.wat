                    (i32.ne (i32.and (i32.load offset=8 (local.get $p3)) (i32.const 6)) (i32.const 4)))
                (then (return (i32.const 0))))
              (if (i32.or
                    (i32.ne (i32.and (i32.load offset=8 (local.get $p2)) (i32.const -8)) (i32.const 0))
                    (i32.ne (i32.and (i32.load offset=8 (local.get $p3)) (i32.const -8)) (i32.const 0)))
                (then (return (i32.const 0))))
              (if (i32.or
                    (i32.ne (i32.and (i32.load offset=8 (local.get $p1)) (i32.const 1)) (i32.const 0))
                    (i32.ne (i32.and (i32.load offset=8 (local.get $p2)) (i32.const 1)) (i32.const 0)))
                (then (return (i32.const 0))))
              (local.set $segments (call $gdi_bezier_leaf_count
                (f64.convert_i32_s (local.get $p0x)) (f64.convert_i32_s (local.get $p0y))
                (f64.convert_i32_s (i32.load (local.get $p1)))
                (f64.convert_i32_s (i32.load offset=4 (local.get $p1)))
                (f64.convert_i32_s (i32.load (local.get $p2)))
                (f64.convert_i32_s (i32.load offset=4 (local.get $p2)))
                (f64.convert_i32_s (i32.load (local.get $p3)))
                (f64.convert_i32_s (i32.load offset=4 (local.get $p3)))
                (i32.const 0)))
              (if (i32.gt_u (local.get $segments) (i32.sub (i32.const 65535) (local.get $out_count)))
                (then (return (i32.const 0))))
              (local.set $out_count (i32.add (local.get $out_count) (local.get $segments)))
              (local.set $p0x (i32.load (local.get $p3)))
              (local.set $p0y (i32.load offset=4 (local.get $p3)))
              (local.set $type (i32.load offset=8 (local.get $p3)))
              (local.set $i (i32.add (local.get $i) (i32.const 2)))))))
      (if (i32.ne (i32.and (local.get $type) (i32.const 1)) (i32.const 0))
        (then (local.set $has_current (i32.const 0))))
      (if (i32.gt_u (local.get $out_count) (i32.const 65535))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $size)))
    (local.set $target_g (call $heap_alloc
      (i32.add (i32.const 16) (i32.mul (local.get $out_count) (i32.const 12)))))
    (if (i32.eqz (local.get $target_g)) (then (return (i32.const 0))))
    (local.set $target (call $g2w (local.get $target_g)))
    (memory.fill (local.get $target) (i32.const 0)
      (i32.add (i32.const 16) (i32.mul (local.get $out_count) (i32.const 12))))
    (i32.store (local.get $target) (local.get $out_count))
    (i32.store offset=4 (local.get $target) (local.get $out_count))
    (i32.store offset=8 (local.get $target) (i32.const -1))
    (local.set $i (i32.const 0))
    (local.set $out (i32.const 0))
    (block $copy_done (loop $copy
      (br_if $copy_done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $point (i32.add (i32.add (local.get $source) (i32.const 16))
        (i32.mul (local.get $i) (i32.const 12))))
      (local.set $type (i32.load offset=8 (local.get $point)))
      (local.set $kind (i32.and (local.get $type) (i32.const 6)))
      (if (i32.ne (local.get $kind) (i32.const 4))
        (then
          (memory.copy
            (i32.add (i32.add (local.get $target) (i32.const 16))
              (i32.mul (local.get $out) (i32.const 12)))
            (local.get $point) (i32.const 12))
          (local.set $p0x (i32.load (local.get $point)))
          (local.set $p0y (i32.load offset=4 (local.get $point)))
          (local.set $out (i32.add (local.get $out) (i32.const 1))))
        (else
          (local.set $p1 (local.get $point))
          (local.set $p2 (i32.add (local.get $point) (i32.const 12)))
          (local.set $p3 (i32.add (local.get $point) (i32.const 24)))
          (local.set $close (i32.and (i32.load offset=8 (local.get $p3)) (i32.const 1)))
          (local.set $out (call $gdi_bezier_emit (local.get $target) (local.get $out)
            (f64.convert_i32_s (local.get $p0x)) (f64.convert_i32_s (local.get $p0y))
            (f64.convert_i32_s (i32.load (local.get $p1)))
            (f64.convert_i32_s (i32.load offset=4 (local.get $p1)))
            (f64.convert_i32_s (i32.load (local.get $p2)))
            (f64.convert_i32_s (i32.load offset=4 (local.get $p2)))
            (f64.convert_i32_s (i32.load (local.get $p3)))
            (f64.convert_i32_s (i32.load offset=4 (local.get $p3)))
            (i32.const 0) (local.get $close)))
          (local.set $p0x (i32.load (local.get $p3)))
          (local.set $p0y (i32.load offset=4 (local.get $p3)))
          (local.set $i (i32.add (local.get $i) (i32.const 2)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $copy)))
    (local.get $target_g))

  (func $gdi_dc_path_flatten (param $hdc i32) (result i32)
    (local $entry i32) (local $flat_g i32) (local $old_g i32) (local $region i32)
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (local.set $flat_g (call $gdi_dc_path_flatten_copy (local.get $entry)))
    (if (i32.eqz (local.get $flat_g)) (then (return (i32.const 0))))
    (local.set $old_g (i32.load offset=12 (local.get $entry)))
    (local.set $region (i32.load offset=4 (local.get $entry)))
    (if (local.get $region) (then (drop (call $gdi_rgn_delete (local.get $region)))))
    (i32.store offset=4 (local.get $entry) (i32.const 0))
    (i32.store offset=12 (local.get $entry) (local.get $flat_g))
    (call $heap_free (local.get $old_g))
    (i32.const 1))

  (func $gdi_path_widen_mark_rect (param $mask i32) (param $mask_w i32)
        (param $mask_h i32) (param $origin_x i32) (param $origin_y i32)
        (param $left i32) (param $top i32) (param $right i32) (param $bottom i32)
    (local $x0 i32) (local $y0 i32) (local $x1 i32) (local $y1 i32) (local $y i32)
    (local.set $x0 (i32.sub (local.get $left) (local.get $origin_x)))
    (local.set $y0 (i32.sub (local.get $top) (local.get $origin_y)))
    (local.set $x1 (i32.sub (local.get $right) (local.get $origin_x)))
    (local.set $y1 (i32.sub (local.get $bottom) (local.get $origin_y)))
    (if (i32.lt_s (local.get $x0) (i32.const 0)) (then (local.set $x0 (i32.const 0))))
    (if (i32.lt_s (local.get $y0) (i32.const 0)) (then (local.set $y0 (i32.const 0))))
    (if (i32.gt_s (local.get $x1) (local.get $mask_w))
      (then (local.set $x1 (local.get $mask_w))))
    (if (i32.gt_s (local.get $y1) (local.get $mask_h))
      (then (local.set $y1 (local.get $mask_h))))
    (local.set $y (local.get $y0))
    (block $done (loop $rows
      (br_if $done (i32.ge_s (local.get $y) (local.get $y1)))
      (if (i32.lt_s (local.get $x0) (local.get $x1))
        (then (memory.fill
          (i32.add (local.get $mask)
            (i32.add (i32.mul (local.get $y) (local.get $mask_w)) (local.get $x0)))
          (i32.const 1) (i32.sub (local.get $x1) (local.get $x0)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $rows))))

  ;; Mark exactly the same device-pixel footprint as the canonical wide-line
  ;; renderer. Widths 2..5 use captured Win98 rectangle/hull coverage at every
  ;; angle; other widths retain endpoint-exclusive Bresenham square stamps.
  (func $gdi_win98_wide_edge_boundary (param $base i32) (param $dx i32)
        (param $dy i32) (param $k i32) (param $reversed i32) (result i32)
    (local $abs_dx i32) (local $sign i32) (local $offset i32)
    (if (i32.le_s (local.get $k) (i32.const 0)) (then (return (local.get $base))))
    (local.set $abs_dx (select (local.get $dx) (i32.sub (i32.const 0) (local.get $dx))
      (i32.ge_s (local.get $dx) (i32.const 0))))
    (local.set $sign (select (i32.const 1) (i32.const -1)
      (i32.ge_s (local.get $dx) (i32.const 0))))
    (if (i32.gt_u (local.get $abs_dx) (local.get $dy))
      (then
        (local.set $offset (i32.div_u
          (i32.add (i32.mul (local.get $abs_dx) (local.get $k))
            (i32.shr_u (i32.sub (local.get $abs_dx) (i32.const 1)) (i32.const 1)))
          (local.get $dy))))
      (else
        (local.set $offset (i32.div_s
          (i32.add
            (i32.sub (i32.shr_u (local.get $dy) (i32.const 1)) (local.get $reversed))
            (i32.mul (local.get $abs_dx) (local.get $k)))
          (local.get $dy)))))
    (i32.add (local.get $base) (i32.mul (local.get $sign) (local.get $offset))))

  (func $gdi_path_widen_segment (param $mask i32) (param $mask_w i32)
        (param $mask_h i32) (param $origin_x i32) (param $origin_y i32)
        (param $from_x i32) (param $from_y i32) (param $to_x i32) (param $to_y i32)
        (param $width i32)
    (local $x0 i32) (local $y0 i32) (local $x1 i32) (local $y1 i32)
    (local $dx i32) (local $dy i32) (local $sx i32) (local $sy i32)
    (local $err i32) (local $e2 i32) (local $half i32) (local $far i32)
    (local $left i32) (local $top i32) (local $right i32) (local $bottom i32)
    (local $px i32) (local $py i32) (local $qx i32) (local $qy i32) (local $y i32)
    (local.set $x0 (local.get $from_x)) (local.set $y0 (local.get $from_y))
    (local.set $x1 (local.get $to_x)) (local.set $y1 (local.get $to_y))
    (if (i32.and (i32.eq (local.get $x0) (local.get $x1))
          (i32.eq (local.get $y0) (local.get $y1)))
      (then (return)))
    (local.set $half (i32.shr_u (local.get $width) (i32.const 1)))
    (local.set $far (i32.sub (local.get $width) (local.get $half)))
    (if (i32.and (i32.ge_u (local.get $width) (i32.const 2))
          (i32.and (i32.le_u (local.get $width) (i32.const 5))
            (i32.and (i32.ne (local.get $x0) (local.get $x1))
              (i32.ne (local.get $y0) (local.get $y1)))))
      (then
        (if (i32.lt_s (local.get $x0) (local.get $x1))
          (then
            (local.set $px (local.get $x0)) (local.set $py (local.get $y0))
            (local.set $qx (local.get $x1)) (local.set $qy (local.get $y1)))
          (else
            (local.set $px (local.get $x1)) (local.set $py (local.get $y1))
            (local.set $qx (local.get $x0)) (local.set $qy (local.get $y0))))
        (if (i32.lt_s (local.get $py) (local.get $qy))
          (then
            (local.set $top (i32.sub (local.get $py) (local.get $half)))
            (local.set $bottom (i32.add (local.get $qy) (local.get $far)))
            (local.set $y (local.get $top))
            (block $positive_done (loop $positive_rows
              (br_if $positive_done (i32.ge_s (local.get $y) (local.get $bottom)))
              (local.set $left
                (if (result i32) (i32.lt_s (local.get $y) (i32.add (local.get $py) (local.get $far)))
                  (then (i32.sub (local.get $px) (local.get $half)))
                  (else (call $gdi_win98_wide_edge_boundary
                    (i32.sub (local.get $px) (local.get $half))
                    (i32.sub (local.get $qx) (local.get $px))
                    (i32.sub (local.get $qy) (local.get $py))
                    (i32.sub (local.get $y) (i32.add (local.get $py) (local.get $far)))
                    (i32.const 1)))))
              (local.set $right
                (if (result i32) (i32.lt_s (local.get $y) (i32.sub (local.get $qy) (local.get $half)))
                  (then (call $gdi_win98_wide_edge_boundary
                    (i32.add (local.get $px) (local.get $far))
                    (i32.sub (local.get $qx) (local.get $px))
                    (i32.sub (local.get $qy) (local.get $py))
                    (i32.sub (local.get $y) (i32.sub (local.get $py) (local.get $half)))
                    (i32.const 0)))
                  (else (i32.add (local.get $qx) (local.get $far)))))
              (call $gdi_path_widen_mark_rect
                (local.get $mask) (local.get $mask_w) (local.get $mask_h)
                (local.get $origin_x) (local.get $origin_y)
                (local.get $left) (local.get $y) (local.get $right)
                (i32.add (local.get $y) (i32.const 1)))
              (local.set $y (i32.add (local.get $y) (i32.const 1)))
              (br $positive_rows))))
          (else
            (local.set $top (i32.sub (local.get $qy) (local.get $half)))
            (local.set $bottom (i32.add (local.get $py) (local.get $far)))
            (local.set $y (local.get $top))
            (block $negative_done (loop $negative_rows
              (br_if $negative_done (i32.ge_s (local.get $y) (local.get $bottom)))
              (local.set $left
                (if (result i32) (i32.lt_s (local.get $y) (i32.sub (local.get $py) (local.get $half)))
                  (then (call $gdi_win98_wide_edge_boundary
                    (i32.sub (local.get $qx) (local.get $half))
                    (i32.sub (local.get $px) (local.get $qx))
                    (i32.sub (local.get $py) (local.get $qy))
                    (i32.sub (local.get $y) (i32.sub (local.get $qy) (local.get $half)))
                    (i32.const 1)))
                  (else (i32.sub (local.get $px) (local.get $half)))))
              (local.set $right
                (if (result i32) (i32.lt_s (local.get $y) (i32.add (local.get $qy) (local.get $far)))
                  (then (i32.add (local.get $qx) (local.get $far)))
                  (else (call $gdi_win98_wide_edge_boundary
                    (i32.add (local.get $qx) (local.get $far))
                    (i32.sub (local.get $px) (local.get $qx))
                    (i32.sub (local.get $py) (local.get $qy))
                    (i32.sub (local.get $y) (i32.add (local.get $qy) (local.get $far)))
                    (i32.const 0)))))
              (call $gdi_path_widen_mark_rect
                (local.get $mask) (local.get $mask_w) (local.get $mask_h)
                (local.get $origin_x) (local.get $origin_y)
                (local.get $left) (local.get $y) (local.get $right)
                (i32.add (local.get $y) (i32.const 1)))
              (local.set $y (i32.add (local.get $y) (i32.const 1)))
              (br $negative_rows)))))
        (return)))
    (if (i32.and (i32.ge_u (local.get $width) (i32.const 2))
          (i32.and (i32.le_u (local.get $width) (i32.const 5))
            (i32.or (i32.eq (local.get $x0) (local.get $x1))
              (i32.eq (local.get $y0) (local.get $y1)))))
      (then
        (if (i32.eq (local.get $y0) (local.get $y1))
          (then
            (local.set $left (i32.sub
              (select (local.get $x0) (local.get $x1) (i32.lt_s (local.get $x0) (local.get $x1)))
              (local.get $half)))
            (local.set $right (i32.add
              (select (local.get $x1) (local.get $x0) (i32.lt_s (local.get $x0) (local.get $x1)))
              (local.get $far)))
            (local.set $top (i32.sub (local.get $y0) (local.get $half)))
            (local.set $bottom (i32.add (local.get $top) (local.get $width))))
          (else
            (local.set $left (i32.sub (local.get $x0) (local.get $half)))
            (local.set $right (i32.add (local.get $left) (local.get $width)))
            (local.set $top (i32.sub
              (select (local.get $y0) (local.get $y1) (i32.lt_s (local.get $y0) (local.get $y1)))
              (local.get $half)))
            (local.set $bottom (i32.add
              (select (local.get $y1) (local.get $y0) (i32.lt_s (local.get $y0) (local.get $y1)))
              (local.get $far)))))
        (call $gdi_path_widen_mark_rect
          (local.get $mask) (local.get $mask_w) (local.get $mask_h)
          (local.get $origin_x) (local.get $origin_y)
          (local.get $left) (local.get $top) (local.get $right) (local.get $bottom))
        (return)))
    (if (i32.ge_s (local.get $x1) (local.get $x0))
      (then (local.set $dx (i32.sub (local.get $x1) (local.get $x0)))
        (local.set $sx (i32.const 1)))
      (else (local.set $dx (i32.sub (local.get $x0) (local.get $x1)))
        (local.set $sx (i32.const -1))))
    (if (i32.ge_s (local.get $y1) (local.get $y0))
      (then (local.set $dy (i32.sub (local.get $y0) (local.get $y1)))
        (local.set $sy (i32.const 1)))
      (else (local.set $dy (i32.sub (local.get $y1) (local.get $y0)))
        (local.set $sy (i32.const -1))))
    (local.set $err (i32.add (local.get $dx) (local.get $dy)))
    (block $done (loop $pixels
      (br_if $done (i32.and (i32.eq (local.get $x0) (local.get $x1))
        (i32.eq (local.get $y0) (local.get $y1))))
      (call $gdi_path_widen_mark_rect
        (local.get $mask) (local.get $mask_w) (local.get $mask_h)
        (local.get $origin_x) (local.get $origin_y)
        (i32.sub (local.get $x0) (local.get $half))
        (i32.sub (local.get $y0) (local.get $half))
        (i32.add (local.get $x0) (local.get $far))
        (i32.add (local.get $y0) (local.get $far)))
      (local.set $e2 (i32.shl (local.get $err) (i32.const 1)))
      (if (i32.ge_s (local.get $e2) (local.get $dy))
        (then (local.set $err (i32.add (local.get $err) (local.get $dy)))
          (local.set $x0 (i32.add (local.get $x0) (local.get $sx)))))
      (if (i32.le_s (local.get $e2) (local.get $dx))
        (then (local.set $err (i32.add (local.get $err) (local.get $dx)))
          (local.set $y0 (i32.add (local.get $y0) (local.get $sy)))))
      (br $pixels))))

  (func $gdi_path_mask_set (param $mask i32) (param $mask_w i32) (param $mask_h i32)
        (param $origin_x i32) (param $origin_y i32) (param $x i32) (param $y i32)
    (local $mx i32) (local $my i32)
    (local.set $mx (i32.sub (local.get $x) (local.get $origin_x)))
    (local.set $my (i32.sub (local.get $y) (local.get $origin_y)))
    (if (i32.and (i32.lt_u (local.get $mx) (local.get $mask_w))
          (i32.lt_u (local.get $my) (local.get $mask_h)))
      (then (i32.store8 (i32.add (local.get $mask)
        (i32.add (i32.mul (local.get $my) (local.get $mask_w)) (local.get $mx))) (i32.const 1)))))

  ;; Flat-capped analytic segment used as the common body of geometric paths.
  (func $gdi_path_widen_geometric_segment (param $mask i32) (param $mask_w i32)
        (param $mask_h i32) (param $origin_x i32) (param $origin_y i32)
        (param $x0 i32) (param $y0 i32) (param $x1 i32) (param $y1 i32) (param $width i32)
    (local $margin i32) (local $left i32) (local $top i32) (local $right i32) (local $bottom i32)
    (local $x i32) (local $y i32) (local $vx f64) (local $vy f64) (local $len2 f64)
    (local $px f64) (local $py f64) (local $dot f64) (local $cross f64) (local $radius2 f64)
    (if (i32.and (i32.eq (local.get $x0) (local.get $x1)) (i32.eq (local.get $y0) (local.get $y1))) (then (return)))
    (local.set $vx (f64.convert_i32_s (i32.sub (local.get $x1) (local.get $x0))))
    (local.set $vy (f64.convert_i32_s (i32.sub (local.get $y1) (local.get $y0))))
    (local.set $len2 (f64.add (f64.mul (local.get $vx) (local.get $vx)) (f64.mul (local.get $vy) (local.get $vy))))
    (local.set $radius2 (f64.mul (f64.mul (f64.convert_i32_u (local.get $width)) (f64.const 0.5))
      (f64.mul (f64.convert_i32_u (local.get $width)) (f64.const 0.5))))
    (local.set $margin (i32.add (local.get $width) (i32.const 1)))
    (local.set $left (i32.sub (select (local.get $x0) (local.get $x1) (i32.lt_s (local.get $x0) (local.get $x1))) (local.get $margin)))
    (local.set $right (i32.add (select (local.get $x1) (local.get $x0) (i32.lt_s (local.get $x0) (local.get $x1))) (local.get $margin)))
    (local.set $top (i32.sub (select (local.get $y0) (local.get $y1) (i32.lt_s (local.get $y0) (local.get $y1))) (local.get $margin)))
    (local.set $bottom (i32.add (select (local.get $y1) (local.get $y0) (i32.lt_s (local.get $y0) (local.get $y1))) (local.get $margin)))
    (local.set $y (local.get $top))
    (block $rows_done (loop $rows
      (br_if $rows_done (i32.ge_s (local.get $y) (local.get $bottom)))
      (local.set $x (local.get $left))
      (block $cols_done (loop $cols
        (br_if $cols_done (i32.ge_s (local.get $x) (local.get $right)))
        (local.set $px (f64.sub (f64.add (f64.convert_i32_s (local.get $x)) (f64.const 0.5)) (f64.convert_i32_s (local.get $x0))))
        (local.set $py (f64.sub (f64.add (f64.convert_i32_s (local.get $y)) (f64.const 0.5)) (f64.convert_i32_s (local.get $y0))))
        (local.set $dot (f64.add (f64.mul (local.get $px) (local.get $vx)) (f64.mul (local.get $py) (local.get $vy))))
        (local.set $cross (f64.sub (f64.mul (local.get $px) (local.get $vy)) (f64.mul (local.get $py) (local.get $vx))))
        (if (i32.and (i32.and (f64.ge (local.get $dot) (f64.const 0)) (f64.le (local.get $dot) (local.get $len2)))
              (f64.le (f64.mul (local.get $cross) (local.get $cross)) (f64.mul (local.get $radius2) (local.get $len2))))
          (then (call $gdi_path_mask_set (local.get $mask) (local.get $mask_w) (local.get $mask_h)
            (local.get $origin_x) (local.get $origin_y) (local.get $x) (local.get $y))))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $cols)))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $rows))))

  (func $gdi_path_widen_disk (param $mask i32) (param $mask_w i32) (param $mask_h i32)
        (param $origin_x i32) (param $origin_y i32) (param $cx i32) (param $cy i32) (param $width i32)
    (local $m i32) (local $x i32) (local $y i32) (local $dx f64) (local $dy f64) (local $r2 f64)
    (local.set $m (i32.add (local.get $width) (i32.const 1)))
    (local.set $r2 (f64.mul (f64.mul (f64.convert_i32_u (local.get $width)) (f64.const 0.5))
      (f64.mul (f64.convert_i32_u (local.get $width)) (f64.const 0.5))))
    (local.set $y (i32.sub (local.get $cy) (local.get $m)))
    (block $rows_done (loop $rows
      (br_if $rows_done (i32.ge_s (local.get $y) (i32.add (local.get $cy) (local.get $m))))
      (local.set $x (i32.sub (local.get $cx) (local.get $m)))
      (block $cols_done (loop $cols
        (br_if $cols_done (i32.ge_s (local.get $x) (i32.add (local.get $cx) (local.get $m))))
        (local.set $dx (f64.sub (f64.add (f64.convert_i32_s (local.get $x)) (f64.const 0.5)) (f64.convert_i32_s (local.get $cx))))
        (local.set $dy (f64.sub (f64.add (f64.convert_i32_s (local.get $y)) (f64.const 0.5)) (f64.convert_i32_s (local.get $cy))))
        (if (f64.le (f64.add (f64.mul (local.get $dx) (local.get $dx))
              (f64.mul (local.get $dy) (local.get $dy))) (local.get $r2))
          (then (call $gdi_path_mask_set (local.get $mask) (local.get $mask_w) (local.get $mask_h)
            (local.get $origin_x) (local.get $origin_y) (local.get $x) (local.get $y))))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $cols)))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $rows))))

  ;; Square endpoint cap: the half-width rectangle beyond one endpoint.
  (func $gdi_path_widen_square_cap (param $mask i32) (param $mask_w i32) (param $mask_h i32)
        (param $origin_x i32) (param $origin_y i32) (param $end_x i32) (param $end_y i32)
        (param $neighbor_x i32) (param $neighbor_y i32) (param $width i32)
    (local $m i32) (local $x i32) (local $y i32) (local $vx f64) (local $vy f64)
    (local $len2 f64) (local $limit f64) (local $px f64) (local $py f64) (local $dot f64) (local $cross f64) (local $r2 f64)
    (local.set $vx (f64.convert_i32_s (i32.sub (local.get $end_x) (local.get $neighbor_x))))
    (local.set $vy (f64.convert_i32_s (i32.sub (local.get $end_y) (local.get $neighbor_y))))
    (local.set $len2 (f64.add (f64.mul (local.get $vx) (local.get $vx)) (f64.mul (local.get $vy) (local.get $vy))))
    (if (f64.eq (local.get $len2) (f64.const 0)) (then (return)))
    (local.set $r2 (f64.mul (f64.mul (f64.convert_i32_u (local.get $width)) (f64.const 0.5))
      (f64.mul (f64.convert_i32_u (local.get $width)) (f64.const 0.5))))
    (local.set $limit (f64.mul (f64.sqrt (local.get $r2)) (f64.sqrt (local.get $len2))))
    (local.set $m (i32.add (local.get $width) (i32.const 1)))
    (local.set $y (i32.sub (local.get $end_y) (local.get $m)))
    (block $rows_done (loop $rows
      (br_if $rows_done (i32.ge_s (local.get $y) (i32.add (local.get $end_y) (local.get $m))))
      (local.set $x (i32.sub (local.get $end_x) (local.get $m)))
      (block $cols_done (loop $cols
        (br_if $cols_done (i32.ge_s (local.get $x) (i32.add (local.get $end_x) (local.get $m))))
        (local.set $px (f64.sub (f64.add (f64.convert_i32_s (local.get $x)) (f64.const 0.5)) (f64.convert_i32_s (local.get $end_x))))
        (local.set $py (f64.sub (f64.add (f64.convert_i32_s (local.get $y)) (f64.const 0.5)) (f64.convert_i32_s (local.get $end_y))))
        (local.set $dot (f64.add (f64.mul (local.get $px) (local.get $vx)) (f64.mul (local.get $py) (local.get $vy))))
        (local.set $cross (f64.sub (f64.mul (local.get $px) (local.get $vy)) (f64.mul (local.get $py) (local.get $vx))))
        (if (i32.and (i32.and (f64.ge (local.get $dot) (f64.const 0)) (f64.le (local.get $dot) (local.get $limit)))
              (f64.le (f64.mul (local.get $cross) (local.get $cross)) (f64.mul (local.get $r2) (local.get $len2))))
          (then (call $gdi_path_mask_set (local.get $mask) (local.get $mask_w) (local.get $mask_h)
            (local.get $origin_x) (local.get $origin_y) (local.get $x) (local.get $y))))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $cols)))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $rows))))

  (func $gdi_path_widen_cap (param $mask i32) (param $mask_w i32) (param $mask_h i32)
        (param $origin_x i32) (param $origin_y i32) (param $end_x i32) (param $end_y i32)
        (param $neighbor_x i32) (param $neighbor_y i32) (param $width i32) (param $cap i32)
    (if (i32.eq (local.get $cap) (i32.const 0))
      (then (call $gdi_path_widen_disk (local.get $mask) (local.get $mask_w) (local.get $mask_h)
        (local.get $origin_x) (local.get $origin_y) (local.get $end_x) (local.get $end_y) (local.get $width))))
    (if (i32.eq (local.get $cap) (i32.const 0x100))
      (then (call $gdi_path_widen_square_cap (local.get $mask) (local.get $mask_w) (local.get $mask_h)
        (local.get $origin_x) (local.get $origin_y) (local.get $end_x) (local.get $end_y)
        (local.get $neighbor_x) (local.get $neighbor_y) (local.get $width)))))

  (func $gdi_path_widen_triangle (param $mask i32) (param $mask_w i32) (param $mask_h i32)
        (param $origin_x i32) (param $origin_y i32)
        (param $ax f64) (param $ay f64) (param $bx f64) (param $by f64)
        (param $cx f64) (param $cy f64)
    (local $min_x f64) (local $min_y f64) (local $max_x f64) (local $max_y f64)
    (local $x i32) (local $y i32) (local $right i32) (local $bottom i32)
    (local $px f64) (local $py f64) (local $e0 f64) (local $e1 f64) (local $e2 f64)
    (local.set $min_x (local.get $ax)) (local.set $max_x (local.get $ax))
    (local.set $min_y (local.get $ay)) (local.set $max_y (local.get $ay))
    (if (f64.lt (local.get $bx) (local.get $min_x)) (then (local.set $min_x (local.get $bx))))
    (if (f64.lt (local.get $cx) (local.get $min_x)) (then (local.set $min_x (local.get $cx))))
    (if (f64.gt (local.get $bx) (local.get $max_x)) (then (local.set $max_x (local.get $bx))))
    (if (f64.gt (local.get $cx) (local.get $max_x)) (then (local.set $max_x (local.get $cx))))
    (if (f64.lt (local.get $by) (local.get $min_y)) (then (local.set $min_y (local.get $by))))
    (if (f64.lt (local.get $cy) (local.get $min_y)) (then (local.set $min_y (local.get $cy))))
    (if (f64.gt (local.get $by) (local.get $max_y)) (then (local.set $max_y (local.get $by))))
    (if (f64.gt (local.get $cy) (local.get $max_y)) (then (local.set $max_y (local.get $cy))))
    (local.set $x (i32.sub (i32.trunc_sat_f64_s (f64.floor (local.get $min_x))) (i32.const 1)))
    (local.set $y (i32.sub (i32.trunc_sat_f64_s (f64.floor (local.get $min_y))) (i32.const 1)))
    (local.set $right (i32.add (i32.trunc_sat_f64_s (f64.ceil (local.get $max_x))) (i32.const 1)))
    (local.set $bottom (i32.add (i32.trunc_sat_f64_s (f64.ceil (local.get $max_y))) (i32.const 1)))
    (block $rows_done (loop $rows
      (br_if $rows_done (i32.ge_s (local.get $y) (local.get $bottom)))
      (local.set $px (f64.add (f64.convert_i32_s (local.get $x)) (f64.const 0.5)))
      (block $cols_done (loop $cols
        (br_if $cols_done (i32.ge_s (local.get $x) (local.get $right)))
        (local.set $px (f64.add (f64.convert_i32_s (local.get $x)) (f64.const 0.5)))
        (local.set $py (f64.add (f64.convert_i32_s (local.get $y)) (f64.const 0.5)))
        (local.set $e0 (f64.sub (f64.mul (f64.sub (local.get $bx) (local.get $ax)) (f64.sub (local.get $py) (local.get $ay)))
          (f64.mul (f64.sub (local.get $by) (local.get $ay)) (f64.sub (local.get $px) (local.get $ax)))))
        (local.set $e1 (f64.sub (f64.mul (f64.sub (local.get $cx) (local.get $bx)) (f64.sub (local.get $py) (local.get $by)))
          (f64.mul (f64.sub (local.get $cy) (local.get $by)) (f64.sub (local.get $px) (local.get $bx)))))
        (local.set $e2 (f64.sub (f64.mul (f64.sub (local.get $ax) (local.get $cx)) (f64.sub (local.get $py) (local.get $cy)))
          (f64.mul (f64.sub (local.get $ay) (local.get $cy)) (f64.sub (local.get $px) (local.get $cx)))))
        (if (i32.or
              (i32.and (i32.and (f64.ge (local.get $e0) (f64.const 0)) (f64.ge (local.get $e1) (f64.const 0)))
                (f64.ge (local.get $e2) (f64.const 0)))
              (i32.and (i32.and (f64.le (local.get $e0) (f64.const 0)) (f64.le (local.get $e1) (f64.const 0)))
                (f64.le (local.get $e2) (f64.const 0))))
          (then (call $gdi_path_mask_set (local.get $mask) (local.get $mask_w) (local.get $mask_h)
            (local.get $origin_x) (local.get $origin_y) (local.get $x) (local.get $y))))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $cols)))
      (local.set $x (i32.sub (i32.trunc_sat_f64_s (f64.floor (local.get $min_x))) (i32.const 1)))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $rows))))

  ;; Exact outer wedges for bevel and miter joins; miters fall back to bevel at
  ;; the Win32 default ten-width limit. Round joins are the stroke disk.
  (func $gdi_path_widen_join (param $mask i32) (param $mask_w i32) (param $mask_h i32)
        (param $origin_x i32) (param $origin_y i32) (param $ax i32) (param $ay i32)
        (param $bx i32) (param $by i32) (param $cx i32) (param $cy i32)
        (param $width i32) (param $join i32)
    (local $ux f64) (local $uy f64) (local $vx f64) (local $vy f64)
    (local $ulen f64) (local $vlen f64) (local $cross f64) (local $side f64) (local $radius f64)
    (local $q1x f64) (local $q1y f64) (local $q2x f64) (local $q2y f64)
    (local $mx f64) (local $my f64) (local $t f64) (local $dx f64) (local $dy f64)
    (if (i32.eq (local.get $join) (i32.const 0))
      (then (call $gdi_path_widen_disk (local.get $mask) (local.get $mask_w) (local.get $mask_h)
        (local.get $origin_x) (local.get $origin_y) (local.get $bx) (local.get $by) (local.get $width)))
        (return)))
    (local.set $ux (f64.convert_i32_s (i32.sub (local.get $bx) (local.get $ax))))
    (local.set $uy (f64.convert_i32_s (i32.sub (local.get $by) (local.get $ay))))
    (local.set $vx (f64.convert_i32_s (i32.sub (local.get $cx) (local.get $bx))))
    (local.set $vy (f64.convert_i32_s (i32.sub (local.get $cy) (local.get $by))))
    (local.set $ulen (f64.sqrt (f64.add (f64.mul (local.get $ux) (local.get $ux)) (f64.mul (local.get $uy) (local.get $uy)))))
    (local.set $vlen (f64.sqrt (f64.add (f64.mul (local.get $vx) (local.get $vx)) (f64.mul (local.get $vy) (local.get $vy)))))
    (if (i32.or (f64.eq (local.get $ulen) (f64.const 0)) (f64.eq (local.get $vlen) (f64.const 0))) (then (return)))
    (local.set $ux (f64.div (local.get $ux) (local.get $ulen))) (local.set $uy (f64.div (local.get $uy) (local.get $ulen)))
    (local.set $vx (f64.div (local.get $vx) (local.get $vlen))) (local.set $vy (f64.div (local.get $vy) (local.get $vlen)))
    (local.set $cross (f64.sub (f64.mul (local.get $ux) (local.get $vy)) (f64.mul (local.get $uy) (local.get $vx))))
    (if (f64.le (f64.abs (local.get $cross)) (f64.const 0.0000001)) (then (return)))
    (local.set $side (select (f64.const -1) (f64.const 1) (f64.gt (local.get $cross) (f64.const 0))))
    (local.set $radius (f64.mul (f64.convert_i32_u (local.get $width)) (f64.const 0.5)))
    (local.set $q1x (f64.add (f64.convert_i32_s (local.get $bx)) (f64.mul (local.get $side) (f64.mul (f64.neg (local.get $uy)) (local.get $radius)))))
    (local.set $q1y (f64.add (f64.convert_i32_s (local.get $by)) (f64.mul (local.get $side) (f64.mul (local.get $ux) (local.get $radius)))))
    (local.set $q2x (f64.add (f64.convert_i32_s (local.get $bx)) (f64.mul (local.get $side) (f64.mul (f64.neg (local.get $vy)) (local.get $radius)))))
    (local.set $q2y (f64.add (f64.convert_i32_s (local.get $by)) (f64.mul (local.get $side) (f64.mul (local.get $vx) (local.get $radius)))))
    (if (i32.eq (local.get $join) (i32.const 0x2000))
      (then
        (local.set $t (f64.div
          (f64.sub (f64.mul (f64.sub (local.get $q2x) (local.get $q1x)) (local.get $vy))
            (f64.mul (f64.sub (local.get $q2y) (local.get $q1y)) (local.get $vx))) (local.get $cross)))
        (local.set $mx (f64.add (local.get $q1x) (f64.mul (local.get $t) (local.get $ux))))
        (local.set $my (f64.add (local.get $q1y) (f64.mul (local.get $t) (local.get $uy))))
        (local.set $dx (f64.sub (local.get $mx) (f64.convert_i32_s (local.get $bx))))
        (local.set $dy (f64.sub (local.get $my) (f64.convert_i32_s (local.get $by))))
        (if (f64.gt
              (f64.add (f64.mul (local.get $dx) (local.get $dx))
                (f64.mul (local.get $dy) (local.get $dy)))
              (f64.mul (f64.mul (local.get $radius) (local.get $radius)) (f64.const 100)))
          (then (local.set $join (i32.const 0x1000))))))
    (if (i32.eq (local.get $join) (i32.const 0x2000))
      (then
        (call $gdi_path_widen_triangle (local.get $mask) (local.get $mask_w) (local.get $mask_h)
          (local.get $origin_x) (local.get $origin_y) (local.get $q1x) (local.get $q1y)
          (local.get $mx) (local.get $my) (local.get $q2x) (local.get $q2y))
        ;; The two half-width projections cover integer boundary pixels on the
        ;; incident edges that the real-valued miter triangle merely touches.
        (call $gdi_path_widen_square_cap (local.get $mask) (local.get $mask_w) (local.get $mask_h)
          (local.get $origin_x) (local.get $origin_y) (local.get $bx) (local.get $by)
          (local.get $ax) (local.get $ay) (local.get $width))
        (call $gdi_path_widen_square_cap (local.get $mask) (local.get $mask_w) (local.get $mask_h)
          (local.get $origin_x) (local.get $origin_y) (local.get $bx) (local.get $by)
          (local.get $cx) (local.get $cy) (local.get $width)))
      (else (call $gdi_path_widen_triangle (local.get $mask) (local.get $mask_w) (local.get $mask_h)
        (local.get $origin_x) (local.get $origin_y) (local.get $q1x) (local.get $q1y)
        (f64.convert_i32_s (local.get $bx)) (f64.convert_i32_s (local.get $by))
        (local.get $q2x) (local.get $q2y)))))

  (func $gdi_dc_path_widen (param $hdc i32) (result i32)
    (local $entry i32) (local $pen i32) (local $pen_record i32) (local $width i32)
    (local $pen_flags i32) (local $geometric i32) (local $cap i32) (local $join i32)
    (local $flat_g i32) (local $flat i32) (local $count i32) (local $i i32)
    (local $point i32) (local $type i32) (local $kind i32)
    (local $x i32) (local $y i32) (local $from_x i32) (local $from_y i32)
    (local $start_x i32) (local $start_y i32) (local $has_current i32)
    (local $second_x i32) (local $second_y i32) (local $previous_x i32) (local $previous_y i32)
    (local $segment_count i32) (local $margin i32)
    (local $min_x i32) (local $min_y i32) (local $max_x i32) (local $max_y i32)
    (local $half i32) (local $far i32) (local $mask_w i32) (local $mask_h i32)
    (local $mask_size i64) (local $mask_g i32) (local $mask i32)
    (local $bands_g i32) (local $bands i32) (local $row_g i32) (local $row i32)
    (local $band_cap i32) (local $row_cap i32)
    (local $row_count i32) (local $band_count i32) (local $prev_start i32)
    (local $prev_count i32) (local $same i32) (local $run_start i32) (local $j i32)
    (local $band i32) (local $run i32) (local $new_g i32) (local $new i32)
    (local $out i32) (local $old_g i32) (local $old_region i32) (local $ok i32)
    (local.set $entry (call $gdi_dc_path_entry (local.get $hdc) (i32.const 0)))
    (if (i32.or (i32.eqz (local.get $entry))
          (i32.ne (i32.load offset=8 (local.get $entry)) (i32.const 2)))
      (then (return (i32.const 0))))
    (local.set $pen (call $gdi_dc_get_field
      (local.get $hdc) (i32.const 4) (i32.const 0x30017)))
    (local.set $pen_record (call $gdi_object_record (local.get $pen)))
    (if (i32.or (i32.eqz (local.get $pen_record))
          (i32.or (i32.ne (i32.load offset=4 (local.get $pen_record)) (i32.const 1))
            (i32.ne (i32.and (i32.load offset=20 (local.get $pen_record)) (i32.const 1))
              (i32.const 0))))
      (then (return (i32.const 0))))
    (local.set $width (call $gdi_object_width (local.get $pen)))
    (local.set $pen_flags (i32.load offset=20 (local.get $pen_record)))
    (local.set $geometric (i32.and (local.get $pen_flags) (i32.const 0x00010000)))
    (local.set $cap (i32.and (local.get $pen_flags) (i32.const 0x00000F00)))
    (local.set $join (i32.and (local.get $pen_flags) (i32.const 0x0000F000)))
    (if (i32.or (i32.gt_u (local.get $width) (i32.const 64))
          (i32.and (i32.le_u (local.get $width) (i32.const 1))
            (i32.eqz (i32.and (i32.load offset=20 (local.get $pen_record))
              (i32.const 0x00010000)))))
      (then (return (i32.const 0))))
    (local.set $flat_g (call $gdi_dc_path_flatten_copy (local.get $entry)))
    (if (i32.eqz (local.get $flat_g)) (then (return (i32.const 0))))
    (local.set $flat (call $g2w (local.get $flat_g)))
    (local.set $count (i32.load (local.get $flat)))
    (local.set $half (i32.shr_u (local.get $width) (i32.const 1)))
    (local.set $far (i32.sub (local.get $width) (local.get $half)))
    (local.set $margin (local.get $far))
    (if (local.get $geometric)
      (then (local.set $margin (i32.add (local.get $width) (i32.const 1)))))
    (if (i32.eq (local.get $join) (i32.const 0x2000))
      (then (local.set $margin (i32.add (i32.mul (local.get $width) (i32.const 5)) (i32.const 1)))))
    (local.set $min_x (i32.const 0x7FFFFFFF))
    (local.set $min_y (i32.const 0x7FFFFFFF))
    (local.set $max_x (i32.const 0x80000000))
    (local.set $max_y (i32.const 0x80000000))
    (block $bounds_done (loop $bounds
      (br_if $bounds_done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $point (i32.add (i32.add (local.get $flat) (i32.const 16))
        (i32.mul (local.get $i) (i32.const 12))))
      (local.set $x (i32.load (local.get $point)))
      (local.set $y (i32.load offset=4 (local.get $point)))
      (if (i32.or (i32.or (i32.lt_s (local.get $x) (i32.const -1000000000))
            (i32.gt_s (local.get $x) (i32.const 1000000000)))
          (i32.or (i32.lt_s (local.get $y) (i32.const -1000000000))
            (i32.gt_s (local.get $y) (i32.const 1000000000))))
        (then (br $bounds_done)))
      (if (i32.lt_s (i32.sub (local.get $x) (local.get $margin)) (local.get $min_x))
        (then (local.set $min_x (i32.sub (local.get $x) (local.get $margin)))))
      (if (i32.lt_s (i32.sub (local.get $y) (local.get $margin)) (local.get $min_y))
