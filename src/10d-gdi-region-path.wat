            (i32.wrap_i64 (i64.sub (local.get $cy) (local.get $r)))
            (i32.wrap_i64 (i64.add (local.get $cx) (local.get $r)))
            (i32.wrap_i64 (i64.add (local.get $cy) (local.get $r)))
