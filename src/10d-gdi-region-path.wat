          (f64.mul (f64.sub (local.get $y1) (local.get $y0)) (f64.sub (local.get $y1) (local.get $y0)))))
        (local.set $d2 (f64.add
          (f64.mul (f64.sub (local.get $x2) (local.get $x0)) (f64.sub (local.get $x2) (local.get $x0)))
          (f64.mul (f64.sub (local.get $y2) (local.get $y0)) (f64.sub (local.get $y2) (local.get $y0)))))
        (i32.and (f64.le (local.get $d1) (f64.const 0.25))
          (f64.le (local.get $d2) (f64.const 0.25))))
      (else
        (local.set $c1 (f64.sub
          (f64.mul (f64.sub (local.get $x1) (local.get $x0)) (local.get $dy))
          (f64.mul (f64.sub (local.get $y1) (local.get $y0)) (local.get $dx))))
        (local.set $c2 (f64.sub
          (f64.mul (f64.sub (local.get $x2) (local.get $x0)) (local.get $dy))
          (f64.mul (f64.sub (local.get $y2) (local.get $y0)) (local.get $dx))))
        (i32.and
          (f64.le (f64.mul (local.get $c1) (local.get $c1))
            (f64.mul (f64.const 0.25) (local.get $len2)))
          (f64.le (f64.mul (local.get $c2) (local.get $c2))
            (f64.mul (f64.const 0.25) (local.get $len2)))))))

  (func $gdi_bezier_leaf_count
