      (then
        (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
              (call $gdi_path_scale_arc (local.get $left) (local.get $right) (local.get $x0))
              (call $gdi_path_scale_arc (local.get $top) (local.get $bottom) (local.get $y0))
              (local.get $start_type)))
