    (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
          (call $gdi_dc_clip_map_x (local.get $hdc) (local.get $x))
          (call $gdi_dc_clip_map_y (local.get $hdc) (local.get $y))
          (i32.const 2)))
