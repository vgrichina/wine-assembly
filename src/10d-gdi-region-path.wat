      (br_if $done (local.get $last_part))
      (if (i32.ge_u (local.get $parts) (i32.const 5)) (then (return (i32.const 0))))
      (local.set $part_start (local.get $part_end))
      (local.set $first (i32.const 0))
      (br $parts_loop)))
