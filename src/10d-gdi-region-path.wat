    (local.set $y01 (f64.mul (f64.add (local.get $y0) (local.get $y1)) (f64.const 0.5)))
    (local.set $x12 (f64.mul (f64.add (local.get $x1) (local.get $x2)) (f64.const 0.5)))
    (local.set $y12 (f64.mul (f64.add (local.get $y1) (local.get $y2)) (f64.const 0.5)))
    (local.set $x23 (f64.mul (f64.add (local.get $x2) (local.get $x3)) (f64.const 0.5)))
    (local.set $y23 (f64.mul (f64.add (local.get $y2) (local.get $y3)) (f64.const 0.5)))
    (local.set $x012 (f64.mul (f64.add (local.get $x01) (local.get $x12)) (f64.const 0.5)))
    (local.set $y012 (f64.mul (f64.add (local.get $y01) (local.get $y12)) (f64.const 0.5)))
    (local.set $x123 (f64.mul (f64.add (local.get $x12) (local.get $x23)) (f64.const 0.5)))
    (local.set $y123 (f64.mul (f64.add (local.get $y12) (local.get $y23)) (f64.const 0.5)))
    (local.set $xm (f64.mul (f64.add (local.get $x012) (local.get $x123)) (f64.const 0.5)))
    (local.set $ym (f64.mul (f64.add (local.get $y012) (local.get $y123)) (f64.const 0.5)))
    (local.set $next (call $gdi_bezier_emit (local.get $target) (local.get $out)
