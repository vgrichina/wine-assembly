      (call $gdi_path_round_positive
        (f64.mul
          (f64.mul (f64.convert_i32_s (i32.sub (local.get $maximum) (local.get $minimum)))
            (f64.const 0.5))
          (f64.add (local.get $normalized) (f64.const 1))))))

  (func $gdi_dc_path_append_arc_part (param $entry i32)
        (param $left i32) (param $top i32) (param $right i32) (param $bottom i32)
        (param $angle_start f64) (param $angle_end f64) (param $start_type i32) (result i32)
    (local $half f64) (local $factor f64)
    (local $x0 f64) (local $y0 f64) (local $x1 f64) (local $y1 f64)
    (local $x2 f64) (local $y2 f64) (local $x3 f64) (local $y3 f64)
