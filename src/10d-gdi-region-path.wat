    (i32.store offset=84 (local.get $points) (local.get $y1))
    (i32.store offset=88 (local.get $points) (i32.add (local.get $x0) (local.get $half_x)))
    (i32.store offset=92 (local.get $points) (local.get $y1))
    (i32.store offset=96 (local.get $points) (i32.sub (local.get $x1) (local.get $half_x)))
