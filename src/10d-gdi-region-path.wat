    (i32.store offset=32 (local.get $points) (i32.add (local.get $x0) (local.get $half_x)))
    (i32.store offset=36 (local.get $points) (local.get $y0))
    (i32.store offset=40 (local.get $points) (i32.add (local.get $x0) (local.get $control_x)))
    (i32.store offset=44 (local.get $points) (local.get $y0))
    (i32.store offset=48 (local.get $points) (local.get $x0))
    (i32.store offset=52 (local.get $points) (i32.add (local.get $y0) (local.get $control_y)))
    (i32.store offset=56 (local.get $points) (local.get $x0))
    (i32.store offset=60 (local.get $points) (i32.add (local.get $y0) (local.get $half_y)))
    (i32.store offset=64 (local.get $points) (local.get $x0))
    (i32.store offset=68 (local.get $points) (i32.sub (local.get $y1) (local.get $half_y)))
