      (f64.sub (local.get $angle_end) (local.get $angle_start)) (f64.const 2)))
    (if (f64.gt (f64.abs (local.get $half)) (f64.const 0.00000001))
      (then (local.set $factor (f64.div
        (f64.mul (f64.const 1.3333333333333333)
          (f64.sub (f64.const 1) (call $host_math_cos (local.get $half))))
        (call $host_math_sin (local.get $half))))))
