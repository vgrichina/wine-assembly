    (local.set $y1 (f64.add (local.get $y0) (f64.mul (local.get $factor) (local.get $x0))))
    (local.set $x3 (call $host_math_cos (local.get $angle_end)))
    (local.set $y3 (call $host_math_sin (local.get $angle_end)))
    (local.set $x2 (f64.add (local.get $x3) (f64.mul (local.get $factor) (local.get $y3))))
    (local.set $y2 (f64.sub (local.get $y3) (f64.mul (local.get $factor) (local.get $x3))))
