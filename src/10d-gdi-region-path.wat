          (then
            (if (i32.eqz (call $gdi_dc_path_append_device (local.get $entry)
                  (call $gdi_dc_clip_map_x (local.get $hdc)
                    (call $gdi_dc_get_field (local.get $hdc) (i32.const 12) (i32.const 0)))
                  (call $gdi_dc_clip_map_y (local.get $hdc)
                    (call $gdi_dc_get_field (local.get $hdc) (i32.const 16) (i32.const 0)))
                  (i32.const 6)))
              (then (return (i32.const 0))))))))
    (local.set $nx (f64.sub
      (f64.mul (f64.div (f64.convert_i32_s (i32.sub (local.get $sx) (local.get $x0)))
        (f64.convert_i32_s (i32.sub (local.get $x1) (local.get $x0)))) (f64.const 2))
      (f64.const 1)))
    (local.set $ny (f64.sub
      (f64.mul (f64.div (f64.convert_i32_s (i32.sub (local.get $sy) (local.get $y0)))
        (f64.convert_i32_s (i32.sub (local.get $y1) (local.get $y0)))) (f64.const 2))
      (f64.const 1)))
    (local.set $angle_start (call $host_math_atan2 (local.get $ny) (local.get $nx)))
    (local.set $nx (f64.sub
      (f64.mul (f64.div (f64.convert_i32_s (i32.sub (local.get $ex) (local.get $x0)))
        (f64.convert_i32_s (i32.sub (local.get $x1) (local.get $x0)))) (f64.const 2))
      (f64.const 1)))
    (local.set $ny (f64.sub
      (f64.mul (f64.div (f64.convert_i32_s (i32.sub (local.get $ey) (local.get $y0)))
        (f64.convert_i32_s (i32.sub (local.get $y1) (local.get $y0)))) (f64.const 2))
      (f64.const 1)))
    (local.set $angle_end (call $host_math_atan2 (local.get $ny) (local.get $nx)))
    (local.set $direction (call $gdi_dc_aux_get (local.get $hdc) (i32.const 4) (i32.const 1)))
    (if (i32.eq (local.get $direction) (i32.const 2))
      (then
        (if (f64.le (local.get $angle_end) (local.get $angle_start))
          (then (local.set $angle_end (f64.add (local.get $angle_end)
            (f64.const 6.283185307179586))))))
      (else
        (if (f64.ge (local.get $angle_end) (local.get $angle_start))
          (then (local.set $angle_end (f64.sub (local.get $angle_end)
            (f64.const 6.283185307179586)))))))
    (local.set $first (i32.const 1))
    (local.set $part_start (local.get $angle_start))
