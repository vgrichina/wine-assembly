  (func (export "test_sscanf") (param $src i32) (param $fmt i32) (param $va i32) (result i32)
    (call $sscanf_impl (local.get $src) (local.get $fmt) (local.get $va)))

  ;; Dynamic menus — exercised by test/test-menu-insert.js. The read-backs
