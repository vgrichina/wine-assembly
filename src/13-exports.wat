  ;; Direct test surface for the memory-backed OLE storage foundation. These
  ;; helpers intentionally bypass stdcall ESP bookkeeping while exercising the
  ;; same object/state helpers used by the public OLE32 and COM handlers.
  (func (export "test_ole_create_lockbytes") (param $hglobal i32) (param $delete_on_release i32) (result i32)
    (call $ole_create_lockbytes (local.get $hglobal) (local.get $delete_on_release)))
  (func (export "test_ole_create_storage") (param $lockbytes i32) (result i32)
    (call $ole_create_storage (local.get $lockbytes)))
  (func (export "test_ole_create_child_storage") (param $storage i32) (param $name i32) (result i32)
    (if (result i32) (i32.or
          (call $ole_storage_find_stream (local.get $storage) (local.get $name))
          (call $ole_storage_find_storage (local.get $storage) (local.get $name)))
      (then (i32.const 0))
      (else (call $ole_create_child_storage (local.get $storage) (local.get $name)))))
  (func (export "test_ole_find_storage") (param $storage i32) (param $name i32) (result i32)
    (local $child i32)
    (local.set $child (call $ole_storage_find_storage (local.get $storage) (local.get $name)))
    (if (local.get $child) (then (drop (call $ole_obj_addref (local.get $child)))))
    (local.get $child))
