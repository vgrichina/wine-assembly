    (call $set_reg16 (local.get $dst) (i32.or (local.get $val) (i32.shl (i32.const 1) (local.get $bit))))
    (return_call $next))
  (func $th_btr_r16_r16 (param $op i32)
    (local $dst i32) (local $bit i32) (local $val i32)
    (local.set $dst (i32.shr_u (local.get $op) (i32.const 4)))
    (local.set $bit (i32.and (call $get_reg (i32.and (local.get $op) (i32.const 0xF))) (i32.const 15)))
    (local.set $val (i32.and (call $get_reg (local.get $dst)) (i32.const 0xFFFF)))
