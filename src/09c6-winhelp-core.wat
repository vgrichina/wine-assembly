    (i32.store offset=224 (local.get $p) (global.get $help_doc_cnt_base_wa))
    (i32.store offset=228 (local.get $p) (global.get $help_doc_cnt_base_len))
    (i32.store offset=232 (local.get $p) (global.get $help_doc_system_minor))
