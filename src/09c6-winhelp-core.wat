    (i32.store offset=72 (local.get $p) (global.get $help_doc_maps_ga))
    (i32.store offset=76 (local.get $p) (global.get $help_doc_maps_wa))
    (i32.store offset=80 (local.get $p) (global.get $help_doc_map_count))
    (i32.store offset=84 (local.get $p) (global.get $help_doc_phrase_offsets_ga))
    (i32.store offset=88 (local.get $p) (global.get $help_doc_phrase_offsets_wa))
    (i32.store offset=92 (local.get $p) (global.get $help_doc_phrase_image_ga))
    (i32.store offset=96 (local.get $p) (global.get $help_doc_phrase_image_wa))
    (i32.store offset=100 (local.get $p) (global.get $help_doc_phrase_count))
    (i32.store offset=104 (local.get $p) (global.get $help_doc_phrase_image_size))
    (i32.store offset=108 (local.get $p) (global.get $help_doc_phrase_mode))
