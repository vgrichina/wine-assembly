    (i32.store offset=256 (local.get $p) (global.get $help_doc_contents_ref))
    (i32.store offset=260 (local.get $p) (global.get $help_doc_cnt_off))
    (i32.store offset=264 (local.get $p) (global.get $help_doc_cnt_len))
    (i32.store offset=268 (local.get $p) (global.get $help_session_owner))
    (i32.store offset=272 (local.get $p) (global.get $help_session_topic_ref))
    (i32.store offset=276 (local.get $p) (global.get $help_session_topic_index))
    (i32.store offset=280 (local.get $p) (global.get $help_session_contents_override))
    (i32.store offset=284 (local.get $p) (global.get $help_session_mode))
    (i32.store offset=288 (local.get $p) (global.get $help_session_keyword_index))
    (i32.store offset=292 (local.get $p) (global.get $help_session_last_command))
    (i32.store offset=296 (local.get $p) (global.get $help_session_status))
    (i32.store offset=300 (local.get $p) (global.get $help_topics_contents_selection))
    (i32.store offset=304 (local.get $p) (global.get $help_topics_first_visible))
    (i32.store offset=308 (local.get $p) (global.get $help_topics_return_mode))
    (i32.store offset=312 (local.get $p) (global.get $help_cur_topic))
    (i32.store offset=316 (local.get $p) (global.get $help_scroll_y))
    (i32.store offset=320 (local.get $p) (global.get $help_back_count))
    (i32.store offset=324 (local.get $p) (global.get $help_session_window_index))
    (i32.store offset=328 (local.get $p) (global.get $help_last_error))
    (i32.store offset=332 (local.get $p) (global.get $help_last_error_offset))
    (if (global.get $help_back_stack)
      (then
        (memory.copy (i32.add (local.get $p) (i32.const 336))
          (global.get $help_back_stack) (i32.const 64))))
    (i32.store offset=400 (local.get $p) (global.get $help_doc_windows_ga))
    (i32.store offset=404 (local.get $p) (global.get $help_doc_windows_wa))
    (i32.store offset=408 (local.get $p) (global.get $help_doc_window_count))
    ;; Prevent release_storage from freeing the detached owned roots.
    (global.set $help_doc_path_ga (i32.const 0))
    (global.set $help_doc_file_ga (i32.const 0))
    (global.set $help_doc_meta_ga (i32.const 0))
    (global.set $help_doc_directory_ga (i32.const 0))
    (global.set $help_doc_topics_ga (i32.const 0))
    (global.set $help_doc_contexts_ga (i32.const 0))
    (global.set $help_doc_maps_ga (i32.const 0))
    (global.set $help_doc_phrase_offsets_ga (i32.const 0))
    (global.set $help_doc_phrase_image_ga (i32.const 0))
    (global.set $help_doc_font_faces_ga (i32.const 0))
    (global.set $help_doc_fonts_ga (i32.const 0))
