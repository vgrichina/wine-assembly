  (func $help_document_snapshot_release_record (param $snapshot_ga i32)
    (local $p i32) (local $owned i32)
    (if (i32.eqz (local.get $snapshot_ga)) (then (return)))
    (local.set $p (call $g2w (local.get $snapshot_ga)))
    (local.set $owned (i32.load offset=4 (local.get $p)))
    (if (local.get $owned) (then (call $heap_free (local.get $owned))))
    (local.set $owned (i32.load offset=16 (local.get $p)))
    (if (local.get $owned) (then (call $heap_free (local.get $owned))))
    (local.set $owned (i32.load offset=28 (local.get $p)))
    (if (local.get $owned) (then (call $heap_free (local.get $owned))))
    (local.set $owned (i32.load offset=36 (local.get $p)))
    (if (local.get $owned) (then (call $heap_free (local.get $owned))))
    (local.set $owned (i32.load offset=48 (local.get $p)))
