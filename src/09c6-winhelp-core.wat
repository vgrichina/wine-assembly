    (local.set $owned (i32.load offset=156 (local.get $p)))
    (if (local.get $owned) (then (call $heap_free (local.get $owned))))
    (local.set $owned (i32.load offset=168 (local.get $p)))
    (if (local.get $owned) (then (call $heap_free (local.get $owned))))
    (local.set $owned (i32.load offset=180 (local.get $p)))
    (if (local.get $owned) (then (call $heap_free (local.get $owned))))
    (local.set $owned (i32.load offset=192 (local.get $p)))
