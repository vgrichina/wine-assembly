  ;; ---- Runtime TrueType instruction engine -----------------------------
  ;;
  ;; This is a direct WAT implementation of the TrueType instruction model
  ;; documented by Apple and Microsoft.  It deliberately has no generated
  ;; source and no host-side execution path: fpgm, prep, and glyph programs
  ;; all execute in this module against bounded emulator-owned state.
  ;;
  ;; The interpreter keeps eight ppem contexts.  A context owns the scaled
  ;; CVT, storage, fpgm definitions, twilight points, and the graphics-state
  ;; template produced by prep.  Glyph points and the operand/call stacks use
  ;; one transient arena because a WebAssembly instance executes only one WAT
  ;; call at a time (worker instances have independent memories/globals).

  (global $TTH_SIZE_SLOTS i32 (i32.const 8))
  (global $TTH_SIZE_STRIDE i32 (i32.const 0x2000))
  (global $TTH_MAX_POINTS i32 (i32.const 512))
  (global $TTH_MAX_TWILIGHT i32 (i32.const 64))
  (global $TTH_MAX_STACK i32 (i32.const 2048))
  (global $TTH_MAX_STORAGE i32 (i32.const 256))
  (global $TTH_MAX_CVT i32 (i32.const 1024))
  (global $TTH_MAX_FUNCTIONS i32 (i32.const 96))
  (global $TTH_MAX_CALLS i32 (i32.const 32))
  (global $TTH_MAX_STEPS i32 (i32.const 100000))
  (global $TTH_POINT_STRIDE i32 (i32.const 20))
  (global $TTH_ARENA_BYTES i32 (i32.const 0x6000))

  ;; Size-context offsets.  The 0x100-aligned arrays leave the graphics state
  ;; readable in a debugger while keeping index arithmetic cheap.
  (global $TTH_SC_DATA i32 (i32.const 0))
  (global $TTH_SC_SIZE i32 (i32.const 4))
  (global $TTH_SC_PPEM i32 (i32.const 8))
  (global $TTH_SC_STATUS i32 (i32.const 12)) ;; 1 ready, -1 unusable
  (global $TTH_SC_CVT_COUNT i32 (i32.const 16))
  (global $TTH_SC_STORAGE_COUNT i32 (i32.const 20))
  (global $TTH_SC_FUNCTION_LIMIT i32 (i32.const 24))
  (global $TTH_SC_TWILIGHT_COUNT i32 (i32.const 28))
  (global $TTH_SC_SCAN_CONTROL i32 (i32.const 32))
  (global $TTH_SC_SCAN_TYPE i32 (i32.const 36))
  (global $TTH_SC_INST_CONTROL i32 (i32.const 40))
  (global $TTH_SC_GS i32 (i32.const 0x40))
  (global $TTH_SC_CVT i32 (i32.const 0x100))
  (global $TTH_SC_STORAGE i32 (i32.const 0x1100))
  (global $TTH_SC_FUNCTIONS i32 (i32.const 0x1500))
  (global $TTH_SC_TWILIGHT i32 (i32.const 0x1800))

  ;; Graphics-state offsets, relative to TTH_SC_GS.
  (global $TTH_GS_RP0 i32 (i32.const 0))
  (global $TTH_GS_RP1 i32 (i32.const 4))
  (global $TTH_GS_RP2 i32 (i32.const 8))
  (global $TTH_GS_ZP0 i32 (i32.const 12))
  (global $TTH_GS_ZP1 i32 (i32.const 16))
  (global $TTH_GS_ZP2 i32 (i32.const 20))
  (global $TTH_GS_LOOP i32 (i32.const 24))
  (global $TTH_GS_MIN_DIST i32 (i32.const 28))
  (global $TTH_GS_CVT_CUT i32 (i32.const 32))
  (global $TTH_GS_SW_CUT i32 (i32.const 36))
  (global $TTH_GS_SW_VALUE i32 (i32.const 40))
  (global $TTH_GS_AUTO_FLIP i32 (i32.const 44))
  (global $TTH_GS_DELTA_BASE i32 (i32.const 48))
  (global $TTH_GS_DELTA_SHIFT i32 (i32.const 52))
  (global $TTH_GS_PVX i32 (i32.const 56))
  (global $TTH_GS_PVY i32 (i32.const 60))
  (global $TTH_GS_FVX i32 (i32.const 64))
  (global $TTH_GS_FVY i32 (i32.const 68))
  (global $TTH_GS_DVX i32 (i32.const 72))
  (global $TTH_GS_DVY i32 (i32.const 76))
  (global $TTH_GS_ROUND_PERIOD i32 (i32.const 80))
  (global $TTH_GS_ROUND_PHASE i32 (i32.const 84))
  (global $TTH_GS_ROUND_THRESHOLD i32 (i32.const 88))
  (global $TTH_GS_ROUND_45 i32 (i32.const 92))
  (global $TTH_GS_BYTES i32 (i32.const 96))

  ;; Point flags at record+16.
  (global $TTH_P_ON_CURVE i32 (i32.const 1))
  (global $TTH_P_END i32 (i32.const 2))
  (global $TTH_P_TOUCH_X i32 (i32.const 4))
  (global $TTH_P_TOUCH_Y i32 (i32.const 8))

  (global $tth_sizes_guest (mut i32) (i32.const 0))
  (global $tth_arena_guest (mut i32) (i32.const 0))
  (global $tth_next_size_slot (mut i32) (i32.const 0))

  ;; Active execution context.  This is saved back into the selected size
  ;; record after prep and after each glyph program.
  (global $tth_sc (mut i32) (i32.const 0))
  (global $tth_program (mut i32) (i32.const 0))
  (global $tth_program_len (mut i32) (i32.const 0))
  (global $tth_pc (mut i32) (i32.const 0))
  (global $tth_opcode (mut i32) (i32.const 0))
  (global $tth_steps (mut i32) (i32.const 0))
  (global $tth_error (mut i32) (i32.const 0))
  (global $tth_phase (mut i32) (i32.const 0)) ;; 0=fpgm, 1=prep, 2=glyph
  (global $tth_stack (mut i32) (i32.const 0))
  (global $tth_stack_top (mut i32) (i32.const 0))
  (global $tth_calls (mut i32) (i32.const 0))
  (global $tth_temp (mut i32) (i32.const 0))
  (global $tth_call_top (mut i32) (i32.const 0))
  (global $tth_points (mut i32) (i32.const 0))
  (global $tth_point_count (mut i32) (i32.const 0))
  (global $tth_real_count (mut i32) (i32.const 0))
  (global $tth_ppem (mut i32) (i32.const 0))
  (global $tth_upem (mut i32) (i32.const 0))
  (global $tth_glyph_advance (mut i32) (i32.const 0))
  (global $tth_scan_control (mut i32) (i32.const 0))
  (global $tth_scan_type (mut i32) (i32.const 0))
  (global $tth_inst_control (mut i32) (i32.const 0))
  (global $tth_fault_arg (mut i32) (i32.const 0))
  (global $tth_bound_data (mut i32) (i32.const 0))
  (global $tth_bound_size (mut i32) (i32.const 0))
  (global $tth_bound_gid (mut i32) (i32.const -1))
  (global $tth_bound_ppem (mut i32) (i32.const 0))
  (global $tth_bound_status (mut i32) (i32.const 0))
  (global $tth_bound_left (mut i32) (i32.const 0))
  (global $tth_bound_top (mut i32) (i32.const 0))
  (global $tth_bound_right (mut i32) (i32.const 0))
  (global $tth_bound_bottom (mut i32) (i32.const 0))
  (global $tth_compound_depth (mut i32) (i32.const 0))

  ;; Graphics state in globals keeps hot point instructions from repeatedly
  ;; indexing a memory record.  `$tth_gs_load/save` is the lifetime boundary.
  (global $tth_rp0 (mut i32) (i32.const 0))
  (global $tth_rp1 (mut i32) (i32.const 0))
  (global $tth_rp2 (mut i32) (i32.const 0))
  (global $tth_zp0 (mut i32) (i32.const 1))
  (global $tth_zp1 (mut i32) (i32.const 1))
  (global $tth_zp2 (mut i32) (i32.const 1))
  (global $tth_loop (mut i32) (i32.const 1))
  (global $tth_min_dist (mut i32) (i32.const 64))
  (global $tth_cvt_cut (mut i32) (i32.const 68))
  (global $tth_sw_cut (mut i32) (i32.const 0))
  (global $tth_sw_value (mut i32) (i32.const 0))
  (global $tth_auto_flip (mut i32) (i32.const 1))
  (global $tth_delta_base (mut i32) (i32.const 9))
  (global $tth_delta_shift (mut i32) (i32.const 3))
  (global $tth_pvx (mut i32) (i32.const 0x4000))
  (global $tth_pvy (mut i32) (i32.const 0))
  (global $tth_fvx (mut i32) (i32.const 0x4000))
  (global $tth_fvy (mut i32) (i32.const 0))
  (global $tth_dvx (mut i32) (i32.const 0x4000))
  (global $tth_dvy (mut i32) (i32.const 0))
  (global $tth_round_period (mut i32) (i32.const 64))
  (global $tth_round_phase (mut i32) (i32.const 0))
  (global $tth_round_threshold (mut i32) (i32.const 32))
  (global $tth_round_45 (mut i32) (i32.const 0))

  (func $tth_min (param $a i32) (param $b i32) (result i32)
    (select (local.get $a) (local.get $b)
      (i32.lt_s (local.get $a) (local.get $b))))

  (func $tth_abs (param $a i32) (result i32)
    (select (i32.sub (i32.const 0) (local.get $a)) (local.get $a)
      (i32.lt_s (local.get $a) (i32.const 0))))

  (func $tth_clamp_declared (param $value i32) (param $hard i32) (result i32)
    (if (i32.le_s (local.get $value) (i32.const 0))
      (then (return (i32.const 0))))
    (call $tth_min (local.get $value) (local.get $hard)))

  (func $tth_alloc_roots (result i32)
    (local $guest i32)
    (if (i32.eqz (global.get $tth_sizes_guest))
      (then
        (local.set $guest (call $heap_alloc
          (i32.mul (global.get $TTH_SIZE_SLOTS)
            (global.get $TTH_SIZE_STRIDE))))
        (if (i32.eqz (local.get $guest))
          (then (return (i32.const 0))))
        (global.set $tth_sizes_guest (local.get $guest))
        (memory.fill (call $g2w (local.get $guest)) (i32.const 0)
          (i32.mul (global.get $TTH_SIZE_SLOTS)
            (global.get $TTH_SIZE_STRIDE)))))
    (if (i32.eqz (global.get $tth_arena_guest))
      (then
        (local.set $guest (call $heap_alloc (global.get $TTH_ARENA_BYTES)))
        (if (i32.eqz (local.get $guest))
          (then (return (i32.const 0))))
        (global.set $tth_arena_guest (local.get $guest))))
    (i32.const 1))

  (func $tth_gs_defaults
    (global.set $tth_rp0 (i32.const 0))
    (global.set $tth_rp1 (i32.const 0))
    (global.set $tth_rp2 (i32.const 0))
    (global.set $tth_zp0 (i32.const 1))
    (global.set $tth_zp1 (i32.const 1))
    (global.set $tth_zp2 (i32.const 1))
    (global.set $tth_loop (i32.const 1))
    (global.set $tth_min_dist (i32.const 64))
    (global.set $tth_cvt_cut (i32.const 68))
    (global.set $tth_sw_cut (i32.const 0))
    (global.set $tth_sw_value (i32.const 0))
    (global.set $tth_auto_flip (i32.const 1))
    (global.set $tth_delta_base (i32.const 9))
    (global.set $tth_delta_shift (i32.const 3))
    (global.set $tth_pvx (i32.const 0x4000))
    (global.set $tth_pvy (i32.const 0))
    (global.set $tth_fvx (i32.const 0x4000))
    (global.set $tth_fvy (i32.const 0))
    (global.set $tth_dvx (i32.const 0x4000))
    (global.set $tth_dvy (i32.const 0))
    (global.set $tth_round_period (i32.const 64))
    (global.set $tth_round_phase (i32.const 0))
    (global.set $tth_round_threshold (i32.const 32))
    (global.set $tth_round_45 (i32.const 0)))

  (func $tth_gs_load (param $base i32)
    (local $gs i32)
    (local.set $gs (i32.add (local.get $base) (global.get $TTH_SC_GS)))
    (global.set $tth_rp0 (i32.load offset=0 (local.get $gs)))
    (global.set $tth_rp1 (i32.load offset=4 (local.get $gs)))
    (global.set $tth_rp2 (i32.load offset=8 (local.get $gs)))
    (global.set $tth_zp0 (i32.load offset=12 (local.get $gs)))
    (global.set $tth_zp1 (i32.load offset=16 (local.get $gs)))
    (global.set $tth_zp2 (i32.load offset=20 (local.get $gs)))
    (global.set $tth_loop (i32.load offset=24 (local.get $gs)))
    (global.set $tth_min_dist (i32.load offset=28 (local.get $gs)))
    (global.set $tth_cvt_cut (i32.load offset=32 (local.get $gs)))
    (global.set $tth_sw_cut (i32.load offset=36 (local.get $gs)))
    (global.set $tth_sw_value (i32.load offset=40 (local.get $gs)))
    (global.set $tth_auto_flip (i32.load offset=44 (local.get $gs)))
    (global.set $tth_delta_base (i32.load offset=48 (local.get $gs)))
    (global.set $tth_delta_shift (i32.load offset=52 (local.get $gs)))
    (global.set $tth_pvx (i32.load offset=56 (local.get $gs)))
    (global.set $tth_pvy (i32.load offset=60 (local.get $gs)))
    (global.set $tth_fvx (i32.load offset=64 (local.get $gs)))
    (global.set $tth_fvy (i32.load offset=68 (local.get $gs)))
    (global.set $tth_dvx (i32.load offset=72 (local.get $gs)))
    (global.set $tth_dvy (i32.load offset=76 (local.get $gs)))
    (global.set $tth_round_period (i32.load offset=80 (local.get $gs)))
    (global.set $tth_round_phase (i32.load offset=84 (local.get $gs)))
    (global.set $tth_round_threshold (i32.load offset=88 (local.get $gs)))
    (global.set $tth_round_45 (i32.load offset=92 (local.get $gs))))

  (func $tth_gs_save (param $base i32)
    (local $gs i32)
    (local.set $gs (i32.add (local.get $base) (global.get $TTH_SC_GS)))
    (i32.store offset=0 (local.get $gs) (global.get $tth_rp0))
    (i32.store offset=4 (local.get $gs) (global.get $tth_rp1))
    (i32.store offset=8 (local.get $gs) (global.get $tth_rp2))
    (i32.store offset=12 (local.get $gs) (global.get $tth_zp0))
    (i32.store offset=16 (local.get $gs) (global.get $tth_zp1))
    (i32.store offset=20 (local.get $gs) (global.get $tth_zp2))
    (i32.store offset=24 (local.get $gs) (global.get $tth_loop))
    (i32.store offset=28 (local.get $gs) (global.get $tth_min_dist))
    (i32.store offset=32 (local.get $gs) (global.get $tth_cvt_cut))
    (i32.store offset=36 (local.get $gs) (global.get $tth_sw_cut))
    (i32.store offset=40 (local.get $gs) (global.get $tth_sw_value))
    (i32.store offset=44 (local.get $gs) (global.get $tth_auto_flip))
    (i32.store offset=48 (local.get $gs) (global.get $tth_delta_base))
    (i32.store offset=52 (local.get $gs) (global.get $tth_delta_shift))
    (i32.store offset=56 (local.get $gs) (global.get $tth_pvx))
    (i32.store offset=60 (local.get $gs) (global.get $tth_pvy))
    (i32.store offset=64 (local.get $gs) (global.get $tth_fvx))
    (i32.store offset=68 (local.get $gs) (global.get $tth_fvy))
    (i32.store offset=72 (local.get $gs) (global.get $tth_dvx))
    (i32.store offset=76 (local.get $gs) (global.get $tth_dvy))
    (i32.store offset=80 (local.get $gs) (global.get $tth_round_period))
    (i32.store offset=84 (local.get $gs) (global.get $tth_round_phase))
    (i32.store offset=88 (local.get $gs) (global.get $tth_round_threshold))
    (i32.store offset=92 (local.get $gs) (global.get $tth_round_45)))

  ;; ---- bounded operand/state access ------------------------------------

  (func $tth_fail (param $code i32) (result i32)
    (if (i32.eqz (global.get $tth_error))
      (then (global.set $tth_error (local.get $code))))
    (i32.const 0))

  (func $tth_push (param $value i32) (result i32)
    (if (i32.ge_u (global.get $tth_stack_top) (global.get $TTH_MAX_STACK))
      (then (return (call $tth_fail (i32.const 2)))))
    (i32.store (i32.add (global.get $tth_stack)
      (i32.shl (global.get $tth_stack_top) (i32.const 2))) (local.get $value))
    (global.set $tth_stack_top
      (i32.add (global.get $tth_stack_top) (i32.const 1)))
    (i32.const 1))

  (func $tth_pop (result i32)
    (if (i32.eqz (global.get $tth_stack_top))
      (then
        (drop (call $tth_fail (i32.const 2)))
        (return (i32.const 0))))
    (global.set $tth_stack_top
      (i32.sub (global.get $tth_stack_top) (i32.const 1)))
    (i32.load (i32.add (global.get $tth_stack)
      (i32.shl (global.get $tth_stack_top) (i32.const 2)))))

  (func $tth_stack_at (param $from_top i32) (result i32)
    (if (i32.or (i32.le_s (local.get $from_top) (i32.const 0))
          (i32.gt_u (local.get $from_top) (global.get $tth_stack_top)))
      (then
        (drop (call $tth_fail (i32.const 2)))
        (return (i32.const 0))))
    (i32.load (i32.add (global.get $tth_stack)
      (i32.shl (i32.sub (global.get $tth_stack_top) (local.get $from_top))
        (i32.const 2)))))

  (func $tth_stack_set (param $from_top i32) (param $value i32)
    (if (i32.or (i32.le_s (local.get $from_top) (i32.const 0))
          (i32.gt_u (local.get $from_top) (global.get $tth_stack_top)))
      (then
        (drop (call $tth_fail (i32.const 2)))
        (return)))
    (i32.store (i32.add (global.get $tth_stack)
      (i32.shl (i32.sub (global.get $tth_stack_top) (local.get $from_top))
        (i32.const 2))) (local.get $value)))

  (func $tth_cvt_get (param $index i32) (result i32)
    (if (i32.or (i32.lt_s (local.get $index) (i32.const 0))
          (i32.ge_u (local.get $index)
            (i32.load offset=16 (global.get $tth_sc))))
      (then
        (global.set $tth_fault_arg (local.get $index))
        (drop (call $tth_fail (i32.const 3)))
        (return (i32.const 0))))
    (i32.load (i32.add (global.get $tth_sc)
      (i32.add (global.get $TTH_SC_CVT)
        (i32.shl (local.get $index) (i32.const 2))))))

  (func $tth_cvt_set (param $index i32) (param $value i32) (result i32)
    (if (i32.or (i32.lt_s (local.get $index) (i32.const 0))
          (i32.ge_u (local.get $index)
            (i32.load offset=16 (global.get $tth_sc))))
      (then
        (global.set $tth_fault_arg (local.get $index))
        (return (call $tth_fail (i32.const 3)))))
    (i32.store (i32.add (global.get $tth_sc)
      (i32.add (global.get $TTH_SC_CVT)
        (i32.shl (local.get $index) (i32.const 2)))) (local.get $value))
    (i32.const 1))

  (func $tth_storage_get (param $index i32) (result i32)
    (if (i32.or (i32.lt_s (local.get $index) (i32.const 0))
          (i32.ge_u (local.get $index)
            (i32.load offset=20 (global.get $tth_sc))))
      (then
        (global.set $tth_fault_arg (local.get $index))
        (drop (call $tth_fail (i32.const 3)))
        (return (i32.const 0))))
    (i32.load (i32.add (global.get $tth_sc)
      (i32.add (global.get $TTH_SC_STORAGE)
        (i32.shl (local.get $index) (i32.const 2))))))

  (func $tth_storage_set (param $index i32) (param $value i32) (result i32)
    (if (i32.or (i32.lt_s (local.get $index) (i32.const 0))
          (i32.ge_u (local.get $index)
            (i32.load offset=20 (global.get $tth_sc))))
      (then
        (global.set $tth_fault_arg (local.get $index))
        (return (call $tth_fail (i32.const 3)))))
    (i32.store (i32.add (global.get $tth_sc)
      (i32.add (global.get $TTH_SC_STORAGE)
        (i32.shl (local.get $index) (i32.const 2)))) (local.get $value))
    (i32.const 1))

  ;; zone=0 addresses the size-owned twilight array; zone=1 the current
  ;; glyph, including four phantom points after the real outline.
  (func $tth_point (param $zone i32) (param $index i32) (result i32)
    (local $limit i32) (local $base i32)
    (if (i32.or (i32.lt_s (local.get $index) (i32.const 0))
          (i32.gt_u (local.get $zone) (i32.const 1)))
      (then
        (global.set $tth_fault_arg (local.get $index))
        (drop (call $tth_fail (i32.const 4)))
        (return (i32.const 0))))
    (if (i32.eqz (local.get $zone))
      (then
        (local.set $limit (i32.load offset=28 (global.get $tth_sc)))
        (local.set $base (i32.add (global.get $tth_sc)
          (global.get $TTH_SC_TWILIGHT))))
      (else
        (local.set $limit (global.get $tth_point_count))
        (local.set $base (global.get $tth_points))))
    (if (i32.ge_u (local.get $index) (local.get $limit))
      (then
        (global.set $tth_fault_arg (local.get $index))
        (drop (call $tth_fail (i32.const 4)))
        (return (i32.const 0))))
    (i32.add (local.get $base)
      (i32.mul (local.get $index) (global.get $TTH_POINT_STRIDE))))

  (func $tth_point_current_x (param $zone i32) (param $index i32) (result i32)
    (local $p i32)
    (local.set $p (call $tth_point (local.get $zone) (local.get $index)))
    (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))
    (i32.load (local.get $p)))

  (func $tth_point_current_y (param $zone i32) (param $index i32) (result i32)
    (local $p i32)
    (local.set $p (call $tth_point (local.get $zone) (local.get $index)))
    (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))
    (i32.load offset=4 (local.get $p)))

  (func $tth_point_original_x (param $zone i32) (param $index i32) (result i32)
    (local $p i32)
    (local.set $p (call $tth_point (local.get $zone) (local.get $index)))
    (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))
    (i32.load offset=8 (local.get $p)))

  (func $tth_point_original_y (param $zone i32) (param $index i32) (result i32)
    (local $p i32)
    (local.set $p (call $tth_point (local.get $zone) (local.get $index)))
    (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))
    (i32.load offset=12 (local.get $p)))

  ;; ---- vector and rounding arithmetic ---------------------------------

  (func $tth_dot (param $x i32) (param $y i32) (param $vx i32) (param $vy i32)
        (result i32)
    (call $gdi_round_ratio
      (i64.add
        (i64.mul (i64.extend_i32_s (local.get $x))
          (i64.extend_i32_s (local.get $vx)))
        (i64.mul (i64.extend_i32_s (local.get $y))
          (i64.extend_i32_s (local.get $vy))))
      (i64.const 16384)))

  (func $tth_project_current (param $zone_a i32) (param $a i32)
        (param $zone_b i32) (param $b i32) (result i32)
    (call $tth_dot
      (i32.sub (call $tth_point_current_x (local.get $zone_a) (local.get $a))
        (call $tth_point_current_x (local.get $zone_b) (local.get $b)))
      (i32.sub (call $tth_point_current_y (local.get $zone_a) (local.get $a))
        (call $tth_point_current_y (local.get $zone_b) (local.get $b)))
      (global.get $tth_pvx) (global.get $tth_pvy)))

  (func $tth_project_original (param $zone_a i32) (param $a i32)
        (param $zone_b i32) (param $b i32) (result i32)
    (call $tth_dot
      (i32.sub (call $tth_point_original_x (local.get $zone_a) (local.get $a))
        (call $tth_point_original_x (local.get $zone_b) (local.get $b)))
      (i32.sub (call $tth_point_original_y (local.get $zone_a) (local.get $a))
        (call $tth_point_original_y (local.get $zone_b) (local.get $b)))
      (global.get $tth_dvx) (global.get $tth_dvy)))

  (func $tth_normalize (param $x i32) (param $y i32) (param $out i32)
        (result i32)
    (local $length i32)
    (if (i32.and (i32.eqz (local.get $x)) (i32.eqz (local.get $y)))
      (then (return (call $tth_fail (i32.const 5)))))
    (local.set $length (i32.trunc_f64_s (f64.sqrt (f64.add
      (f64.mul (f64.convert_i32_s (local.get $x))
        (f64.convert_i32_s (local.get $x)))
      (f64.mul (f64.convert_i32_s (local.get $y))
        (f64.convert_i32_s (local.get $y)))))))
    (if (i32.eqz (local.get $length))
      (then (return (call $tth_fail (i32.const 5)))))
    (i32.store (local.get $out) (call $gdi_round_ratio
      (i64.mul (i64.extend_i32_s (local.get $x)) (i64.const 16384))
      (i64.extend_i32_s (local.get $length))))
    (i32.store offset=4 (local.get $out) (call $gdi_round_ratio
      (i64.mul (i64.extend_i32_s (local.get $y)) (i64.const 16384))
      (i64.extend_i32_s (local.get $length))))
    (i32.const 1))

  (func $tth_round (param $value i32) (result i32)
    (local $sign i32) (local $v i32) (local $period i32)
    (local $phase i32) (local $threshold i32) (local $result i32)
    (local.set $period (global.get $tth_round_period))
    (if (i32.le_s (local.get $period) (i32.const 0))
      (then (return (local.get $value))))
    (local.set $sign (select (i32.const -1) (i32.const 1)
      (i32.lt_s (local.get $value) (i32.const 0))))
    (local.set $v (call $tth_abs (local.get $value)))
    (local.set $phase (global.get $tth_round_phase))
    (local.set $threshold (global.get $tth_round_threshold))
    (local.set $result (i32.add (local.get $phase)
      (i32.mul (local.get $period)
        (i32.div_s (i32.add
          (i32.sub (local.get $v) (local.get $phase))
          (local.get $threshold)) (local.get $period)))))
    (if (i32.lt_s (local.get $result) (i32.const 0))
      (then (local.set $result (local.get $phase))))
    (i32.mul (local.get $result) (local.get $sign)))

  (func $tth_touch (param $point i32)
    (local $flags i32)
    (if (i32.eqz (local.get $point)) (then (return)))
    (local.set $flags (i32.load offset=16 (local.get $point)))
    (if (i32.ne (global.get $tth_fvx) (i32.const 0))
      (then (local.set $flags (i32.or (local.get $flags)
        (global.get $TTH_P_TOUCH_X)))))
    (if (i32.ne (global.get $tth_fvy) (i32.const 0))
      (then (local.set $flags (i32.or (local.get $flags)
        (global.get $TTH_P_TOUCH_Y)))))
    (i32.store offset=16 (local.get $point) (local.get $flags)))

  ;; Move by a projection-vector distance along the freedom vector.  The
  ;; denominator is the projection of freedom onto projection; zero means the
  ;; requested move is geometrically impossible and faults the program.
  (func $tth_move_projection (param $point i32) (param $distance i32)
        (result i32)
    (local $denom i32) (local $dx i32) (local $dy i32)
    (if (i32.eqz (local.get $point))
      (then (return (call $tth_fail (i32.const 4)))))
    (local.set $denom (call $tth_dot (global.get $tth_fvx)
      (global.get $tth_fvy) (global.get $tth_pvx) (global.get $tth_pvy)))
    (if (i32.eqz (local.get $denom))
      (then (return (call $tth_fail (i32.const 5)))))
    (local.set $dx (call $gdi_round_ratio
      (i64.mul (i64.extend_i32_s (local.get $distance))
        (i64.extend_i32_s (global.get $tth_fvx)))
      (i64.extend_i32_s (local.get $denom))))
    (local.set $dy (call $gdi_round_ratio
      (i64.mul (i64.extend_i32_s (local.get $distance))
        (i64.extend_i32_s (global.get $tth_fvy)))
      (i64.extend_i32_s (local.get $denom))))
    (i32.store (local.get $point)
      (i32.add (i32.load (local.get $point)) (local.get $dx)))
    (i32.store offset=4 (local.get $point)
      (i32.add (i32.load offset=4 (local.get $point)) (local.get $dy)))
    (call $tth_touch (local.get $point))
    (i32.const 1))

  (func $tth_move_freedom (param $point i32) (param $distance i32)
        (result i32)
    (if (i32.eqz (local.get $point))
      (then (return (call $tth_fail (i32.const 4)))))
    (i32.store (local.get $point) (i32.add (i32.load (local.get $point))
      (call $gdi_round_ratio
        (i64.mul (i64.extend_i32_s (local.get $distance))
          (i64.extend_i32_s (global.get $tth_fvx))) (i64.const 16384))))
    (i32.store offset=4 (local.get $point)
      (i32.add (i32.load offset=4 (local.get $point))
        (call $gdi_round_ratio
          (i64.mul (i64.extend_i32_s (local.get $distance))
            (i64.extend_i32_s (global.get $tth_fvy))) (i64.const 16384))))
    (call $tth_touch (local.get $point))
    (i32.const 1))

  (func $tth_set_axis_vectors (param $kind i32) (param $x_axis i32)
    (local $x i32) (local $y i32)
    (local.set $x (select (i32.const 0x4000) (i32.const 0)
      (local.get $x_axis)))
    (local.set $y (select (i32.const 0) (i32.const 0x4000)
      (local.get $x_axis)))
    ;; kind 0 both, 1 projection+dual, 2 freedom.
    (if (i32.le_u (local.get $kind) (i32.const 1))
      (then
        (global.set $tth_pvx (local.get $x))
        (global.set $tth_pvy (local.get $y))
        (global.set $tth_dvx (local.get $x))
        (global.set $tth_dvy (local.get $y))))
    (if (i32.or (i32.eqz (local.get $kind))
          (i32.eq (local.get $kind) (i32.const 2)))
      (then
        (global.set $tth_fvx (local.get $x))
        (global.set $tth_fvy (local.get $y)))))

  (func $tth_set_line_vector (param $freedom i32) (param $dual i32)
        (param $perpendicular i32) (result i32)
    (local $p2 i32) (local $p1 i32) (local $a i32) (local $b i32)
    (local $x i32) (local $y i32) (local $tmp i32)
    (local.set $p2 (call $tth_pop))
    (local.set $p1 (call $tth_pop))
    (if (global.get $tth_error) (then (return (i32.const 0))))
    (local.set $a (call $tth_point (global.get $tth_zp2) (local.get $p2)))
    (local.set $b (call $tth_point (global.get $tth_zp1) (local.get $p1)))
    (if (global.get $tth_error) (then (return (i32.const 0))))
    (local.set $x (i32.sub (i32.load (local.get $a)) (i32.load (local.get $b))))
    (local.set $y (i32.sub (i32.load offset=4 (local.get $a))
      (i32.load offset=4 (local.get $b))))
    (if (i32.and (i32.eqz (local.get $x)) (i32.eqz (local.get $y)))
      (then
        ;; The Win98 rasterizer treats a coincident-point line as a no-op.
        ;; This occurs in deployed fonts after a twilight setup function;
        ;; retaining the previous vector keeps execution deterministic.
        (return (i32.const 1))))
    (if (local.get $perpendicular)
      (then
        (local.set $tmp (local.get $x))
        (local.set $x (i32.sub (i32.const 0) (local.get $y)))
        (local.set $y (local.get $tmp))))
    ;; Reuse the first two words of the call arena as a normalization result.
    (if (i32.eqz (call $tth_normalize (local.get $x) (local.get $y)
          (global.get $tth_temp)))
      (then
        (global.set $tth_fault_arg (i32.or (i32.const 0x80000000)
          (i32.or
            (i32.shl (i32.and (local.get $x) (i32.const 0x7FFF)) (i32.const 16))
            (i32.and (local.get $y) (i32.const 0xFFFF)))))
        (return (i32.const 0))))
    (local.set $x (i32.load (global.get $tth_temp)))
    (local.set $y (i32.load offset=4 (global.get $tth_temp)))
    (if (local.get $freedom)
      (then
        (global.set $tth_fvx (local.get $x))
        (global.set $tth_fvy (local.get $y)))
      (else
        (global.set $tth_pvx (local.get $x))
        (global.set $tth_pvy (local.get $y))
        (if (local.get $dual)
          (then
            (local.set $x (i32.sub (i32.load offset=8 (local.get $a))
              (i32.load offset=8 (local.get $b))))
            (local.set $y (i32.sub (i32.load offset=12 (local.get $a))
              (i32.load offset=12 (local.get $b))))
            (if (local.get $perpendicular)
              (then
                (local.set $tmp (local.get $x))
                (local.set $x (i32.sub (i32.const 0) (local.get $y)))
                (local.set $y (local.get $tmp))))
            (if (i32.eqz (call $tth_normalize (local.get $x) (local.get $y)
                  (global.get $tth_temp)))
              (then
                (global.set $tth_fault_arg (i32.or (i32.const 0x40000000)
                  (i32.or
                    (i32.shl (i32.and (local.get $x) (i32.const 0x3FFF))
                      (i32.const 16))
                    (i32.and (local.get $y) (i32.const 0xFFFF)))))
                (return (i32.const 0))))
            (global.set $tth_dvx (i32.load (global.get $tth_temp)))
            (global.set $tth_dvy (i32.load offset=4 (global.get $tth_temp))))
          (else
            ;; All ordinary projection-vector setters reset the dual vector
            ;; to that same vector. Only SDPVTL derives it from original points.
            (global.set $tth_dvx (local.get $x))
            (global.set $tth_dvy (local.get $y))))))
    (i32.const 1))

  ;; ---- stream, flow, and non-point opcode families ---------------------

  (func $tth_byte (param $off i32) (result i32)
    (if (i32.ge_u (local.get $off) (global.get $tth_program_len))
      (then
        (drop (call $tth_fail (i32.const 1)))
        (return (i32.const 0))))
    (i32.load8_u (i32.add (global.get $tth_program) (local.get $off))))

  (func $tth_stream_push (result i32)
    (local $op i32) (local $count i32) (local $width i32)
    (local $index i32) (local $value i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x40))
          (i32.eq (local.get $op) (i32.const 0x41)))
      (then
        (local.set $width (select (i32.const 2) (i32.const 1)
          (i32.eq (local.get $op) (i32.const 0x41))))
        (local.set $count (call $tth_byte (global.get $tth_pc)))
        (global.set $tth_pc (i32.add (global.get $tth_pc) (i32.const 1))))
      (else
        (local.set $width (select (i32.const 2) (i32.const 1)
          (i32.ge_u (local.get $op) (i32.const 0xB8))))
        (local.set $count (i32.add
          (i32.and (local.get $op) (i32.const 7)) (i32.const 1)))))
    (if (i32.or (global.get $tth_error)
          (i32.gt_u (i32.mul (local.get $count) (local.get $width))
            (i32.sub (global.get $tth_program_len) (global.get $tth_pc))))
      (then (return (call $tth_fail (i32.const 1)))))
    (block $done (loop $values
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (if (i32.eq (local.get $width) (i32.const 1))
        (then (local.set $value (call $tth_byte (global.get $tth_pc))))
        (else
          (local.set $value (i32.shr_s (i32.shl (i32.or
            (i32.shl (call $tth_byte (global.get $tth_pc)) (i32.const 8))
            (call $tth_byte (i32.add (global.get $tth_pc) (i32.const 1))))
            (i32.const 16)) (i32.const 16)))))
      (if (i32.eqz (call $tth_push (local.get $value)))
        (then (return (i32.const 0))))
      (global.set $tth_pc (i32.add (global.get $tth_pc) (local.get $width)))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $values)))
    (i32.const 1))

  ;; Advance an arbitrary scan position over immediate PUSH data.  The input
  ;; points at an opcode; the result points just after that instruction.
  (func $tth_skip_one (param $pc i32) (result i32)
    (local $op i32) (local $count i32) (local $bytes i32)
    (if (i32.ge_u (local.get $pc) (global.get $tth_program_len))
      (then
        (drop (call $tth_fail (i32.const 6)))
        (return (global.get $tth_program_len))))
    (local.set $op (call $tth_byte (local.get $pc)))
    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x40))
          (i32.eq (local.get $op) (i32.const 0x41)))
      (then
        (if (i32.ge_u (local.get $pc) (global.get $tth_program_len))
          (then
            (drop (call $tth_fail (i32.const 6)))
            (return (global.get $tth_program_len))))
        (local.set $count (call $tth_byte (local.get $pc)))
        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
        (local.set $bytes (i32.mul (local.get $count)
          (select (i32.const 2) (i32.const 1)
            (i32.eq (local.get $op) (i32.const 0x41))))))
      (else (if (i32.and (i32.ge_u (local.get $op) (i32.const 0xB0))
            (i32.le_u (local.get $op) (i32.const 0xBF)))
        (then
          (local.set $count (i32.add (i32.and (local.get $op) (i32.const 7))
            (i32.const 1)))
          (local.set $bytes (i32.mul (local.get $count)
            (select (i32.const 2) (i32.const 1)
              (i32.ge_u (local.get $op) (i32.const 0xB8)))))))))
    (if (i32.gt_u (local.get $bytes)
          (i32.sub (global.get $tth_program_len) (local.get $pc)))
      (then
        (drop (call $tth_fail (i32.const 6)))
        (return (global.get $tth_program_len))))
    (i32.add (local.get $pc) (local.get $bytes)))

  ;; stop_else=1 stops after a depth-zero ELSE or EIF. stop_else=0 ignores
  ;; ELSE and finds EIF. Nested IF blocks and PUSH payloads are respected.
  (func $tth_skip_conditional (param $stop_else i32) (result i32)
    (local $scan i32) (local $depth i32) (local $op i32)
    (local.set $scan (global.get $tth_pc))
    (block $found (loop $walk
      (if (i32.ge_u (local.get $scan) (global.get $tth_program_len))
        (then (return (call $tth_fail (i32.const 6)))))
      (local.set $op (call $tth_byte (local.get $scan)))
      (if (i32.eq (local.get $op) (i32.const 0x58))
        (then (local.set $depth (i32.add (local.get $depth) (i32.const 1))))
        (else (if (i32.eq (local.get $op) (i32.const 0x59))
          (then
            (if (i32.eqz (local.get $depth))
              (then
                (local.set $scan (i32.add (local.get $scan) (i32.const 1)))
                (br $found)))
            (local.set $depth (i32.sub (local.get $depth) (i32.const 1))))
          (else (if (i32.and (i32.eq (local.get $op) (i32.const 0x1B))
                (i32.and (i32.eqz (local.get $depth)) (local.get $stop_else)))
            (then
              (local.set $scan (i32.add (local.get $scan) (i32.const 1)))
              (br $found)))))))
      (local.set $scan (call $tth_skip_one (local.get $scan)))
      (if (global.get $tth_error) (then (return (i32.const 0))))
      (br $walk)))
    (global.set $tth_pc (local.get $scan))
    (i32.const 1))

  (func $tth_op_vector (result i32)
    (local $op i32) (local $x i32) (local $y i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.le_u (local.get $op) (i32.const 1))
      (then
        (call $tth_set_axis_vectors (i32.const 0)
          (i32.and (local.get $op) (i32.const 1)))
        (return (i32.const 1))))
    (if (i32.le_u (local.get $op) (i32.const 3))
      (then
        (call $tth_set_axis_vectors (i32.const 1)
          (i32.and (local.get $op) (i32.const 1)))
        (return (i32.const 1))))
    (if (i32.le_u (local.get $op) (i32.const 5))
      (then
        (call $tth_set_axis_vectors (i32.const 2)
          (i32.and (local.get $op) (i32.const 1)))
        (return (i32.const 1))))
    (if (i32.le_u (local.get $op) (i32.const 9))
      (then (return (call $tth_set_line_vector
        (i32.ge_u (local.get $op) (i32.const 8))
        (i32.const 0)
        (i32.and (local.get $op) (i32.const 1))))))
    (if (i32.le_u (local.get $op) (i32.const 0x0B))
      (then
        (local.set $y (call $tth_pop))
        (local.set $x (call $tth_pop))
        (if (global.get $tth_error) (then (return (i32.const 0))))
        (if (i32.eqz (call $tth_normalize (local.get $x) (local.get $y)
              (global.get $tth_temp)))
          (then (return (i32.const 0))))
        (local.set $x (i32.load (global.get $tth_temp)))
        (local.set $y (i32.load offset=4 (global.get $tth_temp)))
        (if (i32.eq (local.get $op) (i32.const 0x0A))
          (then
            (global.set $tth_pvx (local.get $x))
            (global.set $tth_pvy (local.get $y))
            (global.set $tth_dvx (local.get $x))
            (global.set $tth_dvy (local.get $y)))
          (else
            (global.set $tth_fvx (local.get $x))
            (global.set $tth_fvy (local.get $y))))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x0C))
      (then
        (drop (call $tth_push (global.get $tth_pvx)))
        (return (call $tth_push (global.get $tth_pvy)))))
    (if (i32.eq (local.get $op) (i32.const 0x0D))
      (then
        (drop (call $tth_push (global.get $tth_fvx)))
        (return (call $tth_push (global.get $tth_fvy)))))
    (global.set $tth_fvx (global.get $tth_pvx))
    (global.set $tth_fvy (global.get $tth_pvy))
    (i32.const 1))

  (func $tth_op_state (result i32)
    (local $op i32) (local $a i32) (local $b i32) (local $period i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.and (i32.ge_u (local.get $op) (i32.const 0x10))
          (i32.le_u (local.get $op) (i32.const 0x12)))
      (then
        (local.set $a (call $tth_pop))
        (if (i32.eq (local.get $op) (i32.const 0x10))
          (then (global.set $tth_rp0 (local.get $a))))
        (if (i32.eq (local.get $op) (i32.const 0x11))
          (then (global.set $tth_rp1 (local.get $a))))
        (if (i32.eq (local.get $op) (i32.const 0x12))
          (then (global.set $tth_rp2 (local.get $a))))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.and (i32.ge_u (local.get $op) (i32.const 0x13))
          (i32.le_u (local.get $op) (i32.const 0x16)))
      (then
        (local.set $a (call $tth_pop))
        (if (i32.gt_u (local.get $a) (i32.const 1))
          (then (return (call $tth_fail (i32.const 4)))))
        (if (i32.or (i32.eq (local.get $op) (i32.const 0x13))
              (i32.eq (local.get $op) (i32.const 0x16)))
          (then (global.set $tth_zp0 (local.get $a))))
        (if (i32.or (i32.eq (local.get $op) (i32.const 0x14))
              (i32.eq (local.get $op) (i32.const 0x16)))
          (then (global.set $tth_zp1 (local.get $a))))
        (if (i32.or (i32.eq (local.get $op) (i32.const 0x15))
              (i32.eq (local.get $op) (i32.const 0x16)))
          (then (global.set $tth_zp2 (local.get $a))))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x17))
      (then
        (local.set $a (call $tth_pop))
        (if (i32.or (i32.le_s (local.get $a) (i32.const 0))
              (i32.gt_u (local.get $a) (global.get $TTH_MAX_POINTS)))
          (then (return (call $tth_fail (i32.const 3)))))
        (global.set $tth_loop (local.get $a))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x18))
      (then
        (global.set $tth_round_period (i32.const 64))
        (global.set $tth_round_phase (i32.const 0))
        (global.set $tth_round_threshold (i32.const 32))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x19))
      (then
        (global.set $tth_round_period (i32.const 64))
        (global.set $tth_round_phase (i32.const 32))
        (global.set $tth_round_threshold (i32.const 32))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x1A))
      (then (global.set $tth_min_dist (call $tth_pop))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x1D))
      (then (global.set $tth_cvt_cut (call $tth_pop))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x1E))
      (then (global.set $tth_sw_cut (call $tth_pop))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x1F))
      (then
        (global.set $tth_sw_value (call $tt_fu_to_26_6 (call $tth_pop)
          (global.get $tth_ppem) (global.get $tth_upem)))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x3D))
      (then
        (global.set $tth_round_period (i32.const 32))
        (global.set $tth_round_phase (i32.const 0))
        (global.set $tth_round_threshold (i32.const 16))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x4D))
      (then (global.set $tth_auto_flip (i32.const 1)) (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x4E))
      (then (global.set $tth_auto_flip (i32.const 0)) (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x5E))
      (then (global.set $tth_delta_base (call $tth_pop))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x5F))
      (then
        (local.set $a (call $tth_pop))
        (if (i32.gt_u (local.get $a) (i32.const 6))
          (then (return (call $tth_fail (i32.const 3)))))
        (global.set $tth_delta_shift (local.get $a))
        (return (i32.const 1))))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x76))
          (i32.eq (local.get $op) (i32.const 0x77)))
      (then
        (local.set $a (call $tth_pop))
        (local.set $b (i32.and (i32.shr_u (local.get $a) (i32.const 6))
          (i32.const 3)))
        (local.set $period (select (i32.const 32)
          (select (i32.const 128) (i32.const 64)
            (i32.eq (local.get $b) (i32.const 2)))
          (i32.eqz (local.get $b))))
        (if (i32.eq (local.get $op) (i32.const 0x77))
          (then
            ;; sqrt(2)/2 in 16.16, the S45ROUND period scale.
            (local.set $period (call $gdi_round_ratio
              (i64.mul (i64.extend_i32_s (local.get $period))
                (i64.const 46341)) (i64.const 65536)))
            (global.set $tth_round_45 (i32.const 1)))
          (else (global.set $tth_round_45 (i32.const 0))))
        (global.set $tth_round_period (local.get $period))
        (global.set $tth_round_phase (i32.div_s
          (i32.mul (local.get $period)
            (i32.and (i32.shr_u (local.get $a) (i32.const 4)) (i32.const 3)))
          (i32.const 4)))
        (local.set $b (i32.and (local.get $a) (i32.const 15)))
        (global.set $tth_round_threshold (select
          (i32.sub (local.get $period) (i32.const 1))
          (i32.div_s (i32.mul (local.get $period)
              (i32.sub (local.get $b) (i32.const 4))) (i32.const 8))
          (i32.eqz (local.get $b))))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x7A))
      (then (global.set $tth_round_period (i32.const 0))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x7C))
      (then
        (global.set $tth_round_period (i32.const 64))
        (global.set $tth_round_phase (i32.const 0))
        (global.set $tth_round_threshold (i32.const 63))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x7D))
      (then
        (global.set $tth_round_period (i32.const 64))
        (global.set $tth_round_phase (i32.const 0))
        (global.set $tth_round_threshold (i32.const 0))
        (return (i32.const 1))))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x7E))
          (i32.eq (local.get $op) (i32.const 0x7F)))
      (then (drop (call $tth_pop))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x85))
      (then (global.set $tth_scan_control (call $tth_pop))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x8D))
      (then (global.set $tth_scan_type (call $tth_pop))
        (return (i32.eqz (global.get $tth_error)))))
    ;; INSTCTRL: selector is topmost, then value.
    (local.set $a (call $tth_pop))
    (local.set $b (call $tth_pop))
    (if (global.get $tth_error) (then (return (i32.const 0))))
    (if (i32.eq (local.get $a) (i32.const 1))
      (then (global.set $tth_inst_control (select
        (i32.or (global.get $tth_inst_control) (i32.const 1))
        (i32.and (global.get $tth_inst_control) (i32.const -2))
        (i32.ne (local.get $b) (i32.const 0))))))
    (if (i32.eq (local.get $a) (i32.const 2))
      (then (global.set $tth_inst_control (select
        (i32.or (global.get $tth_inst_control) (i32.const 2))
        (i32.and (global.get $tth_inst_control) (i32.const -3))
        (i32.ne (local.get $b) (i32.const 0))))))
    (i32.const 1))

  (func $tth_op_stack (result i32)
    (local $op i32) (local $a i32) (local $b i32)
    (local $i i32) (local $slot i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.eq (local.get $op) (i32.const 0x20))
      (then (return (call $tth_push (call $tth_stack_at (i32.const 1))))))
    (if (i32.eq (local.get $op) (i32.const 0x21))
      (then (drop (call $tth_pop))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x22))
      (then (global.set $tth_stack_top (i32.const 0)) (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x23))
      (then
        (local.set $a (call $tth_stack_at (i32.const 1)))
        (local.set $b (call $tth_stack_at (i32.const 2)))
        (call $tth_stack_set (i32.const 1) (local.get $b))
        (call $tth_stack_set (i32.const 2) (local.get $a))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x24))
      (then (return (call $tth_push (global.get $tth_stack_top)))))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x25))
          (i32.eq (local.get $op) (i32.const 0x26)))
      (then
        (local.set $a (call $tth_pop))
        (local.set $b (call $tth_stack_at (local.get $a)))
        (if (global.get $tth_error) (then (return (i32.const 0))))
        (if (i32.eq (local.get $op) (i32.const 0x26))
          (then
            (local.set $slot (i32.sub (global.get $tth_stack_top) (local.get $a)))
            (local.set $i (local.get $slot))
            (block $shifted (loop $shift
              (br_if $shifted (i32.ge_u (i32.add (local.get $i) (i32.const 1))
                (global.get $tth_stack_top)))
              (i32.store (i32.add (global.get $tth_stack)
                  (i32.shl (local.get $i) (i32.const 2)))
                (i32.load (i32.add (global.get $tth_stack)
                  (i32.shl (i32.add (local.get $i) (i32.const 1))
                    (i32.const 2)))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $shift)))
            (global.set $tth_stack_top
              (i32.sub (global.get $tth_stack_top) (i32.const 1)))))
        (return (call $tth_push (local.get $b)))))
    ;; ROLL: abc -> bca.
    (local.set $a (call $tth_stack_at (i32.const 3)))
    (local.set $b (call $tth_stack_at (i32.const 2)))
    (local.set $i (call $tth_stack_at (i32.const 1)))
    (call $tth_stack_set (i32.const 3) (local.get $b))
    (call $tth_stack_set (i32.const 2) (local.get $i))
    (call $tth_stack_set (i32.const 1) (local.get $a))
    (i32.eqz (global.get $tth_error)))

  (func $tth_op_memory (result i32)
    (local $op i32) (local $value i32) (local $index i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.eq (local.get $op) (i32.const 0x43))
      (then (return (call $tth_push (call $tth_storage_get (call $tth_pop))))))
    (if (i32.eq (local.get $op) (i32.const 0x45))
      (then (return (call $tth_push (call $tth_cvt_get (call $tth_pop))))))
    (local.set $value (call $tth_pop))
    (local.set $index (call $tth_pop))
    (if (global.get $tth_error) (then (return (i32.const 0))))
    (if (i32.eq (local.get $op) (i32.const 0x42))
      (then (return (call $tth_storage_set (local.get $index) (local.get $value)))))
    (if (i32.eq (local.get $op) (i32.const 0x70))
      (then (local.set $value (call $tt_fu_to_26_6 (local.get $value)
        (global.get $tth_ppem) (global.get $tth_upem)))))
    (call $tth_cvt_set (local.get $index) (local.get $value)))

  (func $tth_op_measure (result i32)
    (local $op i32) (local $selector i32) (local $answer i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x4B))
          (i32.eq (local.get $op) (i32.const 0x4C)))
      (then (return (call $tth_push (global.get $tth_ppem)))))
    (local.set $selector (call $tth_pop))
    ;; Win98 identifies the Microsoft rasterizer 1.7 as engine version 35.
    (if (i32.and (local.get $selector) (i32.const 1))
      (then (local.set $answer (i32.const 35))))
    (if (i32.and (local.get $selector) (i32.const 0x20))
      (then (local.set $answer (i32.or (local.get $answer) (i32.const 0x1000)))))
    (call $tth_push (local.get $answer)))

  (func $tth_op_compare (result i32)
    (local $op i32) (local $a i32) (local $b i32) (local $answer i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.le_u (local.get $op) (i32.const 0x55))
      (then
        (local.set $b (call $tth_pop))
        (local.set $a (call $tth_pop))
        (if (global.get $tth_error) (then (return (i32.const 0))))
        (if (i32.eq (local.get $op) (i32.const 0x50))
          (then (local.set $answer (i32.lt_s (local.get $a) (local.get $b)))))
        (if (i32.eq (local.get $op) (i32.const 0x51))
          (then (local.set $answer (i32.le_s (local.get $a) (local.get $b)))))
        (if (i32.eq (local.get $op) (i32.const 0x52))
          (then (local.set $answer (i32.gt_s (local.get $a) (local.get $b)))))
        (if (i32.eq (local.get $op) (i32.const 0x53))
          (then (local.set $answer (i32.ge_s (local.get $a) (local.get $b)))))
        (if (i32.eq (local.get $op) (i32.const 0x54))
          (then (local.set $answer (i32.eq (local.get $a) (local.get $b)))))
        (if (i32.eq (local.get $op) (i32.const 0x55))
          (then (local.set $answer (i32.ne (local.get $a) (local.get $b)))))
        (return (call $tth_push (local.get $answer)))))
    (local.set $a (call $tth_pop))
    (local.set $answer (i32.and (i32.shr_s (call $tth_round (local.get $a))
      (i32.const 6)) (i32.const 1)))
    (if (i32.eq (local.get $op) (i32.const 0x57))
      (then (local.set $answer (i32.xor (local.get $answer) (i32.const 1)))))
    (call $tth_push (local.get $answer)))

  (func $tth_op_logic (result i32)
    (local $op i32) (local $a i32) (local $b i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.eq (local.get $op) (i32.const 0x5C))
      (then (return (call $tth_push (i32.eqz (call $tth_pop))))))
    (local.set $b (call $tth_pop))
    (local.set $a (call $tth_pop))
    (if (global.get $tth_error) (then (return (i32.const 0))))
    (if (i32.eq (local.get $op) (i32.const 0x5A))
      (then (return (call $tth_push (i32.and
        (i32.ne (local.get $a) (i32.const 0))
        (i32.ne (local.get $b) (i32.const 0)))))))
    (call $tth_push (i32.or
      (i32.ne (local.get $a) (i32.const 0))
      (i32.ne (local.get $b) (i32.const 0)))))

  (func $tth_op_math (result i32)
    (local $op i32) (local $a i32) (local $b i32) (local $answer i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.and (i32.ge_u (local.get $op) (i32.const 0x60))
          (i32.le_u (local.get $op) (i32.const 0x63)))
      (then
        (local.set $b (call $tth_pop))
        (local.set $a (call $tth_pop))
        (if (global.get $tth_error) (then (return (i32.const 0))))
        (if (i32.eq (local.get $op) (i32.const 0x60))
          (then (local.set $answer (i32.add (local.get $a) (local.get $b)))))
        (if (i32.eq (local.get $op) (i32.const 0x61))
          (then (local.set $answer (i32.sub (local.get $a) (local.get $b)))))
        (if (i32.eq (local.get $op) (i32.const 0x62))
          (then
            (if (i32.eqz (local.get $b))
              (then (return (call $tth_fail (i32.const 5)))))
            ;; DIV truncates; it is not the rasterizer's rounded ratio helper.
            (local.set $answer (i32.wrap_i64 (i64.div_s
              (i64.shl (i64.extend_i32_s (local.get $a)) (i64.const 6))
              (i64.extend_i32_s (local.get $b)))))))
        (if (i32.eq (local.get $op) (i32.const 0x63))
          (then (local.set $answer (i32.wrap_i64 (i64.shr_s
            (i64.mul (i64.extend_i32_s (local.get $a))
              (i64.extend_i32_s (local.get $b))) (i64.const 6))))))
        (return (call $tth_push (local.get $answer)))))
    (local.set $a (call $tth_pop))
    (if (global.get $tth_error) (then (return (i32.const 0))))
    (if (i32.eq (local.get $op) (i32.const 0x64))
      (then (return (call $tth_push (call $tth_abs (local.get $a))))))
    (if (i32.eq (local.get $op) (i32.const 0x65))
      (then (return (call $tth_push (i32.sub (i32.const 0) (local.get $a))))))
    (if (i32.eq (local.get $op) (i32.const 0x66))
      (then (return (call $tth_push (i32.and (local.get $a) (i32.const -64))))))
    (if (i32.eq (local.get $op) (i32.const 0x67))
      (then (return (call $tth_push (i32.and
        (i32.add (local.get $a) (i32.const 63)) (i32.const -64))))))
    (if (i32.le_u (local.get $op) (i32.const 0x6B))
      (then (return (call $tth_push (call $tth_round (local.get $a))))))
    (if (i32.le_u (local.get $op) (i32.const 0x6F))
      (then (return (call $tth_push (local.get $a)))))
    ;; MAX/MIN.
    (local.set $b (local.get $a))
    (local.set $a (call $tth_pop))
    (if (i32.eq (local.get $op) (i32.const 0x8B))
      (then (return (call $tth_push (select (local.get $a) (local.get $b)
        (i32.gt_s (local.get $a) (local.get $b)))))))
    (call $tth_push (select (local.get $a) (local.get $b)
      (i32.lt_s (local.get $a) (local.get $b)))))

  ;; ---- point movement --------------------------------------------------

  (func $tth_single_width (param $distance i32) (result i32)
    (local $sign i32)
    (local.set $sign (select (i32.const -1) (i32.const 1)
      (i32.lt_s (local.get $distance) (i32.const 0))))
    (if (i32.lt_s
          (call $tth_abs (i32.sub (call $tth_abs (local.get $distance))
            (global.get $tth_sw_value)))
          (global.get $tth_sw_cut))
      (then (return (i32.mul (local.get $sign) (global.get $tth_sw_value)))))
    (local.get $distance))

  (func $tth_minimum_distance (param $distance i32) (result i32)
    (if (i32.lt_s (call $tth_abs (local.get $distance))
          (global.get $tth_min_dist))
      (then (return (select
        (i32.sub (i32.const 0) (global.get $tth_min_dist))
        (global.get $tth_min_dist)
        (i32.lt_s (local.get $distance) (i32.const 0))))))
    (local.get $distance))

  ;; MDRP/MIRP share the reference-point update and final projected move.
  (func $tth_relative_finish (param $point_index i32) (param $distance i32)
        (param $set_rp0 i32) (result i32)
    (local $old_rp0 i32) (local $point i32) (local $current i32)
    (local.set $old_rp0 (global.get $tth_rp0))
    (local.set $point (call $tth_point (global.get $tth_zp1)
      (local.get $point_index)))
    (local.set $current (call $tth_project_current (global.get $tth_zp1)
      (local.get $point_index) (global.get $tth_zp0) (local.get $old_rp0)))
    (if (global.get $tth_error) (then (return (i32.const 0))))
    (if (i32.eqz (call $tth_move_projection (local.get $point)
          (i32.sub (local.get $distance) (local.get $current))))
      (then (return (i32.const 0))))
    (global.set $tth_rp1 (local.get $old_rp0))
    (global.set $tth_rp2 (local.get $point_index))
    (if (local.get $set_rp0)
      (then (global.set $tth_rp0 (local.get $point_index))))
    (i32.const 1))

  (func $tth_op_relative (result i32)
    (local $op i32) (local $point_index i32) (local $cvt_index i32)
    (local $distance i32) (local $original i32) (local $set_rp0 i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.ge_u (local.get $op) (i32.const 0xE0))
      (then
        ;; MIRP pops the CVT index first, then the point number.
        (local.set $cvt_index (call $tth_pop))
        (local.set $point_index (call $tth_pop))
        (local.set $distance (call $tth_cvt_get (local.get $cvt_index)))
        (local.set $original (call $tth_project_original
          (global.get $tth_zp1) (local.get $point_index)
          (global.get $tth_zp0) (global.get $tth_rp0)))
        (if (i32.and (global.get $tth_auto_flip)
              (i32.lt_s (i32.xor (local.get $distance) (local.get $original))
                (i32.const 0)))
          (then (local.set $distance
            (i32.sub (i32.const 0) (local.get $distance)))))
        (if (i32.and (local.get $op) (i32.const 0x04))
          (then
            (if (i32.gt_s (call $tth_abs
                  (i32.sub (local.get $distance) (local.get $original)))
                  (global.get $tth_cvt_cut))
              (then (local.set $distance (local.get $original)))))))
      (else
        (local.set $point_index (call $tth_pop))
        (local.set $distance (call $tth_project_original
          (global.get $tth_zp1) (local.get $point_index)
          (global.get $tth_zp0) (global.get $tth_rp0)))))
    (if (global.get $tth_error) (then (return (i32.const 0))))
    (local.set $distance (call $tth_single_width (local.get $distance)))
    (if (i32.and (local.get $op) (i32.const 0x04))
      (then (local.set $distance (call $tth_round (local.get $distance)))))
    (if (i32.and (local.get $op) (i32.const 0x08))
      (then (local.set $distance
        (call $tth_minimum_distance (local.get $distance)))))
    (local.set $set_rp0 (i32.and (local.get $op) (i32.const 0x10)))
    (call $tth_relative_finish (local.get $point_index) (local.get $distance)
      (local.get $set_rp0)))

  (func $tth_op_direct_point (result i32)
    (local $op i32) (local $point_index i32) (local $other i32)
    (local $value i32) (local $current i32) (local $point i32)
    (local.set $op (global.get $tth_opcode))
    ;; ALIGNPTS: move both points half of their projected separation.
    (if (i32.eq (local.get $op) (i32.const 0x27))
      (then
        (local.set $point_index (call $tth_pop))
        (local.set $other (call $tth_pop))
        (local.set $value (call $tth_project_current (global.get $tth_zp1)
          (local.get $point_index) (global.get $tth_zp0) (local.get $other)))
        (if (global.get $tth_error) (then (return (i32.const 0))))
        (drop (call $tth_move_projection
          (call $tth_point (global.get $tth_zp1) (local.get $point_index))
          (i32.sub (i32.const 0) (i32.shr_s (local.get $value) (i32.const 1)))))
        (return (call $tth_move_projection
          (call $tth_point (global.get $tth_zp0) (local.get $other))
          (i32.shr_s (local.get $value) (i32.const 1))))))
    ;; UTP clears touch flags in the freedom-vector directions.
    (if (i32.eq (local.get $op) (i32.const 0x29))
      (then
        (local.set $point_index (call $tth_pop))
        (local.set $point (call $tth_point (global.get $tth_zp0)
          (local.get $point_index)))
        (if (global.get $tth_error) (then (return (i32.const 0))))
        (local.set $value (i32.load offset=16 (local.get $point)))
        (if (i32.ne (global.get $tth_fvx) (i32.const 0))
          (then (local.set $value (i32.and (local.get $value) (i32.const -5)))))
        (if (i32.ne (global.get $tth_fvy) (i32.const 0))
          (then (local.set $value (i32.and (local.get $value) (i32.const -9)))))
        (i32.store offset=16 (local.get $point) (local.get $value))
        (return (i32.const 1))))
    ;; MDAP[0/1].
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x2E))
          (i32.eq (local.get $op) (i32.const 0x2F)))
      (then
        (local.set $point_index (call $tth_pop))
        (local.set $current (call $tth_project_current (global.get $tth_zp0)
          (local.get $point_index) (global.get $tth_zp0) (local.get $point_index)))
        ;; A point coordinate is its projection from the origin, not from itself.
        (local.set $current (call $tth_dot
          (call $tth_point_current_x (global.get $tth_zp0) (local.get $point_index))
          (call $tth_point_current_y (global.get $tth_zp0) (local.get $point_index))
          (global.get $tth_pvx) (global.get $tth_pvy)))
        (local.set $value (select (call $tth_round (local.get $current))
          (local.get $current) (i32.and (local.get $op) (i32.const 1))))
        (local.set $point (call $tth_point (global.get $tth_zp0)
          (local.get $point_index)))
        (if (i32.eqz (call $tth_move_projection (local.get $point)
              (i32.sub (local.get $value) (local.get $current))))
          (then (return (i32.const 0))))
        (global.set $tth_rp0 (local.get $point_index))
        (global.set $tth_rp1 (local.get $point_index))
        (return (i32.const 1))))
    ;; MIAP[0/1].
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x3E))
          (i32.eq (local.get $op) (i32.const 0x3F)))
      (then
        (local.set $other (call $tth_pop))
        (local.set $point_index (call $tth_pop))
        (local.set $value (call $tth_cvt_get (local.get $other)))
        (local.set $current (call $tth_dot
          (call $tth_point_original_x (global.get $tth_zp0) (local.get $point_index))
          (call $tth_point_original_y (global.get $tth_zp0) (local.get $point_index))
          (global.get $tth_dvx) (global.get $tth_dvy)))
        (if (i32.and (local.get $op) (i32.const 1))
          (then
            (if (i32.gt_s (call $tth_abs
                  (i32.sub (local.get $value) (local.get $current)))
                  (global.get $tth_cvt_cut))
              (then (local.set $value (local.get $current))))
            (local.set $value (call $tth_round (local.get $value)))))
        (local.set $current (call $tth_dot
          (call $tth_point_current_x (global.get $tth_zp0) (local.get $point_index))
          (call $tth_point_current_y (global.get $tth_zp0) (local.get $point_index))
          (global.get $tth_pvx) (global.get $tth_pvy)))
        (if (i32.eqz (call $tth_move_projection
              (call $tth_point (global.get $tth_zp0) (local.get $point_index))
              (i32.sub (local.get $value) (local.get $current))))
          (then (return (i32.const 0))))
        (global.set $tth_rp0 (local.get $point_index))
        (global.set $tth_rp1 (local.get $point_index))
        (return (i32.const 1))))
    ;; MSIRP[0/1].
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x3A))
          (i32.eq (local.get $op) (i32.const 0x3B)))
      (then
        (local.set $value (call $tth_pop))
        (local.set $point_index (call $tth_pop))
        (local.set $other (global.get $tth_rp0))
        (if (i32.eqz (call $tth_relative_finish (local.get $point_index)
              (local.get $value) (i32.and (local.get $op) (i32.const 1))))
          (then (return (i32.const 0))))
        (global.set $tth_rp1 (local.get $other))
        (return (i32.const 1))))
    ;; SCFS sets the projected coordinate of zp2 point.
    (if (i32.eq (local.get $op) (i32.const 0x48))
      (then
        (local.set $value (call $tth_pop))
        (local.set $point_index (call $tth_pop))
        (local.set $current (call $tth_dot
          (call $tth_point_current_x (global.get $tth_zp2) (local.get $point_index))
          (call $tth_point_current_y (global.get $tth_zp2) (local.get $point_index))
          (global.get $tth_pvx) (global.get $tth_pvy)))
        (return (call $tth_move_projection
          (call $tth_point (global.get $tth_zp2) (local.get $point_index))
          (i32.sub (local.get $value) (local.get $current))))))
    ;; GC[0/1].
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x46))
          (i32.eq (local.get $op) (i32.const 0x47)))
      (then
        (local.set $point_index (call $tth_pop))
        (if (i32.and (local.get $op) (i32.const 1))
          (then (local.set $value (call $tth_dot
            (call $tth_point_original_x (global.get $tth_zp2) (local.get $point_index))
            (call $tth_point_original_y (global.get $tth_zp2) (local.get $point_index))
            (global.get $tth_dvx) (global.get $tth_dvy))))
          (else (local.set $value (call $tth_dot
            (call $tth_point_current_x (global.get $tth_zp2) (local.get $point_index))
            (call $tth_point_current_y (global.get $tth_zp2) (local.get $point_index))
            (global.get $tth_pvx) (global.get $tth_pvy)))))
        (return (call $tth_push (local.get $value)))))
    ;; MD[0/1].
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x49))
          (i32.eq (local.get $op) (i32.const 0x4A)))
      (then
        (local.set $point_index (call $tth_pop))
        (local.set $other (call $tth_pop))
        (if (i32.and (local.get $op) (i32.const 1))
          (then (local.set $value (call $tth_project_original
            (global.get $tth_zp0) (local.get $other)
            (global.get $tth_zp1) (local.get $point_index))))
          (else (local.set $value (call $tth_project_current
            (global.get $tth_zp0) (local.get $other)
            (global.get $tth_zp1) (local.get $point_index)))))
        (return (call $tth_push (local.get $value)))))
    (call $tth_fail (i32.const 6)))

  ;; Shift one point by the displacement of rp1/rp2 selected by opcode bit 0.
  (func $tth_shift_one (param $zone i32) (param $point_index i32) (result i32)
    (local $ref_zone i32) (local $ref_index i32) (local $distance i32)
    (local.set $ref_zone (select (global.get $tth_zp0) (global.get $tth_zp1)
      (i32.and (global.get $tth_opcode) (i32.const 1))))
    (local.set $ref_index (select (global.get $tth_rp1) (global.get $tth_rp2)
      (i32.and (global.get $tth_opcode) (i32.const 1))))
    (local.set $distance (call $tth_project_current (local.get $ref_zone)
      (local.get $ref_index) (local.get $ref_zone) (local.get $ref_index)))
    ;; displacement is current minus original under the current projection.
    (local.set $distance (i32.sub
      (call $tth_dot
        (call $tth_point_current_x (local.get $ref_zone) (local.get $ref_index))
        (call $tth_point_current_y (local.get $ref_zone) (local.get $ref_index))
        (global.get $tth_pvx) (global.get $tth_pvy))
      (call $tth_dot
        (call $tth_point_original_x (local.get $ref_zone) (local.get $ref_index))
        (call $tth_point_original_y (local.get $ref_zone) (local.get $ref_index))
        (global.get $tth_dvx) (global.get $tth_dvy))))
    (call $tth_move_freedom (call $tth_point (local.get $zone)
      (local.get $point_index)) (local.get $distance)))

  (func $tth_op_shift (result i32)
    (local $op i32) (local $count i32) (local $index i32)
    (local $contour i32) (local $start i32) (local $end i32)
    (local $ref_zone i32) (local $ref_index i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x32))
          (i32.eq (local.get $op) (i32.const 0x33)))
      (then
        (local.set $count (global.get $tth_loop))
        (block $done (loop $points
          (br_if $done (i32.eqz (local.get $count)))
          (drop (call $tth_shift_one (global.get $tth_zp2) (call $tth_pop)))
          (local.set $count (i32.sub (local.get $count) (i32.const 1)))
          (br $points)))
        (global.set $tth_loop (i32.const 1))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x38))
      (then
        (local.set $contour (call $tth_pop)) ;; pixel distance
        (local.set $count (global.get $tth_loop))
        (block $done2 (loop $pixels
          (br_if $done2 (i32.eqz (local.get $count)))
          (local.set $index (call $tth_pop))
          (drop (call $tth_move_freedom
            (call $tth_point (global.get $tth_zp2) (local.get $index))
            (local.get $contour)))
          (local.set $count (i32.sub (local.get $count) (i32.const 1)))
          (br $pixels)))
        (global.set $tth_loop (i32.const 1))
        (return (i32.eqz (global.get $tth_error)))))
    ;; SHC shifts all points in a selected contour except the reference point.
    (local.set $contour (call $tth_pop))
    (local.set $index (i32.const 0))
    (local.set $start (i32.const 0))
    (block $found (loop $seek
      (br_if $found (i32.ge_u (local.get $index) (global.get $tth_real_count)))
      (if (i32.and (i32.load offset=16 (call $tth_point (i32.const 1)
              (local.get $index))) (global.get $TTH_P_END))
        (then
          (if (i32.eqz (local.get $contour))
            (then
              (local.set $end (local.get $index))
              (br $found)))
          (local.set $contour (i32.sub (local.get $contour) (i32.const 1)))
          (local.set $start (i32.add (local.get $index) (i32.const 1)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $seek)))
    (if (i32.lt_u (local.get $end) (local.get $start))
      (then (return (call $tth_fail (i32.const 4)))))
    (local.set $ref_zone (select (global.get $tth_zp0) (global.get $tth_zp1)
      (i32.and (local.get $op) (i32.const 1))))
    (local.set $ref_index (select (global.get $tth_rp1) (global.get $tth_rp2)
      (i32.and (local.get $op) (i32.const 1))))
    (local.set $index (local.get $start))
    (block $shift_done (loop $shift
      (br_if $shift_done (i32.gt_u (local.get $index) (local.get $end)))
      (if (i32.or (i32.ne (local.get $ref_zone) (i32.const 1))
            (i32.ne (local.get $index) (local.get $ref_index)))
        (then (drop (call $tth_shift_one (i32.const 1) (local.get $index)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $shift)))
    (i32.eqz (global.get $tth_error)))

  (func $tth_op_alignrp (result i32)
    (local $count i32) (local $point_index i32) (local $distance i32)
    (local.set $count (global.get $tth_loop))
    (block $done (loop $align
      (br_if $done (i32.eqz (local.get $count)))
      (local.set $point_index (call $tth_pop))
      (local.set $distance (call $tth_project_current (global.get $tth_zp1)
        (local.get $point_index) (global.get $tth_zp0) (global.get $tth_rp0)))
      (drop (call $tth_move_projection
        (call $tth_point (global.get $tth_zp1) (local.get $point_index))
        (i32.sub (i32.const 0) (local.get $distance))))
      (local.set $count (i32.sub (local.get $count) (i32.const 1)))
      (br $align)))
    (global.set $tth_loop (i32.const 1))
    (i32.eqz (global.get $tth_error)))

  ;; Delta exceptions are intentionally applied after the normal movement
  ;; instructions; the ppem selector and signed nibble are defined by the
  ;; Apple/Microsoft instruction tables.
  (func $tth_op_delta (result i32)
    (local $op i32) (local $count i32) (local $arg i32) (local $index i32)
    (local $target i32) (local $step i32) (local $band i32)
    (local.set $op (global.get $tth_opcode))
    (local.set $count (call $tth_pop))
    (local.set $band (i32.const 0))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x71))
          (i32.eq (local.get $op) (i32.const 0x74)))
      (then (local.set $band (i32.const 16))))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x72))
          (i32.eq (local.get $op) (i32.const 0x75)))
      (then (local.set $band (i32.const 32))))
    (block $done (loop $deltas
      (br_if $done (i32.eqz (local.get $count)))
      (local.set $index (call $tth_pop))
      (local.set $arg (call $tth_pop))
      (local.set $target (i32.add (global.get $tth_delta_base)
        (i32.add (local.get $band) (i32.shr_u (local.get $arg) (i32.const 4)))))
      (if (i32.eq (local.get $target) (global.get $tth_ppem))
        (then
          (local.set $step (i32.and (local.get $arg) (i32.const 15)))
          (local.set $step (select (i32.sub (local.get $step) (i32.const 7))
            (i32.sub (local.get $step) (i32.const 8))
            (i32.ge_u (local.get $step) (i32.const 8))))
          (local.set $step (i32.mul (local.get $step)
            (i32.shr_u (i32.const 64) (global.get $tth_delta_shift))))
          (if (i32.le_u (local.get $op) (i32.const 0x72))
            (then (drop (call $tth_move_freedom
              (call $tth_point (global.get $tth_zp0) (local.get $index))
              (local.get $step))))
            (else (drop (call $tth_cvt_set (local.get $index)
              (i32.add (call $tth_cvt_get (local.get $index))
                (local.get $step))))))))
      (local.set $count (i32.sub (local.get $count) (i32.const 1)))
      (br $deltas)))
    (i32.eqz (global.get $tth_error)))

  (func $tth_op_flip (result i32)
    (local $op i32) (local $count i32) (local $lo i32) (local $hi i32)
    (local $index i32) (local $point i32) (local $flags i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.eq (local.get $op) (i32.const 0x80))
      (then
        (local.set $count (global.get $tth_loop))
        (local.set $lo (i32.const -1)) (local.set $hi (i32.const -1)))
      (else
        (local.set $hi (call $tth_pop))
        (local.set $lo (call $tth_pop))
        (local.set $count (i32.add (i32.sub (local.get $hi) (local.get $lo))
          (i32.const 1)))))
    (block $done (loop $flip
      (br_if $done (i32.eqz (local.get $count)))
      (local.set $index (select (call $tth_pop) (local.get $lo)
        (i32.eq (local.get $op) (i32.const 0x80))))
      (local.set $point (call $tth_point (global.get $tth_zp0) (local.get $index)))
      (local.set $flags (i32.load offset=16 (local.get $point)))
      (if (i32.eq (local.get $op) (i32.const 0x81))
        (then (local.set $flags (i32.or (local.get $flags)
          (global.get $TTH_P_ON_CURVE))))
        (else (if (i32.eq (local.get $op) (i32.const 0x82))
          (then (local.set $flags (i32.and (local.get $flags) (i32.const -2))))
          (else (local.set $flags (i32.xor (local.get $flags)
            (global.get $TTH_P_ON_CURVE)))))))
      (i32.store offset=16 (local.get $point) (local.get $flags))
      (local.set $lo (i32.add (local.get $lo) (i32.const 1)))
      (local.set $count (i32.sub (local.get $count) (i32.const 1)))
      (br $flip)))
    (global.set $tth_loop (i32.const 1))
    (i32.eqz (global.get $tth_error)))

  (func $tth_op_ip (result i32)
    (local $count i32) (local $point_index i32)
    (local $old_range i32) (local $new_range i32) (local $old_offset i32)
    (local $new_offset i32) (local $current i32)
    (local.set $old_range (call $tth_project_original (global.get $tth_zp1)
      (global.get $tth_rp2) (global.get $tth_zp0) (global.get $tth_rp1)))
    (local.set $new_range (call $tth_project_current (global.get $tth_zp1)
      (global.get $tth_rp2) (global.get $tth_zp0) (global.get $tth_rp1)))
    (local.set $count (global.get $tth_loop))
    (block $done (loop $points
      (br_if $done (i32.eqz (local.get $count)))
      (local.set $point_index (call $tth_pop))
      (local.set $old_offset (call $tth_project_original (global.get $tth_zp2)
        (local.get $point_index) (global.get $tth_zp0) (global.get $tth_rp1)))
      (local.set $new_offset (i32.const 0))
      (if (i32.ne (local.get $old_range) (i32.const 0))
        (then (local.set $new_offset (call $gdi_round_ratio
          (i64.mul (i64.extend_i32_s (local.get $old_offset))
            (i64.extend_i32_s (local.get $new_range)))
          (i64.extend_i32_s (local.get $old_range))))))
      (local.set $current (call $tth_project_current (global.get $tth_zp2)
        (local.get $point_index) (global.get $tth_zp0) (global.get $tth_rp1)))
      (drop (call $tth_move_projection
        (call $tth_point (global.get $tth_zp2) (local.get $point_index))
        (i32.sub (local.get $new_offset) (local.get $current))))
      (local.set $count (i32.sub (local.get $count) (i32.const 1)))
      (br $points)))
    (global.set $tth_loop (i32.const 1))
    (i32.eqz (global.get $tth_error)))

  (func $tth_axis_original (param $point i32) (param $axis i32) (result i32)
    (select (i32.load offset=12 (local.get $point))
      (i32.load offset=8 (local.get $point)) (local.get $axis)))

  (func $tth_axis_current (param $point i32) (param $axis i32) (result i32)
    (select (i32.load offset=4 (local.get $point))
      (i32.load (local.get $point)) (local.get $axis)))

  (func $tth_axis_set (param $point i32) (param $axis i32) (param $value i32)
    (if (local.get $axis)
      (then (i32.store offset=4 (local.get $point) (local.get $value)))
      (else (i32.store (local.get $point) (local.get $value)))))

  (func $tth_axis_touched (param $point i32) (param $axis i32) (result i32)
    (i32.and (i32.load offset=16 (local.get $point))
      (select (global.get $TTH_P_TOUCH_Y) (global.get $TTH_P_TOUCH_X)
        (local.get $axis))))

  ;; Interpolate a single untouched coordinate between two touched points.
  ;; Outside the original interval it inherits the nearer endpoint's shift.
  (func $tth_iup_one (param $point_index i32) (param $ref1 i32)
        (param $ref2 i32) (param $axis i32)
    (local $p i32) (local $a i32) (local $b i32)
    (local $op i32) (local $oa i32) (local $ob i32)
    (local $ca i32) (local $cb i32) (local $value i32)
    (local.set $p (call $tth_point (i32.const 1) (local.get $point_index)))
    (local.set $a (call $tth_point (i32.const 1) (local.get $ref1)))
    (local.set $b (call $tth_point (i32.const 1) (local.get $ref2)))
    (local.set $op (call $tth_axis_original (local.get $p) (local.get $axis)))
    (local.set $oa (call $tth_axis_original (local.get $a) (local.get $axis)))
    (local.set $ob (call $tth_axis_original (local.get $b) (local.get $axis)))
    (local.set $ca (call $tth_axis_current (local.get $a) (local.get $axis)))
    (local.set $cb (call $tth_axis_current (local.get $b) (local.get $axis)))
    (if (i32.gt_s (local.get $oa) (local.get $ob))
      (then
        (local.set $value (local.get $oa)) (local.set $oa (local.get $ob))
        (local.set $ob (local.get $value))
        (local.set $value (local.get $ca)) (local.set $ca (local.get $cb))
        (local.set $cb (local.get $value))))
    (if (i32.le_s (local.get $op) (local.get $oa))
      (then (local.set $value (i32.add (local.get $op)
        (i32.sub (local.get $ca) (local.get $oa)))))
      (else (if (i32.ge_s (local.get $op) (local.get $ob))
        (then (local.set $value (i32.add (local.get $op)
          (i32.sub (local.get $cb) (local.get $ob)))))
        (else
          (if (i32.eq (local.get $oa) (local.get $ob))
            (then (local.set $value (local.get $ca)))
            (else (local.set $value (i32.add (local.get $ca)
              (call $gdi_round_ratio
                (i64.mul (i64.extend_i32_s (i32.sub (local.get $op)
                    (local.get $oa)))
                  (i64.extend_i32_s (i32.sub (local.get $cb) (local.get $ca))))
                (i64.extend_i32_s (i32.sub (local.get $ob)
                  (local.get $oa))))))))))))
    (call $tth_axis_set (local.get $p) (local.get $axis) (local.get $value)))

  (func $tth_op_iup (result i32)
    (local $axis i32) (local $start i32) (local $end i32)
    (local $first i32) (local $ref1 i32) (local $ref2 i32)
    (local $index i32) (local $next i32) (local $p i32) (local $delta i32)
    ;; IUP[0] is y, IUP[1] is x; axis uses 0=x, 1=y.
    (local.set $axis (i32.xor (i32.and (global.get $tth_opcode)
      (i32.const 1)) (i32.const 1)))
    (block $all_done (loop $contours
      (br_if $all_done (i32.ge_u (local.get $start) (global.get $tth_real_count)))
      (local.set $end (local.get $start))
      (block $end_found (loop $find_end
        (local.set $p (call $tth_point (i32.const 1) (local.get $end)))
        (br_if $end_found (i32.and (i32.load offset=16 (local.get $p))
          (global.get $TTH_P_END)))
        (local.set $end (i32.add (local.get $end) (i32.const 1)))
        (br_if $find_end (i32.lt_u (local.get $end) (global.get $tth_real_count)))))
      (local.set $first (i32.const -1))
      (local.set $index (local.get $start))
      (block $touch_done (loop $find_touch
        (br_if $touch_done (i32.gt_u (local.get $index) (local.get $end)))
        (if (call $tth_axis_touched (call $tth_point (i32.const 1)
              (local.get $index)) (local.get $axis))
          (then (local.set $first (local.get $index)) (br $touch_done)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $find_touch)))
      (if (i32.ge_s (local.get $first) (i32.const 0))
        (then
          (local.set $ref1 (local.get $first))
          (block $segments_done (loop $segments
            (local.set $ref2 (local.get $ref1))
            (block $next_touch (loop $seek_touch
              (local.set $ref2 (select (local.get $start)
                (i32.add (local.get $ref2) (i32.const 1))
                (i32.eq (local.get $ref2) (local.get $end))))
              (br_if $next_touch (call $tth_axis_touched
                (call $tth_point (i32.const 1) (local.get $ref2))
                (local.get $axis)))
              (br $seek_touch)))
            (if (i32.eq (local.get $ref2) (local.get $ref1))
              (then
                ;; Only one touched point: translate the entire contour by it.
                (local.set $delta (i32.sub
                  (call $tth_axis_current (call $tth_point (i32.const 1)
                    (local.get $ref1)) (local.get $axis))
                  (call $tth_axis_original (call $tth_point (i32.const 1)
                    (local.get $ref1)) (local.get $axis))))
                (local.set $index (local.get $start))
                (block $one_done (loop $one
                  (br_if $one_done (i32.gt_u (local.get $index) (local.get $end)))
                  (if (i32.ne (local.get $index) (local.get $ref1))
                    (then
                      (local.set $p (call $tth_point (i32.const 1)
                        (local.get $index)))
                      (call $tth_axis_set (local.get $p) (local.get $axis)
                        (i32.add (call $tth_axis_original (local.get $p)
                          (local.get $axis)) (local.get $delta)))))
                  (local.set $index (i32.add (local.get $index) (i32.const 1)))
                  (br $one)))
                (br $segments_done)))
            (local.set $index (local.get $ref1))
            (block $between_done (loop $between
              (local.set $index (select (local.get $start)
                (i32.add (local.get $index) (i32.const 1))
                (i32.eq (local.get $index) (local.get $end))))
              (br_if $between_done (i32.eq (local.get $index) (local.get $ref2)))
              (call $tth_iup_one (local.get $index) (local.get $ref1)
                (local.get $ref2) (local.get $axis))
              (br $between)))
            (local.set $ref1 (local.get $ref2))
            (br_if $segments_done (i32.eq (local.get $ref1) (local.get $first)))
            (br $segments)))))
      (local.set $start (i32.add (local.get $end) (i32.const 1)))
      (br $contours)))
    (i32.eqz (global.get $tth_error)))

  (func $tth_op_isect (result i32)
    (local $b1 i32) (local $b0 i32) (local $a1 i32) (local $a0 i32)
    (local $target i32) (local $pa0 i32) (local $pa1 i32)
    (local $pb0 i32) (local $pb1 i32) (local $pt i32)
    (local $dax i32) (local $day i32) (local $dbx i32) (local $dby i32)
    (local $den i64) (local $num i64) (local $x i32) (local $y i32)
    (local.set $b1 (call $tth_pop)) (local.set $b0 (call $tth_pop))
    (local.set $a1 (call $tth_pop)) (local.set $a0 (call $tth_pop))
    (local.set $target (call $tth_pop))
    (local.set $pa0 (call $tth_point (global.get $tth_zp1) (local.get $a0)))
    (local.set $pa1 (call $tth_point (global.get $tth_zp1) (local.get $a1)))
    (local.set $pb0 (call $tth_point (global.get $tth_zp0) (local.get $b0)))
    (local.set $pb1 (call $tth_point (global.get $tth_zp0) (local.get $b1)))
    (local.set $pt (call $tth_point (global.get $tth_zp2) (local.get $target)))
    (if (global.get $tth_error) (then (return (i32.const 0))))
    (local.set $dax (i32.sub (i32.load (local.get $pa1))
      (i32.load (local.get $pa0))))
    (local.set $day (i32.sub (i32.load offset=4 (local.get $pa1))
      (i32.load offset=4 (local.get $pa0))))
    (local.set $dbx (i32.sub (i32.load (local.get $pb1))
      (i32.load (local.get $pb0))))
    (local.set $dby (i32.sub (i32.load offset=4 (local.get $pb1))
      (i32.load offset=4 (local.get $pb0))))
    (local.set $den (i64.sub
      (i64.mul (i64.extend_i32_s (local.get $dax))
        (i64.extend_i32_s (local.get $dby)))
      (i64.mul (i64.extend_i32_s (local.get $day))
        (i64.extend_i32_s (local.get $dbx)))))
    (if (i64.eqz (local.get $den))
      (then
        (local.set $x (i32.shr_s (i32.add (i32.add (i32.load (local.get $pa0))
          (i32.load (local.get $pa1))) (i32.add (i32.load (local.get $pb0))
          (i32.load (local.get $pb1)))) (i32.const 2)))
        (local.set $y (i32.shr_s (i32.add (i32.add
          (i32.load offset=4 (local.get $pa0)) (i32.load offset=4 (local.get $pa1)))
          (i32.add (i32.load offset=4 (local.get $pb0))
            (i32.load offset=4 (local.get $pb1)))) (i32.const 2))))
      (else
        (local.set $num (i64.sub
          (i64.mul (i64.extend_i32_s (i32.sub (i32.load (local.get $pb0))
              (i32.load (local.get $pa0)))) (i64.extend_i32_s (local.get $dby)))
          (i64.mul (i64.extend_i32_s (i32.sub (i32.load offset=4 (local.get $pb0))
              (i32.load offset=4 (local.get $pa0)))) (i64.extend_i32_s (local.get $dbx)))))
        (local.set $x (i32.add (i32.load (local.get $pa0))
          (call $gdi_round_ratio (i64.mul (i64.extend_i32_s (local.get $dax))
            (local.get $num)) (local.get $den))))
        (local.set $y (i32.add (i32.load offset=4 (local.get $pa0))
          (call $gdi_round_ratio (i64.mul (i64.extend_i32_s (local.get $day))
            (local.get $num)) (local.get $den))))))
    (i32.store (local.get $pt) (local.get $x))
    (i32.store offset=4 (local.get $pt) (local.get $y))
    (i32.store offset=16 (local.get $pt) (i32.or
      (i32.load offset=16 (local.get $pt)) (i32.const 12)))
    (i32.const 1))

  ;; ---- definitions, calls, and control flow --------------------------

  (func $tth_find_endf (param $start i32) (result i32)
    (local $scan i32) (local $op i32)
    (local.set $scan (local.get $start))
    (block $done (loop $walk
      (if (i32.ge_u (local.get $scan) (global.get $tth_program_len))
        (then (return (call $tth_fail (i32.const 6)))))
      (local.set $op (call $tth_byte (local.get $scan)))
      (br_if $done (i32.eq (local.get $op) (i32.const 0x2D)))
      (local.set $scan (call $tth_skip_one (local.get $scan)))
      (br $walk)))
    (local.get $scan))

  (func $tth_enter_call (param $function_id i32) (param $repeat i32) (result i32)
    (local $entry i32) (local $frame i32) (local $body i32) (local $length i32)
    (if (i32.or (i32.le_s (local.get $repeat) (i32.const 0))
          (i32.ge_u (local.get $function_id)
            (i32.load offset=24 (global.get $tth_sc))))
      (then (return (call $tth_fail (i32.const 7)))))
    (local.set $entry (i32.add (global.get $tth_sc)
      (i32.add (global.get $TTH_SC_FUNCTIONS)
        (i32.mul (local.get $function_id) (i32.const 8)))))
    (local.set $body (i32.load (local.get $entry)))
    (local.set $length (i32.load offset=4 (local.get $entry)))
    (if (i32.or (i32.eqz (local.get $body)) (i32.eqz (local.get $length)))
      (then (return (call $tth_fail (i32.const 7)))))
    (if (i32.ge_u (global.get $tth_call_top) (global.get $TTH_MAX_CALLS))
      (then (return (call $tth_fail (i32.const 7)))))
    (local.set $frame (i32.add (global.get $tth_calls)
      (i32.mul (global.get $tth_call_top) (i32.const 24))))
    (i32.store (local.get $frame) (global.get $tth_program))
    (i32.store offset=4 (local.get $frame) (global.get $tth_program_len))
    (i32.store offset=8 (local.get $frame) (global.get $tth_pc))
    (i32.store offset=12 (local.get $frame) (local.get $repeat))
    (i32.store offset=16 (local.get $frame) (local.get $body))
    (i32.store offset=20 (local.get $frame) (local.get $length))
    (global.set $tth_call_top (i32.add (global.get $tth_call_top) (i32.const 1)))
    (global.set $tth_program (local.get $body))
    (global.set $tth_program_len (local.get $length))
    (global.set $tth_pc (i32.const 0))
    (i32.const 1))

  (func $tth_leave_call (result i32)
    (local $frame i32) (local $repeat i32)
    (if (i32.eqz (global.get $tth_call_top))
      (then (return (call $tth_fail (i32.const 7)))))
    (local.set $frame (i32.add (global.get $tth_calls)
      (i32.mul (i32.sub (global.get $tth_call_top) (i32.const 1))
        (i32.const 24))))
    (local.set $repeat (i32.load offset=12 (local.get $frame)))
    (if (i32.gt_s (local.get $repeat) (i32.const 1))
      (then
        (i32.store offset=12 (local.get $frame)
          (i32.sub (local.get $repeat) (i32.const 1)))
        (global.set $tth_program (i32.load offset=16 (local.get $frame)))
        (global.set $tth_program_len (i32.load offset=20 (local.get $frame)))
        (global.set $tth_pc (i32.const 0))
        (return (i32.const 1))))
    (global.set $tth_program (i32.load (local.get $frame)))
    (global.set $tth_program_len (i32.load offset=4 (local.get $frame)))
    (global.set $tth_pc (i32.load offset=8 (local.get $frame)))
    (global.set $tth_call_top (i32.sub (global.get $tth_call_top) (i32.const 1)))
    (i32.const 1))

  (func $tth_op_flow (result i32)
    (local $op i32) (local $a i32) (local $b i32) (local $end i32)
    (local $entry i32)
    (local.set $op (global.get $tth_opcode))
    (if (i32.eq (local.get $op) (i32.const 0x1B))
      (then (return (call $tth_skip_conditional (i32.const 0)))))
    (if (i32.eq (local.get $op) (i32.const 0x1C))
      (then
        (local.set $a (call $tth_pop))
        (if (i32.or (i32.lt_s (i32.add (i32.sub (global.get $tth_pc)
                (i32.const 1)) (local.get $a))
              (i32.const 0))
              (i32.gt_u (i32.add (i32.sub (global.get $tth_pc)
                  (i32.const 1)) (local.get $a))
                (global.get $tth_program_len)))
          (then (return (call $tth_fail (i32.const 6)))))
        (global.set $tth_pc (i32.add (i32.sub (global.get $tth_pc)
          (i32.const 1)) (local.get $a)))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $op) (i32.const 0x2A))
      (then
        (local.set $a (call $tth_pop)) ;; function
        (local.set $b (call $tth_pop)) ;; repeat count
        (return (call $tth_enter_call (local.get $a) (local.get $b)))))
    (if (i32.eq (local.get $op) (i32.const 0x2B))
      (then (return (call $tth_enter_call (call $tth_pop) (i32.const 1)))))
    (if (i32.eq (local.get $op) (i32.const 0x2C))
      (then
        (if (i32.ne (global.get $tth_phase) (i32.const 0))
          (then (return (call $tth_fail (i32.const 7)))))
        (local.set $a (call $tth_pop))
        (if (i32.ge_u (local.get $a) (i32.load offset=24 (global.get $tth_sc)))
          (then (return (call $tth_fail (i32.const 7)))))
        (local.set $end (call $tth_find_endf (global.get $tth_pc)))
        (if (global.get $tth_error) (then (return (i32.const 0))))
        (local.set $entry (i32.add (global.get $tth_sc)
          (i32.add (global.get $TTH_SC_FUNCTIONS)
            (i32.mul (local.get $a) (i32.const 8)))))
        (i32.store (local.get $entry)
          (i32.add (global.get $tth_program) (global.get $tth_pc)))
        (i32.store offset=4 (local.get $entry)
          (i32.sub (local.get $end) (global.get $tth_pc)))
        (global.set $tth_pc (i32.add (local.get $end) (i32.const 1)))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x2D))
      (then (return (call $tth_leave_call))))
    (if (i32.eq (local.get $op) (i32.const 0x58))
      (then
        (local.set $a (call $tth_pop))
        (if (i32.eqz (local.get $a))
          (then (return (call $tth_skip_conditional (i32.const 1)))))
        (return (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 0x59))
      (then (return (i32.const 1))))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x78))
          (i32.eq (local.get $op) (i32.const 0x79)))
      (then
        (local.set $a (call $tth_pop)) ;; condition
        (local.set $b (call $tth_pop)) ;; relative offset
        (if (i32.eq (i32.ne (local.get $a) (i32.const 0))
              (i32.eq (local.get $op) (i32.const 0x78)))
          (then
            (if (i32.or (i32.lt_s (i32.add (i32.sub (global.get $tth_pc)
                    (i32.const 1)) (local.get $b))
                  (i32.const 0))
                  (i32.gt_u (i32.add (i32.sub (global.get $tth_pc)
                      (i32.const 1)) (local.get $b))
                    (global.get $tth_program_len)))
              (then (return (call $tth_fail (i32.const 6)))))
            (global.set $tth_pc (i32.add (i32.sub (global.get $tth_pc)
              (i32.const 1)) (local.get $b)))))
        (return (i32.eqz (global.get $tth_error)))))
    ;; IDEF is intentionally rejected: the measured Win98 fonts declare zero
    ;; instruction definitions, and accepting it would let fonts replace the
    ;; bounded dispatcher semantics.
    (call $tth_fail (i32.const 6)))

  ;; A dense high-nibble br_table keeps the runtime dispatch predictable while
  ;; each family handler retains the opcode bits used by bracketed variants.
  ;; Undefined opcodes fault the current program and trigger unhinted fallback.
  (func $tth_dispatch (result i32)
    (local $family i32) (local $op i32)
    (local.set $op (global.get $tth_opcode))
    (block $selected
      (block $cf
        (block $ce
          (block $cd
            (block $cc
              (block $cb
                (block $ca
                  (block $c9
                    (block $c8
                      (block $c7
                        (block $c6
                          (block $c5
                            (block $c4
                              (block $c3
                                (block $c2
                                  (block $c1
                                    (block $c0
                                      (br_table $c0 $c1 $c2 $c3 $c4 $c5 $c6 $c7
                                        $c8 $c9 $ca $cb $cc $cd $ce $cf $cf
                                        (i32.shr_u (local.get $op) (i32.const 4))))
                                    (local.set $family (i32.const 0))
                                    (br $selected))
                                  (local.set $family (i32.const 1))
                                  (br $selected))
                                (local.set $family (i32.const 2))
                                (br $selected))
                              (local.set $family (i32.const 3))
                              (br $selected))
                            (local.set $family (i32.const 4))
                            (br $selected))
                          (local.set $family (i32.const 5))
                          (br $selected))
                        (local.set $family (i32.const 6))
                        (br $selected))
                      (local.set $family (i32.const 7))
                      (br $selected))
                    (local.set $family (i32.const 8))
                    (br $selected))
                  (local.set $family (i32.const 9))
                  (br $selected))
                (local.set $family (i32.const 10))
                (br $selected))
              (local.set $family (i32.const 11))
              (br $selected))
            (local.set $family (i32.const 12))
            (br $selected))
          (local.set $family (i32.const 13))
          (br $selected))
        (local.set $family (i32.const 14))
        (br $selected))
      (local.set $family (i32.const 15)))

    (if (i32.eqz (local.get $family))
      (then
        (if (i32.eq (local.get $op) (i32.const 0x0F))
          (then (return (call $tth_op_isect))))
        (return (call $tth_op_vector))))
    (if (i32.eq (local.get $family) (i32.const 1))
      (then
        (if (i32.or (i32.eq (local.get $op) (i32.const 0x1B))
              (i32.eq (local.get $op) (i32.const 0x1C)))
          (then (return (call $tth_op_flow))))
        (return (call $tth_op_state))))
    (if (i32.eq (local.get $family) (i32.const 2))
      (then
        (if (i32.le_u (local.get $op) (i32.const 0x26))
          (then (return (call $tth_op_stack))))
        (if (i32.or (i32.eq (local.get $op) (i32.const 0x27))
              (i32.eq (local.get $op) (i32.const 0x29)))
          (then (return (call $tth_op_direct_point))))
        (if (i32.ge_u (local.get $op) (i32.const 0x2E))
          (then (return (call $tth_op_direct_point))))
        (if (i32.ge_u (local.get $op) (i32.const 0x2A))
          (then (return (call $tth_op_flow))))
        (return (call $tth_fail (i32.const 6)))))
    (if (i32.eq (local.get $family) (i32.const 3))
      (then
        (if (i32.le_u (local.get $op) (i32.const 0x31))
          (then (return (call $tth_op_iup))))
        (if (i32.le_u (local.get $op) (i32.const 0x38))
          (then (return (call $tth_op_shift))))
        (if (i32.eq (local.get $op) (i32.const 0x39))
          (then (return (call $tth_op_ip))))
        (if (i32.or (i32.le_u (local.get $op) (i32.const 0x3B))
              (i32.ge_u (local.get $op) (i32.const 0x3E)))
          (then (return (call $tth_op_direct_point))))
        (if (i32.eq (local.get $op) (i32.const 0x3C))
          (then (return (call $tth_op_alignrp))))
        (return (call $tth_op_state))))
    (if (i32.eq (local.get $family) (i32.const 4))
      (then
        (if (i32.le_u (local.get $op) (i32.const 0x41))
          (then (return (call $tth_stream_push))))
        (if (i32.le_u (local.get $op) (i32.const 0x45))
          (then (return (call $tth_op_memory))))
        (if (i32.le_u (local.get $op) (i32.const 0x4A))
          (then (return (call $tth_op_direct_point))))
        (if (i32.le_u (local.get $op) (i32.const 0x4C))
          (then (return (call $tth_op_measure))))
        (if (i32.le_u (local.get $op) (i32.const 0x4E))
          (then (return (call $tth_op_state))))
        ;; DEBUG is specified as a no-op after consuming its selector.
        (drop (call $tth_pop))
        (return (i32.eqz (global.get $tth_error)))))
    (if (i32.eq (local.get $family) (i32.const 5))
      (then
        (if (i32.le_u (local.get $op) (i32.const 0x57))
          (then (return (call $tth_op_compare))))
        (if (i32.le_u (local.get $op) (i32.const 0x59))
          (then (return (call $tth_op_flow))))
        (if (i32.le_u (local.get $op) (i32.const 0x5C))
          (then (return (call $tth_op_logic))))
        (if (i32.eq (local.get $op) (i32.const 0x5D))
          (then (return (call $tth_op_delta))))
        (return (call $tth_op_state))))
    (if (i32.eq (local.get $family) (i32.const 6))
      (then (return (call $tth_op_math))))
    (if (i32.eq (local.get $family) (i32.const 7))
      (then
        (if (i32.eq (local.get $op) (i32.const 0x70))
          (then (return (call $tth_op_memory))))
        (if (i32.le_u (local.get $op) (i32.const 0x75))
          (then (return (call $tth_op_delta))))
        (if (i32.or (i32.le_u (local.get $op) (i32.const 0x77))
              (i32.ge_u (local.get $op) (i32.const 0x7A)))
          (then (return (call $tth_op_state))))
        (if (i32.le_u (local.get $op) (i32.const 0x79))
          (then (return (call $tth_op_flow))))
        (return (call $tth_fail (i32.const 6)))))
    (if (i32.eq (local.get $family) (i32.const 8))
      (then
        (if (i32.le_u (local.get $op) (i32.const 0x82))
          (then (return (call $tth_op_flip))))
        (if (i32.eq (local.get $op) (i32.const 0x85))
          (then (return (call $tth_op_state))))
        (if (i32.or (i32.eq (local.get $op) (i32.const 0x86))
              (i32.eq (local.get $op) (i32.const 0x87)))
          (then (return (call $tth_set_line_vector (i32.const 0)
            (i32.const 1) (i32.and (local.get $op) (i32.const 1))))))
        (if (i32.eq (local.get $op) (i32.const 0x88))
          (then (return (call $tth_op_measure))))
        (if (i32.eq (local.get $op) (i32.const 0x89))
          (then (return (call $tth_op_flow))))
        (if (i32.eq (local.get $op) (i32.const 0x8A))
          (then (return (call $tth_op_stack))))
        (if (i32.le_u (local.get $op) (i32.const 0x8C))
          (then (return (call $tth_op_math))))
        (if (i32.le_u (local.get $op) (i32.const 0x8E))
          (then (return (call $tth_op_state))))
        (return (call $tth_fail (i32.const 6)))))
    (if (i32.eq (local.get $family) (i32.const 11))
      (then (return (call $tth_stream_push))))
    (if (i32.ge_u (local.get $family) (i32.const 12))
      (then (return (call $tth_op_relative))))
    (call $tth_fail (i32.const 6)))

  (func $tth_run (param $program i32) (param $length i32)
        (param $phase i32) (result i32)
    (global.set $tth_program (local.get $program))
    (global.set $tth_program_len (local.get $length))
    (global.set $tth_phase (local.get $phase))
    (global.set $tth_pc (i32.const 0))
    (global.set $tth_steps (i32.const 0))
    (global.set $tth_error (i32.const 0))
    (global.set $tth_stack_top (i32.const 0))
    (global.set $tth_call_top (i32.const 0))
    (block $done (loop $execute
      (if (i32.ge_u (global.get $tth_pc) (global.get $tth_program_len))
        (then
          (if (i32.eqz (global.get $tth_call_top)) (then (br $done)))
          (drop (call $tth_leave_call))
          (br_if $done (global.get $tth_error))
          (br $execute)))
      (if (i32.ge_u (global.get $tth_steps) (global.get $TTH_MAX_STEPS))
        (then (drop (call $tth_fail (i32.const 8))) (br $done)))
      (global.set $tth_steps (i32.add (global.get $tth_steps) (i32.const 1)))
      (global.set $tth_opcode (call $tth_byte (global.get $tth_pc)))
      (global.set $tth_pc (i32.add (global.get $tth_pc) (i32.const 1)))
      (drop (call $tth_dispatch))
      (br_if $done (global.get $tth_error))
      (br $execute)))
    (i32.eqz (global.get $tth_error)))

  ;; ---- face/size and glyph lifetime -----------------------------------

  (func $tth_maxp_u16 (param $data i32) (param $size i32) (param $field i32)
        (result i32)
    (local $maxp i32)
    (local.set $maxp (call $tt_table_off (local.get $data) (local.get $size)
      (i32.const 0x6D617870)))
    (if (i32.eqz (local.get $maxp)) (then (return (i32.const 0))))
    (call $tt_u16 (local.get $data) (local.get $size)
      (i32.add (local.get $maxp) (local.get $field))))

  (func $tth_prepare_arena
    (local $arena i32)
    (local.set $arena (call $g2w (global.get $tth_arena_guest)))
    (global.set $tth_points (local.get $arena))
    (global.set $tth_stack (i32.add (local.get $arena) (i32.const 0x3000)))
    (global.set $tth_calls (i32.add (local.get $arena) (i32.const 0x5000)))
    (global.set $tth_temp (i32.add (local.get $arena) (i32.const 0x5F00))))

  (func $tth_find_size (param $data i32) (param $size i32) (param $ppem i32)
        (result i32)
    (local $root i32) (local $slot i32) (local $base i32)
    (if (i32.eqz (call $tth_alloc_roots)) (then (return (i32.const 0))))
    (local.set $root (call $g2w (global.get $tth_sizes_guest)))
    (block $missing (loop $scan
      (br_if $missing (i32.ge_u (local.get $slot) (global.get $TTH_SIZE_SLOTS)))
      (local.set $base (i32.add (local.get $root)
        (i32.mul (local.get $slot) (global.get $TTH_SIZE_STRIDE))))
      (if (i32.and (i32.and
              (i32.eq (i32.load offset=0 (local.get $base)) (local.get $data))
              (i32.eq (i32.load offset=4 (local.get $base)) (local.get $size)))
            (i32.eq (i32.load offset=8 (local.get $base)) (local.get $ppem)))
        (then (return (local.get $base))))
      (local.set $slot (i32.add (local.get $slot) (i32.const 1)))
      (br $scan)))
    (local.set $slot (global.get $tth_next_size_slot))
    (global.set $tth_next_size_slot (i32.rem_u
      (i32.add (local.get $slot) (i32.const 1)) (global.get $TTH_SIZE_SLOTS)))
    (local.set $base (i32.add (local.get $root)
      (i32.mul (local.get $slot) (global.get $TTH_SIZE_STRIDE))))
    (memory.fill (local.get $base) (i32.const 0) (global.get $TTH_SIZE_STRIDE))
    (i32.store offset=0 (local.get $base) (local.get $data))
    (i32.store offset=4 (local.get $base) (local.get $size))
    (i32.store offset=8 (local.get $base) (local.get $ppem))
    (local.get $base))

  (func $tth_init_size (param $data i32) (param $size i32) (param $ppem i32)
        (result i32)
    (local $base i32) (local $upem i32) (local $off i32) (local $length i32)
    (local $index i32) (local $count i32) (local $value i32)
    (local.set $base (call $tth_find_size (local.get $data) (local.get $size)
      (local.get $ppem)))
    (if (i32.eqz (local.get $base)) (then (return (i32.const 0))))
    (if (i32.eq (i32.load offset=12 (local.get $base)) (i32.const 1))
      (then (return (local.get $base))))
    (if (i32.eq (i32.load offset=12 (local.get $base)) (i32.const -1))
      (then (return (i32.const 0))))
    (local.set $upem (call $tt_units_per_em (local.get $data) (local.get $size)))
    (if (i32.or (i32.eqz (local.get $upem)) (i32.le_s (local.get $ppem)
          (i32.const 0)))
      (then (i32.store offset=12 (local.get $base) (i32.const -1))
        (return (i32.const 0))))
    (global.set $tth_sc (local.get $base))
    (global.set $tth_ppem (local.get $ppem))
    (global.set $tth_upem (local.get $upem))
    (call $tth_prepare_arena)
    (global.set $tth_real_count (i32.const 0))
    (global.set $tth_point_count (i32.const 0))

    (local.set $count (call $tth_clamp_declared
      (i32.add (call $tth_maxp_u16 (local.get $data) (local.get $size)
        (i32.const 20)) (i32.const 1)) (global.get $TTH_MAX_FUNCTIONS)))
    (i32.store offset=24 (local.get $base) (local.get $count))
    (local.set $count (call $tth_clamp_declared
      (call $tth_maxp_u16 (local.get $data) (local.get $size) (i32.const 18))
      (global.get $TTH_MAX_STORAGE)))
    (i32.store offset=20 (local.get $base) (local.get $count))
    (local.set $count (call $tth_clamp_declared
      (i32.add (call $tth_maxp_u16 (local.get $data) (local.get $size)
        (i32.const 16)) (i32.const 4)) (global.get $TTH_MAX_TWILIGHT)))
    (i32.store offset=28 (local.get $base) (local.get $count))

    ;; Scale every signed CVT font-unit value once for this ppem.
    (local.set $off (call $tt_table_off (local.get $data) (local.get $size)
      (i32.const 0x63767420)))
    (local.set $length (call $tt_table_len (local.get $data) (local.get $size)
      (i32.const 0x63767420)))
    (local.set $count (call $tth_min (i32.shr_u (local.get $length) (i32.const 1))
      (global.get $TTH_MAX_CVT)))
    (i32.store offset=16 (local.get $base) (local.get $count))
    (block $cvt_done (loop $cvt
      (br_if $cvt_done (i32.ge_u (local.get $index) (local.get $count)))
      (local.set $value (call $tt_fu_to_26_6
        (call $tt_s16 (local.get $data) (local.get $size)
          (i32.add (local.get $off) (i32.shl (local.get $index) (i32.const 1))))
        (local.get $ppem) (local.get $upem)))
      (i32.store (i32.add (local.get $base) (i32.add (global.get $TTH_SC_CVT)
          (i32.shl (local.get $index) (i32.const 2)))) (local.get $value))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $cvt)))

    (call $tth_gs_defaults)
    (local.set $off (call $tt_table_off (local.get $data) (local.get $size)
      (i32.const 0x6670676D)))
    (local.set $length (call $tt_table_len (local.get $data) (local.get $size)
      (i32.const 0x6670676D)))
    (if (local.get $length)
      (then
        (if (i32.eqz (call $tth_run (i32.add (local.get $data) (local.get $off))
              (local.get $length) (i32.const 0)))
          (then (i32.store offset=12 (local.get $base) (i32.const -1))
            (return (i32.const 0))))))
    ;; prep starts from the default graphics state and leaves the per-size
    ;; template copied into every subsequent glyph execution.
    (call $tth_gs_defaults)
    (local.set $off (call $tt_table_off (local.get $data) (local.get $size)
      (i32.const 0x70726570)))
    (local.set $length (call $tt_table_len (local.get $data) (local.get $size)
      (i32.const 0x70726570)))
    (if (local.get $length)
      (then
        (if (i32.eqz (call $tth_run (i32.add (local.get $data) (local.get $off))
              (local.get $length) (i32.const 1)))
          (then (i32.store offset=12 (local.get $base) (i32.const -1))
            (return (i32.const 0))))))
    (call $tth_gs_save (local.get $base))
    (i32.store offset=32 (local.get $base) (global.get $tth_scan_control))
    (i32.store offset=36 (local.get $base) (global.get $tth_scan_type))
    (i32.store offset=40 (local.get $base) (global.get $tth_inst_control))
    (i32.store offset=12 (local.get $base) (i32.const 1))
    (local.get $base))

  ;; Locate the instruction bytes after a simple glyph's end-point array, or
  ;; after the final component record of a composite glyph.
  (func $tth_glyph_program (param $data i32) (param $size i32) (param $gid i32)
        (result i32)
    (local $record i32) (local $contours i32) (local $cursor i32)
    (local $flags i32) (local $length i32)
    (global.set $tth_program_len (i32.const 0))
    (local.set $record (call $tt_glyph_offset (local.get $data) (local.get $size)
      (local.get $gid)))
    (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
    (local.set $contours (call $tt_glyph_num_contours (local.get $data)
      (local.get $size) (local.get $gid)))
    (if (i32.ge_s (local.get $contours) (i32.const 0))
      (then
        (local.set $cursor (i32.add (local.get $record)
          (i32.add (i32.const 10) (i32.mul (local.get $contours) (i32.const 2)))))
        (local.set $length (call $tt_u16 (local.get $data) (local.get $size)
          (local.get $cursor)))
        (local.set $cursor (i32.add (local.get $cursor) (i32.const 2))))
      (else
        (local.set $cursor (i32.add (local.get $record) (i32.const 10)))
        (block $parts_done (loop $parts
          (local.set $flags (call $tt_u16 (local.get $data) (local.get $size)
            (local.get $cursor)))
          (local.set $cursor (i32.add (local.get $cursor) (i32.const 4)))
          (local.set $cursor (i32.add (local.get $cursor)
            (select (i32.const 4) (i32.const 2)
              (i32.and (local.get $flags) (i32.const 1)))))
          (if (i32.and (local.get $flags) (i32.const 8))
            (then (local.set $cursor (i32.add (local.get $cursor) (i32.const 2))))
            (else (if (i32.and (local.get $flags) (i32.const 0x40))
              (then (local.set $cursor (i32.add (local.get $cursor) (i32.const 4))))
              (else (if (i32.and (local.get $flags) (i32.const 0x80))
                (then (local.set $cursor
                  (i32.add (local.get $cursor) (i32.const 8)))))))))
          (br_if $parts_done
            (i32.eqz (i32.and (local.get $flags) (i32.const 0x20))))
          (br $parts)))
        (if (i32.and (local.get $flags) (i32.const 0x100))
          (then
            (local.set $length (call $tt_u16 (local.get $data) (local.get $size)
              (local.get $cursor)))
            (local.set $cursor (i32.add (local.get $cursor) (i32.const 2)))))))
    (if (i32.gt_u (local.get $length)
          (i32.sub (local.get $size) (local.get $cursor)))
      (then (return (i32.const 0))))
    (global.set $tth_program_len (local.get $length))
    (select (i32.add (local.get $data) (local.get $cursor)) (i32.const 0)
      (i32.ne (local.get $length) (i32.const 0))))

  (func $tth_load_outline (param $data i32) (param $size i32) (param $gid i32)
        (param $compact i32) (param $count i32) (result i32)
    (local $index i32) (local $point i32) (local $x i32) (local $y i32)
    (local $flags i32) (local $left i32) (local $advance i32)
    (if (i32.gt_u (i32.add (local.get $count) (i32.const 4))
          (global.get $TTH_MAX_POINTS))
      (then (return (call $tth_fail (i32.const 4)))))
    (global.set $tth_real_count (local.get $count))
    (global.set $tth_point_count (i32.add (local.get $count) (i32.const 4)))
    (block $done (loop $points
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (local.set $point (call $tth_point (i32.const 1) (local.get $index)))
      (local.set $x (call $tt_fu_to_26_6 (call $tt_point_x (local.get $compact)
        (local.get $index)) (global.get $tth_ppem) (global.get $tth_upem)))
      (local.set $y (call $tt_fu_to_26_6 (call $tt_point_y (local.get $compact)
        (local.get $index)) (global.get $tth_ppem) (global.get $tth_upem)))
      (local.set $flags (i32.or
        (select (global.get $TTH_P_ON_CURVE) (i32.const 0)
          (call $tt_point_on_curve (local.get $compact) (local.get $index)))
        (select (global.get $TTH_P_END) (i32.const 0)
          (call $tt_point_ends_contour (local.get $compact) (local.get $index)))))
      (i32.store offset=0 (local.get $point) (local.get $x))
      (i32.store offset=4 (local.get $point) (local.get $y))
      (i32.store offset=8 (local.get $point) (local.get $x))
      (i32.store offset=12 (local.get $point) (local.get $y))
      (i32.store offset=16 (local.get $point) (local.get $flags))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $points)))
    (local.set $left (call $tt_fu_to_26_6
      (i32.sub (call $tt_glyph_x_min (local.get $data) (local.get $size)
          (local.get $gid))
        (call $tt_lsb_fu (local.get $data) (local.get $size) (local.get $gid)))
      (global.get $tth_ppem) (global.get $tth_upem)))
    (local.set $advance (call $tt_fu_to_26_6
      (call $tt_advance_fu (local.get $data) (local.get $size) (local.get $gid))
      (global.get $tth_ppem) (global.get $tth_upem)))
    (local.set $index (local.get $count))
    (block $phantom_done (loop $phantom
      (br_if $phantom_done (i32.ge_u (local.get $index)
        (i32.add (local.get $count) (i32.const 4))))
      (local.set $point (call $tth_point (i32.const 1) (local.get $index)))
      (local.set $x (select (i32.add (local.get $left) (local.get $advance))
        (local.get $left)
        (i32.eq (local.get $index) (i32.add (local.get $count) (i32.const 1)))))
      (if (i32.ge_u (local.get $index) (i32.add (local.get $count) (i32.const 2)))
        (then (local.set $x (i32.const 0))))
      (i32.store offset=0 (local.get $point) (local.get $x))
      (i32.store offset=4 (local.get $point) (i32.const 0))
      (i32.store offset=8 (local.get $point) (local.get $x))
      (i32.store offset=12 (local.get $point) (i32.const 0))
      (i32.store offset=16 (local.get $point) (i32.const 0))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $phantom)))
    (global.set $tth_glyph_advance (local.get $advance))
    (i32.const 1))

  ;; Compound children are independently scaled and grid-fitted before the
  ;; parent program sees their accumulated contours.  The work buffer holds
  ;; the child results across recursive interpreter calls, which reuse the
  ;; transient arena.  Return bit 1 means USE_MY_METRICS supplied phantoms.
  (func $tth_load_compound_hinted (param $data i32) (param $size i32)
        (param $gid i32) (param $ppem i32) (param $work i32)
        (param $compact i32) (param $expected i32) (result i32)
    (local $cursor i32) (local $flags i32) (local $part i32)
    (local $arg1 i32) (local $arg2 i32)
    (local $a i32) (local $b i32) (local $c i32) (local $d i32)
    (local $total i32) (local $count i32) (local $index i32)
    (local $child i32) (local $src i32) (local $dst i32)
    (local $x i32) (local $y i32) (local $tx i32) (local $ty i32)
    (local $dx i32) (local $dy i32) (local $use_metrics i32)
    (local.set $cursor (i32.add (call $tt_glyph_offset (local.get $data)
      (local.get $size) (local.get $gid)) (i32.const 10)))
    (block $done (loop $components
      (local.set $flags (call $tt_u16 (local.get $data) (local.get $size)
        (local.get $cursor)))
      (local.set $part (call $tt_u16 (local.get $data) (local.get $size)
        (i32.add (local.get $cursor) (i32.const 2))))
      (local.set $cursor (i32.add (local.get $cursor) (i32.const 4)))
      (if (i32.and (local.get $flags) (i32.const 1))
        (then
          (local.set $arg1 (select
            (call $tt_s16 (local.get $data) (local.get $size) (local.get $cursor))
            (call $tt_u16 (local.get $data) (local.get $size) (local.get $cursor))
            (i32.and (local.get $flags) (i32.const 2))))
          (local.set $arg2 (select
            (call $tt_s16 (local.get $data) (local.get $size)
              (i32.add (local.get $cursor) (i32.const 2)))
            (call $tt_u16 (local.get $data) (local.get $size)
              (i32.add (local.get $cursor) (i32.const 2)))
            (i32.and (local.get $flags) (i32.const 2))))
          (local.set $cursor (i32.add (local.get $cursor) (i32.const 4))))
        (else
          (local.set $arg1 (select
            (call $tt_s8 (local.get $data) (local.get $size) (local.get $cursor))
            (call $tt_u8 (local.get $data) (local.get $size) (local.get $cursor))
            (i32.and (local.get $flags) (i32.const 2))))
          (local.set $arg2 (select
            (call $tt_s8 (local.get $data) (local.get $size)
              (i32.add (local.get $cursor) (i32.const 1)))
            (call $tt_u8 (local.get $data) (local.get $size)
              (i32.add (local.get $cursor) (i32.const 1)))
            (i32.and (local.get $flags) (i32.const 2))))
          (local.set $cursor (i32.add (local.get $cursor) (i32.const 2)))))
      (local.set $a (i32.const 0x4000))
      (local.set $b (i32.const 0))
      (local.set $c (i32.const 0))
      (local.set $d (i32.const 0x4000))
      (if (i32.and (local.get $flags) (i32.const 8))
        (then
          (local.set $a (call $tt_f2dot14 (local.get $data) (local.get $size)
            (local.get $cursor)))
          (local.set $d (local.get $a))
          (local.set $cursor (i32.add (local.get $cursor) (i32.const 2))))
        (else (if (i32.and (local.get $flags) (i32.const 0x40))
          (then
            (local.set $a (call $tt_f2dot14 (local.get $data) (local.get $size)
              (local.get $cursor)))
            (local.set $d (call $tt_f2dot14 (local.get $data) (local.get $size)
              (i32.add (local.get $cursor) (i32.const 2))))
            (local.set $cursor (i32.add (local.get $cursor) (i32.const 4))))
          (else (if (i32.and (local.get $flags) (i32.const 0x80))
            (then
              (local.set $a (call $tt_f2dot14 (local.get $data) (local.get $size)
                (local.get $cursor)))
              (local.set $b (call $tt_f2dot14 (local.get $data) (local.get $size)
                (i32.add (local.get $cursor) (i32.const 2))))
              (local.set $c (call $tt_f2dot14 (local.get $data) (local.get $size)
                (i32.add (local.get $cursor) (i32.const 4))))
              (local.set $d (call $tt_f2dot14 (local.get $data) (local.get $size)
                (i32.add (local.get $cursor) (i32.const 6))))
              (local.set $cursor (i32.add (local.get $cursor) (i32.const 8)))))))))

      (local.set $count (call $tt_glyph_load_outline (local.get $data)
        (local.get $size) (local.get $part) (local.get $compact)
        (global.get $TTH_MAX_POINTS) (i32.const 0)))
      (if (i32.gt_u (i32.add (local.get $total) (local.get $count))
            (local.get $expected))
        (then (return (i32.const 0))))
      (if (local.get $count)
        (then
          (local.set $child (call $tth_hint_outline (local.get $data)
            (local.get $size) (local.get $part) (local.get $ppem)
            (local.get $compact) (local.get $count)))
          (if (i32.eqz (local.get $child)) (then (return (i32.const 0))))
          (local.set $index (i32.const 0))
          (block $copy_done (loop $copy
            (br_if $copy_done (i32.ge_u (local.get $index) (local.get $count)))
            (local.set $src (i32.add (local.get $child)
              (i32.mul (local.get $index) (global.get $TTH_POINT_STRIDE))))
            (local.set $dst (i32.add (local.get $work) (i32.mul
              (i32.add (local.get $total) (local.get $index))
              (global.get $TTH_POINT_STRIDE))))
            (local.set $x (i32.load (local.get $src)))
            (local.set $y (i32.load offset=4 (local.get $src)))
            (local.set $tx (call $gdi_round_ratio (i64.add
              (i64.mul (i64.extend_i32_s (local.get $a))
                (i64.extend_i32_s (local.get $x)))
              (i64.mul (i64.extend_i32_s (local.get $c))
                (i64.extend_i32_s (local.get $y)))) (i64.const 16384)))
            (local.set $ty (call $gdi_round_ratio (i64.add
              (i64.mul (i64.extend_i32_s (local.get $b))
                (i64.extend_i32_s (local.get $x)))
              (i64.mul (i64.extend_i32_s (local.get $d))
                (i64.extend_i32_s (local.get $y)))) (i64.const 16384)))
            (i32.store (local.get $dst) (local.get $tx))
            (i32.store offset=4 (local.get $dst) (local.get $ty))
            (i32.store offset=8 (local.get $dst) (local.get $tx))
            (i32.store offset=12 (local.get $dst) (local.get $ty))
            (i32.store offset=16 (local.get $dst)
              (i32.and (i32.load offset=16 (local.get $src)) (i32.const 3)))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $copy)))

          (if (i32.and (local.get $flags) (i32.const 2))
            (then
              (local.set $dx (call $tt_fu_to_26_6 (local.get $arg1)
                (local.get $ppem) (global.get $tth_upem)))
              (local.set $dy (call $tt_fu_to_26_6 (local.get $arg2)
                (local.get $ppem) (global.get $tth_upem)))
              (if (i32.and (i32.and (local.get $flags) (i32.const 0x0800))
                    (i32.eqz (i32.and (local.get $flags) (i32.const 0x1000))))
                (then
                  (local.set $x (local.get $dx))
                  (local.set $y (local.get $dy))
                  (local.set $dx (call $gdi_round_ratio (i64.add
                    (i64.mul (i64.extend_i32_s (local.get $a))
                      (i64.extend_i32_s (local.get $x)))
                    (i64.mul (i64.extend_i32_s (local.get $c))
                      (i64.extend_i32_s (local.get $y)))) (i64.const 16384)))
                  (local.set $dy (call $gdi_round_ratio (i64.add
                    (i64.mul (i64.extend_i32_s (local.get $b))
                      (i64.extend_i32_s (local.get $x)))
                    (i64.mul (i64.extend_i32_s (local.get $d))
                      (i64.extend_i32_s (local.get $y)))) (i64.const 16384)))))
              (if (i32.and (local.get $flags) (i32.const 4))
                (then
                  (local.set $dx (i32.mul (call $gdi_round_ratio
                    (i64.extend_i32_s (local.get $dx)) (i64.const 64))
                    (i32.const 64)))
                  (local.set $dy (i32.mul (call $gdi_round_ratio
                    (i64.extend_i32_s (local.get $dy)) (i64.const 64))
                    (i32.const 64))))))
            (else
              (if (i32.or (i32.ge_u (local.get $arg1) (local.get $total))
                    (i32.ge_u (local.get $arg2) (local.get $count)))
                (then (return (i32.const 0))))
              (local.set $dx (i32.sub
                (i32.load (i32.add (local.get $work) (i32.mul
                  (local.get $arg1) (global.get $TTH_POINT_STRIDE))))
                (i32.load (i32.add (local.get $work) (i32.mul
                  (i32.add (local.get $total) (local.get $arg2))
                  (global.get $TTH_POINT_STRIDE))))))
              (local.set $dy (i32.sub
                (i32.load offset=4 (i32.add (local.get $work) (i32.mul
                  (local.get $arg1) (global.get $TTH_POINT_STRIDE))))
                (i32.load offset=4 (i32.add (local.get $work) (i32.mul
                  (i32.add (local.get $total) (local.get $arg2))
                  (global.get $TTH_POINT_STRIDE))))))))

          (local.set $index (i32.const 0))
          (block $translate_done (loop $translate
            (br_if $translate_done (i32.ge_u (local.get $index) (local.get $count)))
            (local.set $dst (i32.add (local.get $work) (i32.mul
              (i32.add (local.get $total) (local.get $index))
              (global.get $TTH_POINT_STRIDE))))
            (i32.store (local.get $dst) (i32.add (i32.load (local.get $dst))
              (local.get $dx)))
            (i32.store offset=4 (local.get $dst) (i32.add
              (i32.load offset=4 (local.get $dst)) (local.get $dy)))
            (i32.store offset=8 (local.get $dst) (i32.load (local.get $dst)))
            (i32.store offset=12 (local.get $dst)
              (i32.load offset=4 (local.get $dst)))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $translate)))

          (if (i32.and (local.get $flags) (i32.const 0x0200))
            (then
              (local.set $use_metrics (i32.const 1))
              (local.set $index (i32.const 0))
              (block $metrics_done (loop $metrics
                (br_if $metrics_done (i32.ge_u (local.get $index) (i32.const 4)))
                (local.set $src (i32.add (local.get $child) (i32.mul
                  (i32.add (local.get $count) (local.get $index))
                  (global.get $TTH_POINT_STRIDE))))
                (local.set $dst (i32.add (local.get $work) (i32.mul
                  (i32.add (local.get $expected) (local.get $index))
                  (global.get $TTH_POINT_STRIDE))))
                (local.set $x (i32.load (local.get $src)))
                (local.set $y (i32.load offset=4 (local.get $src)))
                (local.set $tx (call $gdi_round_ratio (i64.add
                  (i64.mul (i64.extend_i32_s (local.get $a))
                    (i64.extend_i32_s (local.get $x)))
                  (i64.mul (i64.extend_i32_s (local.get $c))
                    (i64.extend_i32_s (local.get $y)))) (i64.const 16384)))
                (local.set $ty (call $gdi_round_ratio (i64.add
                  (i64.mul (i64.extend_i32_s (local.get $b))
                    (i64.extend_i32_s (local.get $x)))
                  (i64.mul (i64.extend_i32_s (local.get $d))
                    (i64.extend_i32_s (local.get $y)))) (i64.const 16384)))
                (i32.store (local.get $dst) (i32.add (local.get $tx)
                  (local.get $dx)))
                (i32.store offset=4 (local.get $dst) (i32.add
                  (local.get $ty) (local.get $dy)))
                (i32.store offset=8 (local.get $dst) (i32.load (local.get $dst)))
                (i32.store offset=12 (local.get $dst)
                  (i32.load offset=4 (local.get $dst)))
                (i32.store offset=16 (local.get $dst) (i32.const 0))
                (local.set $index (i32.add (local.get $index) (i32.const 1)))
                (br $metrics)))))
          (local.set $total (i32.add (local.get $total) (local.get $count)))))
      (br_if $done (i32.eqz (i32.and (local.get $flags) (i32.const 0x20))))
      (br $components)))
    (if (i32.ne (local.get $total) (local.get $expected))
      (then (return (i32.const 0))))
    (i32.or (i32.const 1) (i32.shl (local.get $use_metrics) (i32.const 1))))

  ;; Returns the interpreter-owned point array, or zero on any missing table,
  ;; malformed program, unsupported opcode, stack/point fault, or step limit.
  ;; Zero is deliberately the only failure signal required by the rasterizer.
  (func $tth_hint_outline (param $data i32) (param $size i32) (param $gid i32)
        (param $ppem i32) (param $compact i32) (param $count i32) (result i32)
    (local $base i32) (local $program i32) (local $length i32)
    (local $contours i32) (local $work_guest i32) (local $compact_guest i32)
    (local $work i32) (local $child_compact i32) (local $compound i32)
    (local.set $base (call $tth_init_size (local.get $data) (local.get $size)
      (local.get $ppem)))
    (if (i32.eqz (local.get $base)) (then (return (i32.const 0))))
    (global.set $tth_sc (local.get $base))
    (global.set $tth_ppem (local.get $ppem))
    (global.set $tth_upem (call $tt_units_per_em (local.get $data) (local.get $size)))
    (call $tth_prepare_arena)
    (global.set $tth_error (i32.const 0))
    (local.set $contours (call $tt_glyph_num_contours (local.get $data)
      (local.get $size) (local.get $gid)))
    (if (i32.lt_s (local.get $contours) (i32.const 0))
      (then
        (if (i32.ge_u (global.get $tth_compound_depth) (i32.const 4))
          (then (return (i32.const 0))))
        (local.set $work_guest (call $heap_alloc (i32.mul
          (i32.add (local.get $count) (i32.const 4))
          (global.get $TTH_POINT_STRIDE))))
        (local.set $compact_guest (call $heap_alloc (i32.mul
          (global.get $TTH_MAX_POINTS) (i32.const 6))))
        (if (i32.or (i32.eqz (local.get $work_guest))
              (i32.eqz (local.get $compact_guest)))
          (then
            (if (local.get $work_guest)
              (then (call $heap_free (local.get $work_guest))))
            (if (local.get $compact_guest)
              (then (call $heap_free (local.get $compact_guest))))
            (return (i32.const 0))))
        (local.set $work (call $g2w (local.get $work_guest)))
        (local.set $child_compact (call $g2w (local.get $compact_guest)))
        (global.set $tth_compound_depth (i32.add
          (global.get $tth_compound_depth) (i32.const 1)))
        (local.set $compound (call $tth_load_compound_hinted
          (local.get $data) (local.get $size) (local.get $gid)
          (local.get $ppem) (local.get $work) (local.get $child_compact)
          (local.get $count)))
        (global.set $tth_compound_depth (i32.sub
          (global.get $tth_compound_depth) (i32.const 1)))
        (call $tth_prepare_arena)
        (global.set $tth_error (i32.const 0))
        (if (i32.and (i32.ne (local.get $compound) (i32.const 0))
              (call $tth_load_outline (local.get $data) (local.get $size)
                (local.get $gid) (local.get $compact) (local.get $count)))
          (then
            (memory.copy (global.get $tth_points) (local.get $work)
              (i32.mul (local.get $count) (global.get $TTH_POINT_STRIDE)))
            (if (i32.and (local.get $compound) (i32.const 2))
              (then (memory.copy (i32.add (global.get $tth_points) (i32.mul
                    (local.get $count) (global.get $TTH_POINT_STRIDE)))
                  (i32.add (local.get $work) (i32.mul (local.get $count)
                    (global.get $TTH_POINT_STRIDE)))
                  (i32.mul (i32.const 4) (global.get $TTH_POINT_STRIDE)))))))
        (call $heap_free (local.get $compact_guest))
        (call $heap_free (local.get $work_guest))
        (if (i32.eqz (local.get $compound)) (then (return (i32.const 0)))))
      (else
    (if (i32.eqz (call $tth_load_outline (local.get $data) (local.get $size)
          (local.get $gid) (local.get $compact) (local.get $count)))
      (then (return (i32.const 0))))))
    (call $tth_gs_load (local.get $base))
    ;; Reference points, zone pointers, and loop are glyph-local. prep may use
    ;; twilight points while building the size state, but a new glyph starts
    ;; in the glyph zone with fresh references.
    (global.set $tth_rp0 (i32.const 0))
    (global.set $tth_rp1 (i32.const 0))
    (global.set $tth_rp2 (i32.const 0))
    (global.set $tth_zp0 (i32.const 1))
    (global.set $tth_zp1 (i32.const 1))
    (global.set $tth_zp2 (i32.const 1))
    (global.set $tth_loop (i32.const 1))
    ;; The CV program's parameter values persist, but every glyph begins
    ;; with projection, freedom, and dual projection on the x axis.
    (global.set $tth_pvx (i32.const 0x4000))
    (global.set $tth_pvy (i32.const 0))
    (global.set $tth_fvx (i32.const 0x4000))
    (global.set $tth_fvy (i32.const 0))
    (global.set $tth_dvx (i32.const 0x4000))
    (global.set $tth_dvy (i32.const 0))
    (global.set $tth_scan_control (i32.load offset=32 (local.get $base)))
    (global.set $tth_scan_type (i32.load offset=36 (local.get $base)))
    (global.set $tth_inst_control (i32.load offset=40 (local.get $base)))
    (local.set $program (call $tth_glyph_program (local.get $data)
      (local.get $size) (local.get $gid)))
    (local.set $length (global.get $tth_program_len))
    (if (i32.and (i32.ne (local.get $length) (i32.const 0))
          (i32.eqz (i32.and (global.get $tth_inst_control) (i32.const 1))))
      (then
        (if (i32.eqz (call $tth_run (local.get $program) (local.get $length)
              (i32.const 2)))
          (then (return (i32.const 0))))))
    (global.set $tth_glyph_advance (i32.sub
      (call $tth_point_current_x (i32.const 1)
        (i32.add (local.get $count) (i32.const 1)))
      (call $tth_point_current_x (i32.const 1) (local.get $count))))
    (global.get $tth_points))

  (func $tth_hint_point_x (param $points i32) (param $index i32) (result i32)
    (i32.load (i32.add (local.get $points)
      (i32.mul (local.get $index) (global.get $TTH_POINT_STRIDE)))))

  (func $tth_hint_point_y (param $points i32) (param $index i32) (result i32)
    (i32.load offset=4 (i32.add (local.get $points)
      (i32.mul (local.get $index) (global.get $TTH_POINT_STRIDE)))))

  (func $tth_hint_point_on_curve (param $points i32) (param $index i32) (result i32)
    (i32.and (i32.load offset=16 (i32.add (local.get $points)
      (i32.mul (local.get $index) (global.get $TTH_POINT_STRIDE))))
      (global.get $TTH_P_ON_CURVE)))

  (func $tth_hint_point_ends_contour (param $points i32) (param $index i32)
        (result i32)
    (i32.and (i32.load offset=16 (i32.add (local.get $points)
      (i32.mul (local.get $index) (global.get $TTH_POINT_STRIDE))))
      (global.get $TTH_P_END)))

  (func $tth_hint_last_advance (result i32)
    (global.get $tth_glyph_advance))

  (func $tth_hint_last_scan_type (result i32)
    (global.get $tth_scan_type))

  (func $tth_hint_last_scan_control (result i32)
    (global.get $tth_scan_control))

  (func $tth_hint_advance_px (param $data i32) (param $size i32) (param $gid i32)
        (param $ppem i32) (param $compact i32) (param $capacity i32) (result i32)
    (local $count i32) (local $hinted i32)
    (local.set $count (call $tt_glyph_load_outline (local.get $data)
      (local.get $size) (local.get $gid) (local.get $compact)
      (local.get $capacity) (i32.const 0)))
    (local.set $hinted (call $tth_hint_outline (local.get $data) (local.get $size)
      (local.get $gid) (local.get $ppem) (local.get $compact) (local.get $count)))
    (if (i32.eqz (local.get $hinted))
      (then (return (i32.const 0x80000000))))
    (call $gdi_round_ratio (i64.extend_i32_s (call $tth_hint_last_advance))
      (i64.const 64)))

  ;; field 0=left, 1=top, 2=width, 3=height. A one-entry cache makes the four
  ;; box queries in glyph insertion share one execution of the glyph program.
  (func $tth_hint_bound (param $data i32) (param $size i32) (param $gid i32)
        (param $ppem i32) (param $field i32) (result i32)
    (local $scratch i32) (local $count i32) (local $hinted i32)
    (local $index i32) (local $x i32) (local $y i32)
    (local $min_x i32) (local $min_y i32) (local $max_x i32) (local $max_y i32)
    (if (i32.and (i32.and
            (i32.eq (global.get $tth_bound_data) (local.get $data))
            (i32.eq (global.get $tth_bound_size) (local.get $size)))
          (i32.and (i32.eq (global.get $tth_bound_gid) (local.get $gid))
            (i32.eq (global.get $tth_bound_ppem) (local.get $ppem))))
      (then
        (if (i32.lt_s (global.get $tth_bound_status) (i32.const 0))
          (then (return (i32.const 0x80000000))))
        (if (i32.eqz (local.get $field))
          (then (return (global.get $tth_bound_left))))
        (if (i32.eq (local.get $field) (i32.const 1))
          (then (return (global.get $tth_bound_top))))
        (if (i32.eq (local.get $field) (i32.const 2))
          (then (return (i32.sub (global.get $tth_bound_right)
            (global.get $tth_bound_left)))))
        (return (i32.sub (global.get $tth_bound_top)
          (global.get $tth_bound_bottom)))))
    (global.set $tth_bound_data (local.get $data))
    (global.set $tth_bound_size (local.get $size))
    (global.set $tth_bound_gid (local.get $gid))
    (global.set $tth_bound_ppem (local.get $ppem))
    (global.set $tth_bound_status (i32.const -1))
    (local.set $scratch (call $tt_raster_scratch))
    (if (i32.eqz (local.get $scratch))
      (then (return (i32.const 0x80000000))))
    (local.set $count (call $tt_glyph_load_outline (local.get $data)
      (local.get $size) (local.get $gid) (local.get $scratch)
      (global.get $TT_RASTER_POINTS) (i32.const 0)))
    (if (i32.eqz (local.get $count))
      (then
        (global.set $tth_bound_left (i32.const 0))
        (global.set $tth_bound_top (i32.const 0))
        (global.set $tth_bound_right (i32.const 0))
        (global.set $tth_bound_bottom (i32.const 0))
        (global.set $tth_bound_status (i32.const 1))
        (return (i32.const 0))))
    (local.set $hinted (call $tth_hint_outline (local.get $data) (local.get $size)
      (local.get $gid) (local.get $ppem) (local.get $scratch) (local.get $count)))
    (if (i32.eqz (local.get $hinted))
      (then (return (i32.const 0x80000000))))
    (local.set $min_x (i32.const 0x7FFFFFFF))
    (local.set $min_y (i32.const 0x7FFFFFFF))
    (local.set $max_x (i32.const 0x80000000))
    (local.set $max_y (i32.const 0x80000000))
    (block $done (loop $points
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (local.set $x (call $tth_hint_point_x (local.get $hinted) (local.get $index)))
      (local.set $y (call $tth_hint_point_y (local.get $hinted) (local.get $index)))
      (if (i32.lt_s (local.get $x) (local.get $min_x))
        (then (local.set $min_x (local.get $x))))
      (if (i32.lt_s (local.get $y) (local.get $min_y))
        (then (local.set $min_y (local.get $y))))
      (if (i32.gt_s (local.get $x) (local.get $max_x))
        (then (local.set $max_x (local.get $x))))
      (if (i32.gt_s (local.get $y) (local.get $max_y))
        (then (local.set $max_y (local.get $y))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $points)))
    (global.set $tth_bound_left (call $tt_floor_px (local.get $min_x)))
    (global.set $tth_bound_top (call $tt_ceil_px (local.get $max_y)))
    (global.set $tth_bound_right (call $tt_ceil_px (local.get $max_x)))
    (global.set $tth_bound_bottom (call $tt_floor_px (local.get $min_y)))
    (global.set $tth_bound_status (i32.const 1))
    (call $tth_hint_bound (local.get $data) (local.get $size) (local.get $gid)
      (local.get $ppem) (local.get $field)))

  ;; Narrow test seam: these exercise the same face-size and glyph path used
  ;; by GDI, without exposing mutable interpreter internals to guest code.
  (func (export "test_tth_hint_outline") (param i32) (param i32) (param i32)
        (param i32) (param i32) (param i32) (result i32)
    (call $tth_hint_outline (local.get 0) (local.get 1) (local.get 2)
      (local.get 3) (local.get 4) (local.get 5)))

  (func (export "test_tth_glyph_program") (param i32) (param i32) (param i32)
        (result i32)
    (call $tth_glyph_program (local.get 0) (local.get 1) (local.get 2)))

  (func (export "test_tth_last_program_length") (result i32)
    (global.get $tth_program_len))

  (func (export "test_tth_point_x") (param i32) (param i32) (result i32)
    (call $tth_hint_point_x (local.get 0) (local.get 1)))

  (func (export "test_tth_point_y") (param i32) (param i32) (result i32)
    (call $tth_hint_point_y (local.get 0) (local.get 1)))

  (func (export "test_tth_point_on_curve") (param i32) (param i32) (result i32)
    (call $tth_hint_point_on_curve (local.get 0) (local.get 1)))

  (func (export "test_tth_last_advance") (result i32)
    (call $tth_hint_last_advance))

  (func (export "test_tth_last_scan_type") (result i32)
    (call $tth_hint_last_scan_type))

  (func (export "test_tth_last_error") (result i32)
    (global.get $tth_error))

  (func (export "test_tth_last_steps") (result i32)
    (global.get $tth_steps))

  (func (export "test_tth_last_opcode") (result i32)
    (global.get $tth_opcode))

  (func (export "test_tth_last_phase") (result i32)
    (global.get $tth_phase))

  (func (export "test_tth_last_fault_arg") (result i32)
    (global.get $tth_fault_arg))

  (func (export "test_tth_last_pc") (result i32)
    (global.get $tth_pc))
