  ;; not an address (docs/watx-region-safety-design.md 5.1).
  (region.declare $WAVE_OUT_SHARED (size 0x00000010) (align 0x00000010)
    (owner "01-header.wat:2690"))
  (region.declare $SCROLL_TABLE (size 0x00001800) (align 0x00000010)
