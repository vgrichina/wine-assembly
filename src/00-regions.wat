  ;; One byte per WND_RECORDS slot: bits 0..1 are the horizontal ESB_* mask,
  ;; bits 2..3 are the vertical mask. Keeping arrow enablement beside, but
  ;; separate from, SCROLLINFO avoids stealing range/track bits from callers.
  ;; Declare it before the 4KB-aligned aux table so it occupies existing
  ;; allocator padding instead of moving every later region by a page.
  (region.declare $SCROLL_ARROW_TABLE (size 0x00000100) (align 0x00000100)
    (stride 0x1 (count $MAX_WINDOWS))
