            (i32.load16_s offset=8 (local.get $record)) (i32.const 0)))
          (drop (call $gdi_dc_aux_set (local.get $hdc) (i32.const 28)
            (i32.load16_s offset=6 (local.get $record)) (i32.const 0)))))
