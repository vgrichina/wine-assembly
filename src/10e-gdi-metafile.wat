                  (if (i32.or (i32.eqz (local.get $level))
                        (i32.gt_u (local.get $level) (local.get $save_depth)))
                    (then (br $finish)))
                  (if (i32.eqz (call $gdi_dc_restore (local.get $hdc)
                        (i32.add (local.get $outer_save) (local.get $level))))
