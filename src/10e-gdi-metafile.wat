    (global.set $esp (i32.sub (global.get $esp) (i32.const 4)))
    (call $gs32 (global.get $esp)
      (call $gl32 (i32.add (local.get $ctx) (i32.const 20))))
    (global.set $esp (i32.sub (global.get $esp) (i32.const 4)))
