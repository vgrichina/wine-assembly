    (if (local.get $hdc)
      (then
        (local.set $outer_save (call $gdi_dc_save (local.get $hdc)))
        (if (i32.eqz (local.get $outer_save))
          (then
            (global.set $eax (i32.const 0))
            (global.set $eip (local.get $ret))
            (global.set $esp (local.get $return_esp))
            (return)))))
