{
  "schemaVersion": 1,
  "apps": {
    "font-inventory": {
      "title": "Windows 98 bitmap font inventory",
      "probeSource": "tools/v86-reference/probes/font-inventory.c",
      "probeName": "FONTREF.EXE",
      "launch": "D:\\FONTREF.EXE",
      "waitMs": 3000,
      "files": []
    },
    "fixedsys-sizes": {
      "title": "Windows 98 native Fixedsys sizes",
      "probeSource": "tools/v86-reference/probes/font-inventory.c",
      "probeName": "FONTREF.EXE",
      "launch": "D:\\FONTREF.EXE",
      "postLaunch": [
        {
          "waitMs": 4000,
          "scancodes": [
            57,
            185
          ]
        }
      ],
      "waitMs": 3000,
      "files": []
    },
    "fontview-truetype": {
      "title": "Windows 98 Font Viewer on a TrueType face",
      "launch": "fontview C:\\WINDOWS\\FONTS\\ARIAL.TTF",
      "waitMs": 5000,
      "files": []
    },
    "fontview-bitmap": {
      "title": "Windows 98 Font Viewer on a bitmap face",
      "launch": "fontview C:\\WINDOWS\\FONTS\\VGASYS.FON",
      "waitMs": 5000,
      "files": []
    },
    "stock-font-ascii": {
      "title": "Windows 98 native stock-font ASCII",
      "probeSource": "tools/v86-reference/probes/font-inventory.c",
      "probeName": "FONTREF.EXE",
      "launch": "D:\\FONTREF.EXE",
      "postLaunch": [
        {
          "waitMs": 4000,
          "scancodes": [
            57,
            185
          ]
        },
        {
          "waitMs": 700,
          "scancodes": [
            57,
            185
          ]
        }
      ],
      "waitMs": 3000,
      "files": []
    },
    "font-metrics": {
      "title": "Windows 98 font metric reference (COM1)",
      "probeSource": "tools/v86-reference/probes/font-metrics.c",
      "probeName": "FONTMET.EXE",
      "launch": "D:\\\\FONTMET.EXE",
      "waitMs": 30000,
      "files": []
    },
    "font-render-matrix": {
      "title": "Windows 98 GDI font rendering matrix",
      "probeSource": "tools/v86-reference/probes/font-render-matrix.c",
      "probeName": "FONTRND.EXE",
      "launch": "D:\\FONTRND.EXE",
      "waitMs": 5000,
      "files": []
    },
    "font-render-substitutes": {
      "title": "Open substitute fonts rendered by Windows 98 GDI",
      "probeSource": "tools/v86-reference/probes/font-render-matrix.c",
      "probeName": "FONTRND.EXE",
      "launch": "D:\\FONTRND.EXE SUBSTITUTES",
      "waitMs": 5000,
      "files": [
        { "path": "fonts/subset/LiberationSans-Regular.ttf", "name": "LIBSANS.TTF" },
        { "path": "fonts/subset/LiberationSerif-Regular.ttf", "name": "LIBSERIF.TTF" },
        { "path": "fonts/subset/LiberationMono-Regular.ttf", "name": "LIBMONO.TTF" }
      ]
    },
    "font-file-dump": {
      "title": "Local-only Windows 98 font file extraction over COM1",
      "probeSource": "tools/v86-reference/probes/font-file-dump.c",
      "probeName": "FONTDUMP.EXE",
      "launch": "D:\\FONTDUMP.EXE",
      "waitMs": 30000,
      "files": []
    }
  }
}
