        "test/binaries/entertainment-pack/winmine.exe",
        "test/binaries/entertainment-pack/aboutwep.dll"
      ]
    },
    "calculator": {
      "title": "Calculator",
      "launch": "D:\\CALC.EXE",
      "files": ["test/binaries/calc.exe"]
    },
    "solitaire": {
      "title": "Solitaire",
      "launch": "D:\\SOL.EXE",
      "files": [
        "test/binaries/entertainment-pack/sol.exe",
        "test/binaries/entertainment-pack/cards.dll",
        "test/binaries/entertainment-pack/aboutwep.dll"
      ]
    },
    "freecell": {
      "title": "FreeCell",
      "launch": "D:\\FREECELL.EXE",
