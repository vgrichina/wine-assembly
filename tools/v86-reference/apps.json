    },
    "notepad98": {
      "title": "Notepad (Windows 98)",
      "launch": "D:\\NOTEPAD.EXE",
      "files": [
        { "path": "test/binaries/win98-apps/notepad98.exe", "name": "NOTEPAD.EXE" }
      ]
    },
    "wordpad": {
      "title": "WordPad",
      "launch": "D:\\WORDPAD.EXE",
