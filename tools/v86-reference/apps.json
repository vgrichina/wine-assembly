{
  "schemaVersion": 1,
  "apps": {
    "geometry-probe": {
      "title": "Minesweeper geometry probe",
      "probeSource": "tools/v86-reference/probes/query-winrect.c",
      "probeName": "PROBE.EXE",
      "launch": "D:\\PROBE.EXE",
      "waitMs": 10000,
      "files": [
        { "path": "test/binaries/entertainment-pack/winmine.exe", "name": "WINMINE.EXE" }
      ]
    },
    "minesweeper": {
      "title": "Minesweeper",
      "launch": "D:\\WINMINE.EXE",
