      {
        "name": "gdi_set_window_rgn",
        "boundary": "Apply an already-derived region mirror to browser window composition."
      },
      { "name": "gdi_surface_create", "boundary": "Allocate a derived Canvas cache for an opaque WAT-owned surface and byte layout." },
      { "name": "gdi_surface_delete", "boundary": "Discard the derived Canvas cache for an opaque surface ID." },
      { "name": "gdi_surface_upload", "boundary": "Upload a bounded dirty rectangle from authoritative WAT pixels to Canvas." }
